<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Conventions that are only real if a build enforces them (§10.4).
		Assembly-level rules read the compiled output with System.Reflection.Metadata,
		which is in the framework — an architecture guard should not itself introduce a
		dependency that has to be licence-checked.
	-->
	<PropertyGroup>
		<RootNamespace>DLR.Architecture.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
		<PackageReference Include="coverlet.collector" Version="6.0.4" />
	</ItemGroup>

	<!-- Referenced so the assemblies under inspection land in this project's output. -->
	<ItemGroup>
		<ProjectReference Include="..\..\src\DLR.Core\DLR.Core.csproj" />
		<ProjectReference Include="..\..\src\DLR.Server\DLR.Server.csproj" />
		<ProjectReference Include="..\..\src\DLR.Server.Migrations\DLR.Server.Migrations.csproj" />
	</ItemGroup>

</Project>
