# Dumb Luck Rides — deployment secrets (§9, §14.3).
#
# Copy to deploy/.env and fill in. That file is gitignored; this one is committed with no values,
# which is the difference between "here is what to set" and "here is what somebody set".
#
# Nothing here belongs in appsettings.json. The server refuses to start on a signing key that
# ships with the code (§7.4), and the MapKit .p8 is on §14.2's never-commit list.

# --- Required ---------------------------------------------------------------

# openssl rand -base64 36
POSTGRES_PASSWORD=

# openssl rand -base64 48 — at least 32 bytes, or the server refuses to start (§7.4).
AUTH_SIGNING_KEY=

# The public hostname Caddy gets a certificate for, and the origin the app is reached at.
PUBLIC_DOMAIN=
PUBLIC_URL=https://

# Where Let's Encrypt sends expiry warnings.
TLS_EMAIL=

# --- Backups (§9.1) ---------------------------------------------------------

# openssl rand -base64 36. Losing this loses every backup — put it in a password manager, not
# only in the .env file that lives on the machine being backed up.
RESTIC_PASSWORD=

# e.g. b2:dlr-backups:/dlr
RESTIC_REPOSITORY=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# UTC hour to run. Default 17, which is early morning in Australia.
BACKUP_HOUR_UTC=17

# --- Email (§7.12) ----------------------------------------------------------
#
# Zoho Mail SMTP to begin with; ZeptoMail before real users. The cutover is these five values.

EMAIL_HOST=smtp.zoho.com.au
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- Maintenance (§7.11, §9) ------------------------------------------------

# Leave true for at least a week and read the emails before turning it off. It gates every sweep.
MAINTENANCE_DRY_RUN=true

# Where the nightly run summary goes. A destructive job you do not watch is one you will regret.
MAINTENANCE_ALERT_EMAIL=

# --- Maps (§4.5) ------------------------------------------------------------
#
# Optional. Without them the web map states that it has no credentials rather than showing a grey
# rectangle, which is a supported state — not a broken one.

MAPKIT_TEAM_ID=
MAPKIT_KEY_ID=

# The .p8 contents, newlines and all. Never the file path — the file must not be in the image.
MAPKIT_PRIVATE_KEY_PEM=

# --- Networking -------------------------------------------------------------

# The Caddy container's address on the compose network, which the server trusts as its only proxy
# hop. §7.8's per-address rules and the registration ladder are both wrong without it, so check it
# after the first `docker compose up`:
#
#   docker compose --file deploy/docker-compose.yml exec server getent hosts caddy
CADDY_IP=172.18.0.2

# --- Source offer (§14.6.2) -------------------------------------------------
#
# A fork running a modified server owes its users *its own* source, not ours.

SOURCE_URL=https://github.com/dumbluckrides/dlr
