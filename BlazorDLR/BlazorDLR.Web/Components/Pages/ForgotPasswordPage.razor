@page "/auth/forgot-password"
@using BlazorDLR.Shared.Components

@*
    §7.7's reset request. Static SSR because it must work whether or not the user has the
    app installed and whether or not the WASM bundle has loaded.

    The server always answers 202 (§7.8) whether the address exists or not, so this page
    always shows the "if that address exists, we sent a link" line rather than an error
    when there is no account behind the address — anti-enumeration by construction.
*@

<PageTitle>Forgot password — Dumb Luck Rides</PageTitle>

<div class="page page-standalone page-narrow form-page">
    <h1>Forgot password</h1>

    @if (_sent)
    {
        <p>
            If that email address matches an account, we sent a reset link. It is valid for
            one hour. Check the inbox that goes with your account.
        </p>
    }
    else
    {
        <form method="post" action="/api/v1/auth/forgot-password">
            <label>
                Email address
                <input name="email" type="email" autocomplete="email" required autofocus />
            </label>
            <button type="submit">Send reset link</button>
        </form>
    }

    <p><a href="/login">Back to sign in</a></p>

    <SourceOfferFooter />
</div>

@code {
    // Rendered as the follow-up after a form post has been accepted (the server always
    // answers 202). Phase 1 keeps it simple by not showing this on GET — see the
    // acknowledged-state message above.
    private bool _sent = false;
}
