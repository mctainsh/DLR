@page "/auth/reset-password"
@using BlazorDLR.Shared.Components
@using Microsoft.AspNetCore.Components

@*
	§7.7's reset landing. Followed from the emailed link, which carries userId and token
	as query parameters. Statically rendered so it works whether or not the app is
	installed and whether or not WASM has loaded — a link opened on a phone with no signal
	still renders the form; the POST needs signal, but rendering the form does not.
*@

<PageTitle>Reset password — Dumb Luck Rides</PageTitle>

<div class="page page-standalone page-narrow form-page">
	<h1>Reset password</h1>

	@if (string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Token))
	{
		<p>
			This reset link is missing information. It should have come from an email; open
			the one we sent again.
		</p>
	}
	else
	{
		<form method="post" action="/api/v1/auth/reset-password">
			<input type="hidden" name="userId" value="@UserId" />
			<input type="hidden" name="token" value="@Token" />

			<label>
				New password (10+ characters)
				<input name="newPassword" type="password" autocomplete="new-password" required autofocus />
			</label>

			<button type="submit">Set new password</button>
		</form>
	}

	<p><a href="/login">Back to sign in</a></p>

	<SourceOfferFooter />
</div>

@code {
	[SupplyParameterFromQuery] public string? UserId { get; set; }
	[SupplyParameterFromQuery] public string? Token { get; set; }
}
