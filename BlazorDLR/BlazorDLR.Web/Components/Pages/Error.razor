@page "/Error"
@using System.Diagnostics

<PageTitle>Something broke - Dumb Luck Routes</PageTitle>

<h1 class="text-danger">Something broke</h1>

<p>
	The server hit an error part way through that request, so it never finished.
	Going back and trying again is usually worth a shot.
</p>

@if (ShowRequestId)
{
	@* The one thing a rider can hand over that is worth anything: it finds this exact
	   request in the log. Nothing else on this page is useful to them. *@
	<p>
		If you report this, quote <code>@RequestId</code>.
	</p>
}

@code{
	[CascadingParameter]
	private HttpContext? HttpContext { get; set; }

	private string? RequestId { get; set; }
	private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

	protected override void OnInitialized() =>
		RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
