<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BlazorDLR"
             x:Class="BlazorDLR.App">
	<Application.Resources>
		<ResourceDictionary>

			<!--
                For information about styling .NET MAUI pages
                please refer to the documentation:
                https://go.microsoft.com/fwlink/?linkid=2282329
            -->

			<!--
				MainPage binds its BackgroundColor to this. It was missing, so the binding
				resolved to nothing and the native page kept the platform default - which is
				what flashes white behind the WebView on launch and while a rotation
				re-lays-out. Black matches the status-bar strip (wwwroot/app.css) and the
				dark palette (BlazorDLR.Shared/wwwroot/app.css) either side of it.
			-->
			<Color x:Key="PageBackgroundColor">#000000</Color>

		</ResourceDictionary>
	</Application.Resources>
</Application>
