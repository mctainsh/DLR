<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/appicon.appiconset</string>
	
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
	</array>

	<key>CFBundleDisplayName</key>
	<string>DLR</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	
	<key>CFBundleShortVersionString</key>
	<string>8.0.0</string>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>CFBundleVersion</key>
	<string>18</string>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Share your location to allow other users on the same adventure</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Always share your location to allow other users on the same adventure as you to find you and vice versa</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Always share your location to allow other users on the same adventure as you to find you and vice versa</string>
	<key>NSCameraUsageDescription</key>
	<string>We use your camera for taking and sharing photos of items such as cool spots and nice views</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>You can share items in you library for example photos nice views</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Bluetooth is used to improve location accuracy by detecting nearby devices.</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!--
		White clock and battery, app-wide. The strip they sit on is black
		(wwwroot/app.css, .status-bar-safe-area); the default style resolves its contrast
		against the view controller's traits, not against what the WebView painted, so
		leaving it to decide is how you get black glyphs on a black bar.
		UIViewControllerBasedStatusBarAppearance above is what makes this key the last word.
	-->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>

    <!--
        .gpx share-sheet / "Open with" integration (SharedFrontend.md §7 Phase 1).
        Two halves of one story:
          CFBundleDocumentTypes announces "this app opens files of this type";
          UTImportedTypeDeclarations tells iOS what "org.topografix.gpx" is — mime
          application/gpx+xml, extension .gpx, conforming to public.xml.
        Without the imported-type block the OS will not recognise the identifier
        the CFBundleDocumentTypes entry names, and the app will not appear in the
        share sheet for .gpx files coming from another app.
    -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>GPX track</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.topografix.gpx</string>
            </array>
        </dict>
    </array>
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.topografix.gpx</string>
            <key>UTTypeDescription</key>
            <string>GPS Exchange Format</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.xml</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>gpx</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>application/gpx+xml</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
