<?xml version="1.0" encoding="utf-8"?>
<!--
	The small icon on an adventure-thread notification.

	Its own drawable rather than a stock android.R one, for the same reason the location icon
	has one (see dlr_location_notification.xml): the stock set is not guaranteed across API
	levels or OEM skins, and a small icon the platform cannot resolve means the notification is
	never posted at all — silently, which for this feature would read as "notifications don't
	work on my phone".

	A silhouette, white on transparent. From Android 5 the system masks a notification's small
	icon to its alpha channel and tints it, so anything with colour in it arrives as a white
	blob. This is a speech bubble with a tail, which reads at 24 dp in a status bar and is
	distinct at a glance from the location crosshair the ride's ongoing notification carries —
	the two sit side by side for the whole of a ride.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
	android:width="24dp"
	android:height="24dp"
	android:viewportWidth="24"
	android:viewportHeight="24"
	android:tint="#FFFFFFFF">
	<path
		android:fillColor="#FFFFFFFF"
		android:pathData="M20,2L4,2c-1.1,0 -1.99,0.9 -1.99,2L2,22l4,-4h14c1.1,0 2,-0.9 2,-2L22,4c0,-1.1 -0.9,-2 -2,-2zM7,9h10v2L7,11L7,9zM13,14L7,14v-2h6v2zM17,8L7,8L7,6h10v2z" />
</vector>
