<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	<!--
	  Overrides Directory.Build.props' single <TargetFramework>net10.0</TargetFramework>: the MAUI
	  head targets platform frameworks, and a plain net10.0 target here is meaningless. Clearing
	  it first ensures the plural TargetFrameworks below is authoritative.
	-->
	<TargetFramework></TargetFramework>
	<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
	<!--
	  MacCatalyst builds only on macOS: it invokes Xcode, and on any other host MSBuild fails to
	  spin up the task host with a MSB4216 that names neither the SDK nor the reason. Gated to OSX
	  here so a Windows developer can still open the solution and build the heads that make sense
	  on their machine.

	  iOS is NOT gated, and is deliberately absent from this line — it is already in the list
	  above. The .NET iOS workload ships reference assemblies, so `Platforms/iOS/**` compiles on
	  Windows even though linking and signing still need a Mac; keeping it in the base list is what
	  catches a break in AppleLocationProvider.cs on the machine that made it rather than in CI.

	  Appending it here as well is what this line used to do, and the cost was not theoretical: on
	  macOS the property evaluated to `…;net10.0-ios;net10.0-ios;net10.0-maccatalyst`, which builds
	  the iOS head twice and leaves the project advertising a framework list with a duplicate in
	  it. MSBuild tolerates that; the Roslyn workspace behind `dotnet format` and the IDEs is less
	  forgiving, and a project whose TFM list does not round-trip is a bad thing to hand a tool
	  that has to reason about one compilation per framework.
	-->
	<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-maccatalyst</TargetFrameworks>

	<!-- Note for MacCatalyst:
	  The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
	  When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
	  The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
	  either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
	<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

	<OutputType>Exe</OutputType>
	<RootNamespace>BlazorDLR</RootNamespace>
	<UseMaui>true</UseMaui>
	<SingleProject>true</SingleProject>
	<ImplicitUsings>enable</ImplicitUsings>
	<EnableDefaultCssItems>false</EnableDefaultCssItems>
	<Nullable>enable</Nullable>

	<!-- Enable XAML source generation for faster build times and improved performance.
		 This generates C# code from XAML at compile time instead of runtime inflation.
		 To disable, remove this line.
		 For individual files, you can override by setting Inflator metadata:
		   <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		   <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
	<MauiXamlInflator>SourceGen</MauiXamlInflator>

	<!-- Display name -->
	<ApplicationTitle>DLR</ApplicationTitle>

	<!-- App Identifier -->
	<ApplicationId>au.com.securehub.dlr.v2</ApplicationId>

	<!-- Versions -->
	<ApplicationDisplayVersion>8.0.0</ApplicationDisplayVersion>
	<ApplicationVersion>24</ApplicationVersion>

	<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
	<WindowsPackageType>None</WindowsPackageType>

	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
	<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
    <CodesignKey>Apple Development: Created via API (YVHC5A2RQW)</CodesignKey>
    <CodesignProvision>VS: au.com.securehub.dlr.v2 Development</CodesignProvision>
  </PropertyGroup>

  <!--
    ============================ Store release configuration ============================
    Everything below is about producing an artefact a store will accept. The full
    submission procedure — the parts that are forms rather than builds — is
    Documentation/store-release.md.

    Nothing here hard-codes a credential. Signing material is read from environment
    variables and every block is conditioned on them being present, so a developer
    building Release locally gets an unsigned build rather than an error about a keystore
    they do not have. §14.2 rates signing material the one mistake with no clean recovery.
  -->

  <PropertyGroup Condition="'$(Configuration)'=='Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!--
      Play has not accepted an APK for a new app or an update since August 2021: an app
      bundle is the only publishable format. `dotnet publish -f net10.0-android -c Release`
      produces the .aab with this set.
    -->
    <AndroidPackageFormat>aab</AndroidPackageFormat>

    <!--
      R8 in full mode, and the linker on the SDK assemblies only. Full trimming of a MAUI
      Blazor Hybrid app removes types the WebView's reflection reaches at runtime, and the
      failure is a blank page in Release that Debug never shows.
    -->
    <AndroidLinkTool>r8</AndroidLinkTool>
    <TrimMode>partial</TrimMode>

    <!-- A symbol file to upload with the bundle, so Play's crash reports are readable. -->
    <AndroidEnableAssemblyCompression>true</AndroidEnableAssemblyCompression>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!--
    Upload signing for Play. Set these in the CI secret store or the local environment:

      DLR_ANDROID_KEYSTORE       path to the .keystore / .jks   (never in the repo)
      DLR_ANDROID_KEYSTORE_PASS  store password
      DLR_ANDROID_KEY_ALIAS      key alias
      DLR_ANDROID_KEY_PASS       key password

    Play App Signing holds the *app* signing key; this is the *upload* key. Losing the
    upload key is recoverable by asking Google to reset it — which is the whole reason to
    be enrolled, and Documentation/store-release.md says so at the top.
  -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'&#xD;&#xA;                            and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'&#xD;&#xA;                            and '$(DLR_ANDROID_KEYSTORE)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(DLR_ANDROID_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningStorePass>$(DLR_ANDROID_KEYSTORE_PASS)</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>$(DLR_ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(DLR_ANDROID_KEY_PASS)</AndroidSigningKeyPass>
  </PropertyGroup>

  <!--
    Distribution signing for the App Store. Overrides the development pair above, and only
    when the environment names a distribution identity — so a Mac with only a development
    certificate still builds Release for a device.

      DLR_IOS_CODESIGN_KEY   e.g. "Apple Distribution: Your Company (TEAMID)"
      DLR_IOS_PROVISION      the App Store provisioning profile name
  -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'&#xD;&#xA;                            and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'&#xD;&#xA;                            and '$(DLR_IOS_CODESIGN_KEY)' != ''">
    <CodesignKey>$(DLR_IOS_CODESIGN_KEY)</CodesignKey>
    <CodesignProvision>$(DLR_IOS_PROVISION)</CodesignProvision>
    <ArchiveOnBuild>true</ArchiveOnBuild>
    <!-- Bitcode has been dead since Xcode 14; leaving it on is a submission warning. -->
    <MtouchEnableBitcode>false</MtouchEnableBitcode>
  </PropertyGroup>

  <!--
    The privacy manifest (required for App Store submission since 1 May 2024). It has to
    land at the root of the .app bundle under this exact name, which is what LogicalName
    does — a manifest inside Platforms/iOS/ in the bundle is a manifest App Store Connect
    does not find, and the rejection mail does not say why.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <BundleResource Include="Platforms\iOS\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <!--
    Play Services pulls in AndroidX packages with tighter version constraints than the ones
    .NET MAUI resolves to. The resolved versions are the *newer* ones in every case, which
    is the combination MAUI itself ships and tests; NU1608 is restore reporting that a
    transitive constraint was widened, not that anything is missing.

    Project-wide rather than on the Android head, because restore evaluates the package graph
    once for the whole project — conditioning it on the target framework left the same
    warnings on the iOS build, which does not reference the package at all. No other project
    in the solution carries this suppression, so a genuine version conflict elsewhere still
    surfaces.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
	<!--
	  App Icon. The item is declared twice because the two platforms crop it differently and only
	  Android needs the correction.

	  Android composites an *adaptive* icon: appiconfg.png becomes a 108dp foreground drawable that
	  the launcher masks down to the central 72dp safe zone, so a full-bleed foreground loses the
	  outer sixth on all four sides — the reported "you only see the middle". ForegroundScale shrinks
	  the artwork inside that same 108dp canvas (0.65 x 108dp = 70.2dp) so it lands inside the safe
	  zone and survives any mask shape; the appicon.png gradient fills the margin it vacates.

	  iOS/MacCatalyst draw the composed icon uncropped, so scaling there would only shrink a picture
	  that already fits. They keep the implicit scale of 1.
	-->
	  <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" BaseSize="1024, 1024" ForegroundScale="0.65" Color="Black" />
	  <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" BaseSize="1024, 1024" Color="Black" />

	<!--
	  Splash Screen. Declared twice for the same reason, this time with iOS as the odd one out.

	  The storyboard MAUI generates for iOS puts the image in a full-screen UIImageView with
	  contentMode="center" and clipsSubviews="YES" — the image is never scaled to fit, it is drawn at
	  exactly BaseSize points and cropped by the screen. At 476pt that is wider than every iPhone in
	  portrait (320-440pt), which is why the transparent border baked into splash.png disappeared:
	  it was being clipped off along with the artwork's edges. 320pt is the narrowest portrait width
	  an iOS 15 device can have, so the image never clips, and on current phones it leaves the
	  15-20% margin asked for (375pt -> 15%, 393pt -> 19%, 430pt -> 26%).

	  Android's splash is a drawable scaled by the platform, not a fixed-size centred image, so it is
	  unaffected by the clipping and keeps 476.
	-->
	  <MauiSplashScreen Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" Include="Resources\Splash\splash.png" BaseSize="320, 320" Color="Black" />
	  <MauiSplashScreen Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'" Include="Resources\Splash\splash.png" BaseSize="476, 476" Color="Black" />

	<!-- Images -->
	<MauiImage Include="Resources\Images\*" />
	<MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

	<!-- Custom Fonts -->
	<MauiFont Include="Resources\Fonts\*" />

	<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
	<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
	<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.90" />
	<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
  </ItemGroup>

  <!--
	The fused location provider (§4.3): GNSS blended with Wi-Fi, cell and the motion sensors,
	which is what keeps a fix alive between tall buildings and what makes the Balanced profile
	cost what it claims to. Android only — it is a Play Services binding, and the iOS head has
	CLLocationManager.

	It is a preference, not a requirement. Play Services is absent on recent Huawei phones, on
	de-Googled Android and in some emulators, so Platforms/Android/Location/ falls back to the
	platform's own LocationManager at runtime when the availability check fails. That keeps the
	app working on those devices instead of looking like a phone that cannot see the sky.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
	<PackageReference Include="Xamarin.GooglePlayServices.Location" Version="121.4.0" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\BlazorDLR.Shared\BlazorDLR.Shared.csproj" />
  </ItemGroup>

</Project>
