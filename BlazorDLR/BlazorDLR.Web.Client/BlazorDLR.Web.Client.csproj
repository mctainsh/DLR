  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorDLR.Shared\BlazorDLR.Shared.csproj" />
  </ItemGroup>

</Project>