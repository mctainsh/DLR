@inherits LayoutComponentBase
@using BlazorDLR.Shared.Components
@using BlazorDLR.Shared.State
@inject ThemeState Theme
@implements IDisposable

@*
	The one layout every page composes with (§18.6).

	Normally: the nav rail lives on the LEFT.
	Under 560 px wide: it moves to a bar along the BOTTOM, and a page taller than the
	screen scrolls underneath it.

	Both are pure CSS — one width media query on `.shell` picks the flex-direction, and
	NavMenu draws the same DOM either way. There is no collapsed state at any width: the
	rail always shows every destination.

	The breakpoint is width, not orientation. What decides whether a left rail is
	affordable is how many horizontal pixels the content keeps after it — so a phone held
	landscape is wide enough to keep the rail, and the same phone upright is not.

	The wrapper is `.shell`, not `.page`: `.page` is the shared *content column* every
	page uses (wwwroot/app.css), and the two must not fight over the same name.

	The <div class="app"> wrapper carries `data-theme="dark|light"`. That attribute is
	what the CSS variables in wwwroot/app.css read from. A change to Theme.Preference
	fires ThemeState.Changed, this component re-renders, and the attribute updates —
	no page reload.
*@

<div class="app" data-theme="@Theme.DataAttributeValue">
	<div class="shell">
		<nav class="rail">
			<NavMenu />
		</nav>

		<main class="main">
			<article class="content">
				@Body
			</article>
		</main>
	</div>

	@* One dialog for every destructive action in the app. Pages call
	   ConfirmService.AskAsync(...); this component renders whatever is pending. *@
	<ConfirmDialog />
</div>

@code {
	protected override void OnInitialized()
	{
		// Subscribe synchronously so the initial SSR pass renders `data-theme="dark"`
		// from ThemeState's in-memory default without touching JS interop — the WASM
		// binding reads localStorage, and JS is not reachable until after first render.
		Theme.Changed += OnThemeChanged;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		// Only run the persisted-preference read after WASM has taken over and JS is
		// reachable. Before then, LocalStorageThemeService would throw an
		// InvalidOperationException that surfaces as Blazor's yellow error banner —
		// which is exactly what we saw.
		if (firstRender)
		{
			await Theme.LoadAsync();
		}
	}

	private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

	public void Dispose() => Theme.Changed -= OnThemeChanged;
}
