@inherits LayoutComponentBase
@using BlazorDLR.Shared.Components
@using BlazorDLR.Shared.Diagnostics
@using BlazorDLR.Shared.State
@inject AuthState Auth
@inject CommentNotifier Notifier
@inject NotificationRouting Routing
@inject NavigationManager Nav
@inject IntroTourState Tour
@inject LaunchRestore Restore
@implements IDisposable

@*
	The one layout every page composes with (§18.6).

	Normally: the nav rail lives on the LEFT.
	Under 560 px wide: it moves to a bar along the BOTTOM, and a page taller than the
	screen scrolls underneath it.

	Both are pure CSS — one width media query on `.shell` picks the flex-direction, and
	NavMenu draws the same DOM either way. There is no collapsed state at any width: the
	rail always shows every destination.

	The breakpoint is width, not orientation. What decides whether a left rail is
	affordable is how many horizontal pixels the content keeps after it — so a phone held
	landscape is wide enough to keep the rail, and the same phone upright is not.

	The wrapper is `.shell`, not `.page`: `.page` is the shared *content column* every
	page uses (wwwroot/app.css), and the two must not fight over the same name.

	There is ONE palette, and it is the dark one on `:root` in wwwroot/app.css. This
	wrapper used to carry a `data-theme` attribute for a light alternative, which never
	worked: the CSS selectors were `:root[data-theme=…]`, so they matched <html> and this
	attribute on a div never selected anything. The attribute, the preference, its store
	and the settings control it was set from are all gone rather than fixed — the app is
	read through a visor in daylight and the dark palette is the design (§18.6).
*@

<div class="app">
	<div class="shell">
		<nav class="rail">
			<NavMenu />
		</nav>

		<main class="main">
			<article class="content">
				@Body
			</article>
		</main>
	</div>

	@* One dialog for every destructive action in the app. Pages call
	   ConfirmService.AskAsync(...); this component renders whatever is pending. *@
	<ConfirmDialog />
</div>

@code {
	/// <summary>
	/// Whether this launch was aimed somewhere by a tapped notification. Set in
	/// <c>OnInitialized</c> and read once, by <see cref="ShowIntroductionIfFirstRunAsync"/>.
	/// </summary>
	private bool _routedByNotification;

	/// <summary>
	/// The adventure this launch is waiting to reopen once the cold-launch bounce through Welcome
	/// lands on Home, or <c>null</c> when there is nothing waiting. See
	/// <see cref="ReopenLastAdventureAsync"/>.
	/// </summary>
	private string? _pendingAdventure;

	/// <summary>
	/// Subscribing here is what gives <see cref="CommentNotifier"/> a lifetime (§17.6).
	/// <para>
	/// Injecting it is what constructs it, and constructing it is what subscribes it to the hub —
	/// so the notifier is alive from the first render of the first page and stays alive for as long
	/// as the app does. That is the point of putting it on the layout rather than on a page: a
	/// notifier that only existed while the thread was open would be a notifier for the one
	/// situation that never needs one.
	/// </para>
	/// <para>
	/// In OnInitialized rather than after render, because a notification tapped from a cold lock
	/// screen has already parked its route by now and the sooner it is collected the less of the
	/// home screen the rider sees on the way past.
	/// </para>
	/// </summary>
	protected override void OnInitialized()
	{
		Routing.RouteRequested += OnRouteRequested;

		// Every screen the rider opens, from the one layout they all share. This is the spine of a
		// readable log: on its own it is only a breadcrumb trail, but it is what turns the lines
		// either side of a failure into "this happened while they were doing that" rather than a
		// timestamp nobody can place.
		Nav.LocationChanged += OnLocationChanged;
		DiagnosticLog.Write($"Page: {Path(Nav.Uri)} (Init).");

		// Subscribe first, then drain. A route that arrived before the subscription above — the
		// cold-launch case, which is most of them — is parked rather than raised, and this ordering
		// is what makes sure exactly one of the two paths picks it up.
		if (Routing.TakePending() is { } pending)
		{
			// Remembered so the first-run introduction does not open on top of it. A launch that
			// was aimed somewhere by a notification is a launch with a destination already, and a
			// rider who tapped a card about their ride wants the ride.
			_routedByNotification = true;
			OnRouteRequested(pending);
		}
	}

	/// <summary>
	/// Travels to where a tapped notification pointed.
	/// <para>
	/// Marshalled through <c>InvokeAsync</c> because the caller is a platform callback on whatever
	/// thread Android or iOS chose — <c>NavigationManager</c> is not thread-safe and Blazor throws
	/// if it is touched from off the renderer's context.
	/// </para>
	/// </summary>
	private void OnRouteRequested(string route) =>
		_ = InvokeAsync(() => Nav.NavigateTo(route));

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			// The end of the startup ladder the MAUI heads write with a "Startup:" prefix: the
			// Blazor tree is rendered and interactive. A log that reaches "BlazorWebView
			// initialised" and stops short of this line is a WebView that came up around a tree
			// that never did.
			DiagnosticLog.Write("Startup: first render complete; restoring the session.");

			// The app's one launch hook (§7.9). Nothing else in the client brings a session back:
			// without this, a phone that was signed in yesterday relaunches anonymous and
			// RedirectToWelcome asks a rider to sign in to an account they never signed out of.
			//
			// Here rather than in each host's Program.cs because it needs a rendered tree to
			// broadcast into — and here rather than on a page because every page is downstream of
			// this layout, including the Welcome screen the redirect lands on, which watches for
			// the arriving session and takes the rider home when it turns up.
			//
			// After first render, because the mobile store is the Keychain and the web's is behind
			// JS interop, neither of which exists during the prerender pass.
			// AuthState.RestoreAsync is idempotent, so a second render costs nothing.
			await StepAsync("session", () => Auth.RestoreAsync());
			DiagnosticLog.Write($"Startup: session is {(Auth.UserId is { } who ? who.ToString() : "anonymous")}.");

			// After the session, because a rider who is already signed in on this device has run
			// the app before and the introduction has nothing to tell them — the read below is the
			// one that decides, and putting it first would race the restore for the navigation.
			await StepAsync("introduction", ShowIntroductionIfFirstRunAsync);

			// And last, because it is the weakest claim on the screen of the three: a launch the
			// introduction or a notification has already aimed somewhere keeps that destination.
			await StepAsync("adventure", ReopenLastAdventureAsync);
		}
	}

	/// <summary>
	/// Runs one rung of the launch ladder, and writes down a failure rather than taking the rungs
	/// below it down as well.
	/// <para>
	/// <strong>The sequence used to be unguarded, and that is a launch that loses everything after
	/// the first stumble.</strong> The session restore reaches the network, and not every failure
	/// there is one <c>AuthState</c> catches — a refresh that times out throws
	/// <see cref="TaskCanceledException"/>, which is not an <see cref="HttpRequestException"/>. An
	/// escape from that step took the introduction, the adventure and the GPS with it, silently,
	/// leaving a rider on the home screen with a ride still running and nothing in the log to say
	/// why. Each rung is independent, so each one is allowed to fail on its own.
	/// </para>
	/// </summary>
	/// <param name="rung">What is being attempted, for the log.</param>
	/// <param name="step">The rung.</param>
	private static async Task StepAsync(string rung, Func<Task> step)
	{
		try
		{
			await step();
		}
		catch (Exception failure)
		{
			DiagnosticLog.Write($"Startup: the {rung} step failed: {failure.GetType().Name}: {failure.Message}");
		}
	}

	/// <summary>
	/// Puts the rider back on the adventure they were on, with the GPS running again if the server
	/// still has them sharing with it (<see cref="LaunchRestore"/>).
	/// <para>
	/// <strong>Only onto a screen nobody else has claimed.</strong> A tapped notification, a shared
	/// invitation and the introduction are all launches with a destination already, and a rider who
	/// asked for one screen must not be moved off it by a ride they left running. Home is the
	/// landing that means "wherever I was".
	/// </para>
	/// <para>
	/// <strong>Except that a cold launch is not on Home yet.</strong> Home is <c>[Authorize]</c> and
	/// the session is restored asynchronously, so the router has already bounced an authenticated
	/// rider to Welcome by the time this runs, and Welcome sends them home again the moment the
	/// session lands. Reading the URL at this instant therefore says "/welcome" on the launch this
	/// was written for. So that one hop is waited out in <see cref="OnLocationChanged"/> rather than
	/// mistaken for a screen the rider chose.
	/// </para>
	/// <para>
	/// The receiver comes up either way — that half is not a navigation, and it is owed to a rider
	/// the server still has on the map whatever screen they came back to. Neither half happens on a
	/// host with no GPS behind it; <see cref="LaunchRestore"/> is where that is decided.
	/// </para>
	/// </summary>
	private async Task ReopenLastAdventureAsync()
	{
		if (await Restore.RestoreAsync() is not { } adventure)
			return;

		if (_routedByNotification)
			return;

		string here = Path(Nav.Uri);

		if (here is "/")
		{
			ReopenNow(adventure);
			return;
		}

		if (here.StartsWith("/welcome", StringComparison.OrdinalIgnoreCase))
		{
			// Mid-bounce. Held rather than followed from here: navigating out of Welcome now would
			// be overtaken by its own "you are signed in, go home", which is already queued.
			DiagnosticLog.Write($"Startup: holding {adventure} until the sign-in bounce lands.");
			_pendingAdventure = adventure;
		}
		else
		{
			DiagnosticLog.Write($"Startup: launched on {here}, so {adventure} is not reopened.");
		}
	}

	/// <summary>Travels to the adventure the launch is putting the rider back on.</summary>
	private void ReopenNow(string adventure)
	{
		DiagnosticLog.Write($"Startup: reopening the adventure this device was on ({adventure}).");
		Nav.NavigateTo(adventure);
	}

	/// <summary>
	/// Opens the introduction slide show on a device that has never been through it (§18.6).
	/// <para>
	/// <strong>Here rather than on a page.</strong> The rider's first screen is Home or Welcome
	/// depending on a session that is still being restored when the app starts, so neither of them
	/// can own "the first thing you ever see". This layout is above both, and runs exactly once
	/// per launch.
	/// </para>
	/// <para>
	/// <strong>It never fires twice and never traps.</strong> The state is read from the device, so
	/// a host with no store to read — the SSR prerender, which does not reach this method at all —
	/// cannot start a redirect loop, and the deck marks itself seen whether it is finished or
	/// skipped.
	/// </para>
	/// <para>
	/// Where the rider was headed is carried across as <c>return</c>, so a first launch that opened
	/// on a shared invitation still lands on the invitation afterwards.
	/// </para>
	/// </summary>
	private async Task ShowIntroductionIfFirstRunAsync()
	{
		if (_routedByNotification)
			return;

		string here = Path(Nav.Uri);

		// Already there — Settings' "How this works" card, or a reload of the deck itself.
		if (here.StartsWith("/intro", StringComparison.OrdinalIgnoreCase))
			return;

		if (!await Tour.ShouldShowAsync())
			return;

		DiagnosticLog.Write("Startup: first run on this device; showing the introduction.");

		string target = here is "/" ? "/intro" : $"/intro?return={Uri.EscapeDataString(here)}";
		Nav.NavigateTo(target);
	}

	/// <summary>
	/// Releases the route subscription. <see cref="CommentNotifier"/> is deliberately <em>not</em>
	/// disposed here: it is a scoped service and the container owns it, and disposing an injected
	/// service from the component that happened to ask for it would take the hub subscription down
	/// while the app is still running.
	/// </summary>
	public void Dispose()
	{
		Routing.RouteRequested -= OnRouteRequested;
		Nav.LocationChanged -= OnLocationChanged;
	}

	private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
	{
		DiagnosticLog.Write($"Page: {Path(args.Location)}{(args.IsNavigationIntercepted ? " (link)" : "")}.");

		if (_pendingAdventure is not { } adventure)
			return;

		// One shot either way: the bounce lands on Home and the adventure opens, or the rider went
		// somewhere of their own accord and the launch has lost its claim on the screen.
		_pendingAdventure = null;

		if (Path(args.Location) is "/")
		{
			// Deferred out of the event: this is raised from inside a navigation, and starting the
			// next one underneath it re-enters the router.
			_ = InvokeAsync(() => ReopenNow(adventure));
		}
	}

	/// <summary>
	/// The route without the scheme and host — which on the phone is a WebView's own invented
	/// origin and tells a reader nothing, while making every line long enough to wrap.
	/// </summary>
	private string Path(string uri) =>
		"/" + Nav.ToBaseRelativePath(uri).TrimStart('/');
}
