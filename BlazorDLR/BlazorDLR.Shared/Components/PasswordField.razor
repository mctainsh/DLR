@*
	A password box with a reveal button, and — on the Register form — a strength meter (§7.2).

	Both halves exist for the same reason. §7.2 v0.22 turned the composition rules back on so
	that every rejection names what is wrong, and v0.23 then removed the breach check, which
	leaves the sign-up form as the only place a rider is told anything about their password at
	all. A masked field they cannot check, on a phone keyboard, for an account that may have no
	email and therefore no reset path, is the shape of a rider locked out on their first ride.

	The reveal button is `type="button"` on purpose: inside a form, the default is `submit`,
	and a rider tapping the eye would register instead. It is a sibling of the input rather
	than a child of the label, because a button inside a label is activated by clicks meant
	for the field.
*@

<div class="pw-field">
	<label for="@Id">@Label</label>

	<div class="pw-box">
		<input id="@Id"
			   type="@(_revealed ? "text" : "password")"
			   value="@Value"
			   autocomplete="@Autocomplete"
			   required="@Required"
			   @oninput="OnEdited"
			   @onchange="OnEdited" />

		<button type="button"
				class="pw-reveal"
				aria-controls="@Id"
				aria-pressed="@(_revealed ? "true" : "false")"
				aria-label="@(_revealed ? "Hide password" : "Show password")"
				title="@(_revealed ? "Hide password" : "Show password")"
				@onclick="Toggle">
			@if (_revealed)
			{
				@* Plain eye — the password is on screen. *@
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
					 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
					<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
					<circle cx="12" cy="12" r="3" />
				</svg>
			}
			else
			{
				@* Struck-through eye — the password is masked, and this reveals it. *@
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
					 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
					<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
					<path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
					<path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
					<line x1="1" y1="1" x2="23" y2="23" />
				</svg>
			}
		</button>
	</div>

	@ChildContent

	@if (ShowStrength && _assessment.Level != PasswordStrengthLevel.Empty)
	{
		<div class="pw-strength">
			<div class="pw-bars" aria-hidden="true">
				@for (int segment = 1; segment <= PasswordStrength.Segments; segment++)
				{
					<span class="pw-bar @(segment <= (int)_assessment.Level ? $"filled {LevelClass}" : "")"></span>
				}
			</div>

			@*
				One live region for the whole verdict. Two — a label and a separate list —
				would have a screen reader announce the strength and the missing rules as
				unrelated events, and the missing rules are the half worth acting on.
			*@
			<p class="pw-verdict @LevelClass" role="status" aria-live="polite">
				<span class="pw-label">@_assessment.Label</span>
				@if (!_assessment.MeetsPolicy)
				{
					<span class="pw-unmet">— still needs @string.Join(", ", _assessment.Unmet)</span>
				}
			</p>
		</div>
	}
</div>

@code {
	/// <summary>The text above the box.</summary>
	[Parameter] public string Label { get; set; } = "Password";

	/// <summary>DOM id, tying the label, the field and the reveal button together.</summary>
	[Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

	/// <summary>The password itself. Bound with <c>@bind-Value</c>.</summary>
	[Parameter] public string Value { get; set; } = string.Empty;

	/// <summary>Raised on every keystroke, so a meter above updates as the rider types.</summary>
	[Parameter] public EventCallback<string> ValueChanged { get; set; }

	/// <summary><c>new-password</c> on Register, <c>current-password</c> on Sign in.</summary>
	[Parameter] public string Autocomplete { get; set; } = "current-password";

	/// <summary>Whether the browser should refuse an empty submit.</summary>
	[Parameter] public bool Required { get; set; } = true;

	/// <summary>Draws the strength meter. Register only — it is advice for choosing, not for recalling.</summary>
	[Parameter] public bool ShowStrength { get; set; }

	/// <summary>Static rule copy rendered under the box, above the meter.</summary>
	[Parameter] public RenderFragment? ChildContent { get; set; }

	private bool _revealed;
	private PasswordAssessment _assessment = PasswordStrength.Assess(null);

	protected override void OnParametersSet() => _assessment = PasswordStrength.Assess(Value);

	private async Task OnEdited(ChangeEventArgs args)
	{
		Value = args.Value?.ToString() ?? string.Empty;
		_assessment = PasswordStrength.Assess(Value);

		await ValueChanged.InvokeAsync(Value);
	}

	private void Toggle() => _revealed = !_revealed;

	private string LevelClass => _assessment.Level switch
	{
		PasswordStrengthLevel.Weak => "weak",
		PasswordStrengthLevel.Fair => "fair",
		PasswordStrengthLevel.Good => "good",
		PasswordStrengthLevel.Strong => "strong",
		_ => string.Empty,
	};
}

<style>
	.pw-field {
		display: block;
		margin-bottom: 0.75rem;
	}

	.pw-box {
		display: flex;
		align-items: stretch;
	}

		/* The input carries the border; the button sits inside it, as in a native field. */
		.pw-box input {
			flex: 1;
			min-width: 0;
			border-top-right-radius: 0;
			border-bottom-right-radius: 0;
			border-right: none;
		}

	/* Same fill and border as app.css gives an input, so the two read as one control
	   rather than a field with a button parked against it. */
	.pw-reveal {
		display: flex;
		align-items: center;
		justify-content: center;
		/* Wide enough to be a thumb target on a phone — the field it sits in is one too. */
		min-width: 2.75rem;
		padding: 0 0.6rem;
		background: var(--dlr-surface-2, #334155);
		color: var(--dlr-fg-muted, #94a3b8);
		border: 1px solid var(--dlr-border, #334155);
		border-left: none;
		border-top-right-radius: 4px;
		border-bottom-right-radius: 4px;
		cursor: pointer;
	}

		.pw-reveal:hover,
		.pw-reveal:focus-visible {
			color: var(--dlr-fg, #e2e8f0);
		}

	.pw-strength {
		margin-top: 0.4rem;
	}

	.pw-bars {
		display: flex;
		gap: 0.25rem;
	}

	.pw-bar {
		flex: 1;
		height: 4px;
		border-radius: 2px;
		background: var(--dlr-border, #334155);
		opacity: 0.5;
	}

		.pw-bar.filled {
			opacity: 1;
		}

		/* Colour is the redundant channel: the word beside the bar carries the same verdict,
		   so a rider who cannot tell amber from green is not being told less. Amber is the
		   one shade with no palette token — the rest read through app.css so both themes
		   move together. */
		.pw-bar.filled.weak { background: var(--dlr-error, #f87171); }
		.pw-bar.filled.fair { background: #d97706; }
		.pw-bar.filled.good { background: var(--dlr-accent, #2563eb); }
		.pw-bar.filled.strong { background: var(--dlr-good, #4ade80); }

	.pw-verdict {
		margin: 0.3rem 0 0;
		font-size: 0.85rem;
		color: var(--dlr-fg-muted, #94a3b8);
	}

		.pw-verdict .pw-label {
			font-weight: 600;
		}

		/* Razor collapses the newline between the two spans, so the gap has to be a margin —
		   without it the field reads "Weak— still needs an uppercase letter". */
		.pw-verdict .pw-unmet {
			margin-left: 0.35rem;
		}

		.pw-verdict.weak .pw-label { color: var(--dlr-error, #f87171); }
		.pw-verdict.fair .pw-label { color: #d97706; }
		.pw-verdict.good .pw-label { color: var(--dlr-accent, #2563eb); }
		.pw-verdict.strong .pw-label { color: var(--dlr-good, #4ade80); }
</style>
