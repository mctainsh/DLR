@using DLR.Core.Contracts.Rides

@*
	Three distinct states per member (§5.6):

	  - Sharing — location is being broadcast to this ride, and there is a fresh fix.
	  - Not sharing — the rider chose not to share with this ride. Their pin is not on
		the map at all. This is a decision, not a network condition.
	  - No signal — sharing but no fresh fix. Their last known point is on the map,
		but nothing new is coming in.

	§5.6 leans hard on the fact that these must not collapse into two states. Collapsing
	"not sharing" and "no signal" is exactly the ambiguity that gets someone left
	behind at a junction.
*@

<div class="member-list row-list">
	<h3>Members (@Members.Count)</h3>
	<ul>
		@foreach (RideMemberSummary member in Members.OrderBy(m => m.UserName, StringComparer.OrdinalIgnoreCase))
		{
			<li>
				<div class="who">
					<strong>@member.UserName</strong>
					@if (member.Role != "Rider" && !string.IsNullOrEmpty(member.Role))
					{
						<span class="role">@member.Role</span>
					}
				</div>
				<span class="state @StateClass(member)">@StateLabel(member)</span>
			</li>
		}
	</ul>
</div>

@code {
	[Parameter, EditorRequired] public IReadOnlyList<RideMemberSummary> Members { get; set; } = Array.Empty<RideMemberSummary>();

	private static string StateLabel(RideMemberSummary member) => member switch
	{
		{ Sharing: false } => "not sharing",
		{ Sharing: true, HasPosition: false } => "no signal",
		_ => "sharing",
	};

	private static string StateClass(RideMemberSummary member) => member switch
	{
		{ Sharing: false } => "not-sharing",
		{ Sharing: true, HasPosition: false } => "no-signal",
		_ => "sharing",
	};
}

<style>
	.member-list .who { display: flex; align-items: center; gap: 0.5rem; }
	.member-list .role {
		font-size: 0.7rem; padding: 0.1rem 0.4rem;
		background: #dbeafe; color: #1e40af; border-radius: 3px;
	}
	.member-list .state { font-size: 0.8rem; padding: 0.15rem 0.5rem; border-radius: 4px; }
	.member-list .state.sharing { background: #d1fae5; color: #14532d; }
	.member-list .state.not-sharing { background: #eef1f5; color: #4a5261; }
	.member-list .state.no-signal { background: #fef3c7; color: #92400e; }
</style>
