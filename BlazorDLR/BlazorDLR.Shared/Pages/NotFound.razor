@page "/not-found"
@layout MainLayout

<PageTitle>Page not found - Dumb Luck Routes</PageTitle>

<div class="page page-medium">
	@* Home rather than a parent route: a page that does not exist has no parent to walk
	   up to, and the rider most likely followed a stale link from outside the app. *@
	<PageNav Title="Page not found" BackHref="/" BackLabel="Back to home" />

	<p>There is no page at that address. It may be an old link, or the page may have moved.</p>
</div>
