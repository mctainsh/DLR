@page "/group-rides/create"
@attribute [Authorize]
@using DLR.Core.Contracts.Rides
@inject IApiClient Api
@inject NavigationManager Nav
@inject TimeProvider Clock

<PageTitle>Create a ride — Dumb Luck Routes</PageTitle>

<div class="page page-form form-page">
	<PageNav Title="Create a ride" BackHref="/group-rides" BackLabel="Back to group rides" />

	<p class="lead">
		You will be the organiser. You choose whether people can join with the code alone,
		or whether every joiner needs your approval (§5.2).
	</p>

	<form @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
		<label>
			Name
			<input @bind="_name" placeholder="Saturday Coast Run" required maxlength="80" />
		</label>

		<label>
			When it starts
			<input @bind="_startLocal" type="datetime-local" required />
		</label>

		<label>
			Description (optional)
			<textarea @bind="_description" rows="3" maxlength="500"
					  placeholder="Where to meet, what to bring."></textarea>
		</label>

		<fieldset>
			<legend>How people join</legend>
			<label class="radio">
				<input type="radio" name="policy" value="@JoinPolicyDto.Approval"
					   checked="@(_joinPolicy == JoinPolicyDto.Approval)"
					   @onchange="() => _joinPolicy = JoinPolicyDto.Approval" />
				Approval — a valid code creates a pending request; nobody enters until you admit them.
			</label>
			<label class="radio">
				<input type="radio" name="policy" value="@JoinPolicyDto.Open"
					   checked="@(_joinPolicy == JoinPolicyDto.Open)"
					   @onchange="() => _joinPolicy = JoinPolicyDto.Open" />
				Open — a valid code joins immediately.
			</label>
		</fieldset>

		<button type="submit" class="primary" disabled="@_busy">
			@(_busy ? "Creating…" : "Create ride")
		</button>
	</form>

	@if (_error is not null)
	{
		<div class="error" role="alert">
			<strong>@_error.Title</strong>
			@if (_error.Messages.Count > 0)
			{
				<ul>
					@foreach (string message in _error.Messages)
					{
						<li>@message</li>
					}
				</ul>
			}
		</div>
	}
</div>

@code {
	private string _name = string.Empty;
	private string _description = string.Empty;
	// datetime-local binds directly to DateTime. Default set in OnInitialized against
	// TimeProvider (§10.4) so a fake clock in tests drives this the same as everything else.
	private DateTime _startLocal;

	protected override void OnInitialized()
	{
		_startLocal = Clock.GetLocalNow().DateTime.AddHours(1);
	}
	private JoinPolicyDto _joinPolicy = JoinPolicyDto.Approval;
	private ApiError? _error;
	private bool _busy;

	private async Task CreateAsync()
	{
		if (_busy) return;
		_busy = true;
		_error = null;

		try
		{
			DateTimeOffset startUtc = new DateTimeOffset(_startLocal, Clock.GetLocalNow().Offset).ToUniversalTime();

			RideDetail ride = await Api.CreateRideAsync(new CreateRideRequest(
				Name: _name.Trim(),
				StartUtc: startUtc,
				Description: string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
				JoinPolicy: _joinPolicy));

			Nav.NavigateTo($"/group-rides/{ride.Id}");
		}
		catch (ApiException apiException)
		{
			_error = apiException.Error;
		}
		catch (Exception exception)
		{
			_error = new ApiError(default, "Could not create the ride.", new[] { exception.Message });
		}
		finally
		{
			_busy = false;
		}
	}
}
