@page "/group-rides/thread/{RideId:guid}"
@attribute [Authorize]
@using BlazorDLR.Shared.Components
@using DLR.Core.Contracts.Rides
@inject IApiClient Api

<PageTitle>Adventure thread - Dumb Luck Routes</PageTitle>

@*
	§17: comments + reactions + polls, one thread per group ride.

	Everything that used to be in this file is in CommentThreadView now, because a shared
	route has the same thread (§6.2) and two copies of it would have been two copies of the
	reaction handling, the pinning, the optimistic insert and the block filter. What is left
	here is the part that is genuinely about an adventure: the page chrome, the way back to
	the live map, and reading §5.8's switches to decide whether the composer appears.
*@

<div class="page page-medium">
	<PageNav Title="Adventure thread" BackHref="@($"/group-rides/live/{RideId}")" BackLabel="Back to the adventure" />

	@if (_error is not null)
	{
		<p class="error">@_error</p>
	}

	<CommentThreadView RideId="RideId"
					   CanPost="_canPost"
					   CanModerate="_ride?.IsOrganiser == true"
					   Placeholder="Say something to the adventure."
					   EmptyMessage="Nothing said yet. Start the conversation."
					   ClosedMessage="The organiser has turned off comments from members for this adventure." />
</div>

@code {
	[Parameter] public Guid RideId { get; set; }

	private RideDetail? _ride;
	private string? _error;

	// Defaults to true so the composer is not flashed away and back while the ride loads. The
	// server refuses the post either way, so a moment of optimism costs nothing; a moment of
	// "comments are off" on a ride where they are not would be a lie.
	private bool _canPost = true;

	protected override async Task OnParametersSetAsync()
	{
		_error = null;

		try
		{
			_ride = await Api.GetRideAsync(RideId);
			_canPost = _ride.Permissions.AllowMemberComments || _ride.IsOrganiser;
		}
		catch (ApiException apiException) { _error = apiException.Error.Title; }
		catch (Exception exception) { _error = exception.Message; }
	}
}
