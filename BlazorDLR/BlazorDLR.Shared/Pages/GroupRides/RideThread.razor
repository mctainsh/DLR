@page "/group-rides/thread/{RideId:guid}"
@attribute [Authorize]
@using BlazorDLR.Shared.Components
@using DLR.Core.Contracts.Comments
@using DLR.Core.Contracts.Moderation
@using DLR.Core.Contracts.Photos
@using DLR.Core.Contracts.Rides
@inject IApiClient Api
@inject IRideHubClient Hub
@inject AuthState Auth
@inject NavigationManager Nav
@inject TimeProvider Clock
@inject ConfirmService Confirm
@inject CommentNotifier Notifier
@implements IAsyncDisposable

<PageTitle>Adventure thread — Dumb Luck Routes</PageTitle>

@*
	§17: comments + reactions + polls, one thread per group ride.

	Three things this screen encodes that §17 leans on:
	  1. Ordering is by PostedUtc (§17.3). The server clamps CreatedUtc so a client
		 with a broken clock can't pin its post to the top.
	  2. Reactions arrive coalesced (§17.4) — one hub message per comment per burst,
		 not one per tap.
	  3. Every post notifies, in every ride state and whatever is on screen (§17.6).
		 There is no Live-ride exception and, since v0.27, no exception for the
		 thread the rider is currently reading either — so this page has nothing to
		 explain about the quiet. All it does is ask CommentNotifier to withdraw the
		 card already sitting in the shade for this adventure, which is housekeeping
		 rather than silence.
*@

<div class="page page-medium thread">
	<PageNav Title="Adventure thread" BackHref="@($"/group-rides/live/{RideId}")" BackLabel="Back to the adventure" />

	@if (_error is not null)
	{
		<p class="error">@_error</p>
	}

	@if (_pinned.Count > 0)
	{
		<section class="pinned">
			@foreach (CommentDto comment in _pinned)
			{
				@RenderComment(comment, pinned: true)
			}
		</section>
	}

	<section class="comments">
		@foreach (CommentDto comment in _comments)
		{
			@RenderComment(comment, pinned: false)
		}

		@if (_nextCursor is not null)
		{
			<button type="button" class="more" @onclick="LoadMoreAsync" disabled="@_loadingMore">
				@(_loadingMore ? "Loading…" : "Load older")
			</button>
		}
	</section>

	@if (_canPost)
	{
		<form class="composer" @onsubmit="PostAsync" @onsubmit:preventDefault="true">
			@* oninput, not the default onchange: the Post button below is disabled from this
			   value, and onchange does not fire until the textarea loses focus — which on a phone
			   means a rider types a whole message and watches a greyed-out button. Same reason
			   RideDetail and Welcome bind theirs this way. *@
			<textarea @bind="_composeText" @bind:event="oninput" rows="3" maxlength="2000"
					  placeholder="@(_isPoll ? "The poll question." : "Say something to the adventure.")"></textarea>

			@if (_isPoll)
			{
				@* OnChanged re-renders this component so the Post button re-reads BuildSpec().
				   Typing in a child only re-renders the child, so without it the button would
				   stay stale for the poll half exactly as it did for the textarea above. *@
				<PollComposer @ref="_pollComposer" OnChanged="StateHasChanged" />
			}

			<div class="composer-actions">
				<label class="poll-toggle">
					<input type="checkbox" @bind="_isPoll" />
					Poll
				</label>

				@if (!_isPoll)
				{
					@if (_composePhoto is null)
					{
						<label class="attach">
							<InputFile OnChange="OnPhotoSelected" accept="image/*" hidden />
							📎 Attach photo
						</label>
					}
					else
					{
						<span class="attached">@_composePhoto.FileName
							<button type="button" class="clear" @onclick="() => _composePhoto = null">×</button>
						</span>
					}
				}

				<button type="submit" class="primary"
						disabled="@(_busy || CantPost())">
					Post
				</button>
			</div>
		</form>
	}
	else if (_ride is not null && !_ride.Permissions.AllowMemberComments)
	{
		<p class="closed">The organiser has turned off comments from members for this adventure.</p>
	}
</div>

@code {
	[Parameter] public Guid RideId { get; set; }

	private RideDetail? _ride;
	private readonly List<CommentDto> _pinned = new();
	private readonly List<CommentDto> _comments = new();
	private string? _nextCursor;
	private bool _loadingMore;
	private string? _error;
	private bool _canPost;

	private string _composeText = string.Empty;
	private ComposePhoto? _composePhoto;
	private bool _isPoll;
	private PollComposer? _pollComposer;
	private bool _busy;

	// The submit button is enabled when there is something to post. For a normal comment
	// that means text or a photo; for a poll it means text (the question) and a valid spec.
	private bool CantPost()
	{
		if (_isPoll)
		{
			return string.IsNullOrWhiteSpace(_composeText) || _pollComposer?.BuildSpec() is null;
		}
		return string.IsNullOrWhiteSpace(_composeText) && _composePhoto is null;
	}

	private static readonly string[] ReactionKeys = ["like", "love", "laugh", "wow", "sad", "thanks"];

	// Emoji per reaction key. §17.4 fixes the six keys server-side; the glyph is a UI choice
	// only and lives here, close to the render.
	private static readonly Dictionary<string, string> ReactionIcons = new()
	{
		["like"] = "👍",
		["love"] = "❤️",
		["laugh"] = "😂",
		["wow"] = "😮",
		["sad"] = "😢",
		["thanks"] = "🙏",
	};

	protected override async Task OnParametersSetAsync()
	{
		_pinned.Clear();
		_comments.Clear();
		_nextCursor = null;
		_error = null;

		Hub.CommentPosted += OnCommentPosted;
		Hub.CommentEdited += OnCommentEdited;
		Hub.CommentRemoved += OnCommentRemoved;
		Hub.CommentPinChanged += OnCommentPinChanged;
		Hub.ReactionsUpdated += OnReactionsUpdated;
		Hub.PollUpdated += OnPollUpdated;

		// Clears whatever card was already showing for this adventure (§17.6) — the rider is now
		// looking at the conversation it was pointing at. It suppresses nothing: posts that land
		// while this page is open still raise a notification.
		Notifier.ThreadOpened(RideId);

		try
		{
			_ride = await Api.GetRideAsync(RideId);
			_canPost = _ride.Permissions.AllowMemberComments || _ride.IsOrganiser;
			await LoadPageAsync();

			try { await Hub.ConnectAsync(); await Hub.JoinRideAsync(RideId); }
			catch (Exception hubException)
			{
				// Thread stays readable without realtime; surface the reason so a broken
				// connection reads as "no live updates" rather than "the page is dead".
				_error = "Live updates are off: " + hubException.Message;
			}
		}
		catch (ApiException apiException) { _error = apiException.Error.Title; }
		catch (Exception exception) { _error = exception.Message; }
	}

	private async Task LoadPageAsync()
	{
		CommentPage page = await Api.GetThreadAsync(RideId, _nextCursor);

		if (_pinned.Count == 0)
		{
			_pinned.AddRange(page.Pinned);
		}

		_comments.AddRange(page.Comments);
		_nextCursor = page.NextCursor;
	}

	private async Task LoadMoreAsync()
	{
		if (_nextCursor is null || _loadingMore) return;
		_loadingMore = true;
		try { await LoadPageAsync(); }
		catch (ApiException apiException) { _error = apiException.Error.Title; }
		finally { _loadingMore = false; }
	}

	private async Task OnPhotoSelected(InputFileChangeEventArgs args)
	{
		try
		{
			IBrowserFile file = args.File;
			const long MaxBytes = 12L * 1024 * 1024;
			await using Stream stream = file.OpenReadStream(MaxBytes);
			using MemoryStream memory = new();
			await stream.CopyToAsync(memory);
			_composePhoto = new ComposePhoto(memory.ToArray(), file.ContentType, file.Name);
		}
		catch (Exception exception) { _error = exception.Message; }
	}

	private async Task PostAsync()
	{
		if (_busy) return;
		_busy = true;
		_error = null;
		try
		{
			Guid? photoId = null;
			if (_composePhoto is not null)
			{
				using MemoryStream memory = new(_composePhoto.Bytes);
				PhotoUploaded uploaded = await Api.UploadPhotoAsync(memory, _composePhoto.ContentType, _composePhoto.FileName);
				photoId = uploaded.PhotoId;
			}

			// ClientGuid is Phase 2's idempotency key (§4.4, §17.3): a flaky connection
			// can retry the same post safely, and the server's unique index rejects a
			// duplicate rather than creating a second copy.
			//
			// A poll rides along on the same request (§17.5) — one posting path means the
			// poll inherits idempotency, caps and permissions rather than needing its own
			// copy of each.
			PollSpec? poll = _isPoll ? _pollComposer?.BuildSpec() : null;

			CommentDto posted = await Api.PostCommentAsync(RideId, new PostCommentRequest(
				ClientGuid: Guid.NewGuid(),
				Body: string.IsNullOrWhiteSpace(_composeText) ? null : _composeText.Trim(),
				PhotoId: photoId,
				Poll: poll));

			// Insert locally so the page reflects the post even when the hub is offline.
			// OnCommentPosted dedupes by id, so an arriving broadcast is a no-op replace
			// rather than a second copy.
			InsertOrReplace(posted);

			_composeText = string.Empty;
			_composePhoto = null;
			_isPoll = false;
		}
		catch (ApiException apiException) { _error = apiException.Error.Title; }
		catch (Exception exception) { _error = exception.Message; }
		finally { _busy = false; }
	}

	private void OnCommentPosted(CommentDto comment)
	{
		InsertOrReplace(comment);
		_ = InvokeAsync(StateHasChanged);
	}

	/// <summary>
	/// Inserts a new comment at the top, or replaces the copy already in the list. Two
	/// sources produce the same comment — the POST response and the hub echo — and one of
	/// them arriving second must not create a duplicate row.
	/// </summary>
	private void InsertOrReplace(CommentDto comment)
	{
		int pinIndex = _pinned.FindIndex(c => c.Id == comment.Id);
		int listIndex = _comments.FindIndex(c => c.Id == comment.Id);

		if (pinIndex >= 0) _pinned[pinIndex] = comment;
		else if (listIndex >= 0) _comments[listIndex] = comment;
		else if (comment.IsPinned) _pinned.Insert(0, comment);
		else _comments.Insert(0, comment);
	}

	private void OnCommentEdited(CommentDto comment)
	{
		Replace(_pinned, comment);
		Replace(_comments, comment);
		_ = InvokeAsync(StateHasChanged);
	}

	private void OnCommentRemoved(Guid commentId)
	{
		_pinned.RemoveAll(c => c.Id == commentId);
		_comments.RemoveAll(c => c.Id == commentId);
		_ = InvokeAsync(StateHasChanged);
	}

	private void OnCommentPinChanged(Guid commentId, bool pinned)
	{
		// Move the comment between the two lists rather than mutate the record.
		CommentDto? found = _pinned.FirstOrDefault(c => c.Id == commentId)
			?? _comments.FirstOrDefault(c => c.Id == commentId);
		if (found is null) return;
		_pinned.RemoveAll(c => c.Id == commentId);
		_comments.RemoveAll(c => c.Id == commentId);
		CommentDto updated = found with { IsPinned = pinned };
		if (pinned) _pinned.Insert(0, updated); else _comments.Insert(0, updated);
		_ = InvokeAsync(StateHasChanged);
	}

	private void OnReactionsUpdated(Guid commentId, ReactionCounts counts)
	{
		UpdateReactions(_pinned, commentId, counts);
		UpdateReactions(_comments, commentId, counts);
		_ = InvokeAsync(StateHasChanged);
	}

	private static void UpdateReactions(List<CommentDto> list, Guid commentId, ReactionCounts counts)
	{
		int index = list.FindIndex(c => c.Id == commentId);
		if (index < 0) return;
		list[index] = list[index] with { Reactions = counts };
	}

	private void OnPollUpdated(Guid commentId, PollResults results)
	{
		UpdatePoll(_pinned, commentId, results);
		UpdatePoll(_comments, commentId, results);
		_ = InvokeAsync(StateHasChanged);
	}

	private static void UpdatePoll(List<CommentDto> list, Guid commentId, PollResults results)
	{
		int index = list.FindIndex(c => c.Id == commentId);
		if (index < 0) return;
		list[index] = list[index] with { Poll = results };
	}

	private async Task CastVoteAsync(CommentDto comment, IReadOnlyList<Guid> optionIds)
	{
		try { await Api.CastVoteAsync(comment.Id, new CastVoteRequest(optionIds)); }
		catch (ApiException apiException) { _error = apiException.Error.Title; }
	}

	private async Task ClosePollAsync(CommentDto comment)
	{
		try { await Api.ClosePollAsync(comment.Id); }
		catch (ApiException apiException) { _error = apiException.Error.Title; }
	}

	private static void Replace(List<CommentDto> list, CommentDto updated)
	{
		int index = list.FindIndex(c => c.Id == updated.Id);
		if (index >= 0) list[index] = updated;
	}

	private async Task ToggleReactionAsync(CommentDto comment, string reaction)
	{
		// Setting the same reaction twice clears it (§17.4). The endpoint accepts null to
		// clear, so the client sends null when the user taps their own choice again.
		string? next = comment.Reactions?.Mine == reaction ? null : reaction;
		try { await Api.SetReactionAsync(comment.Id, new SetReactionRequest(next)); }
		catch (ApiException apiException) { _error = apiException.Error.Title; }
	}

	private async Task PinAsync(CommentDto comment)
	{
		bool wantPin = !comment.IsPinned;
		bool ok = await Confirm.AskAsync(
			wantPin ? "Pin comment?" : "Unpin comment?",
			wantPin
				? "Pin this comment to the top of the thread so every member sees it."
				: "Remove this comment from the pinned section.",
			confirmText: wantPin ? "Pin" : "Unpin");
		if (!ok) return;
		try { await Api.PinCommentAsync(comment.Id, new PinCommentRequest(wantPin)); }
		catch (ApiException apiException) { _error = apiException.Error.Title; }
	}

	private async Task DeleteAsync(CommentDto comment)
	{
		bool ok = await Confirm.AskAsync(
			"Delete comment?",
			"This cannot be undone.",
			confirmText: "Delete",
			danger: true);
		if (!ok) return;
		try { await Api.DeleteCommentAsync(comment.Id); }
		catch (ApiException apiException) { _error = apiException.Error.Title; }
	}

	private async Task ReportAsync(CommentDto comment)
	{
		bool ok = await Confirm.AskAsync(
			"Report comment?",
			"The organiser and the operator will see this report.",
			confirmText: "Report");
		if (!ok) return;
		try
		{
			await Api.ReportCommentAsync(comment.Id, new ReportContentRequest("Reported by member"));
			_error = "Reported. The organiser and the operator will see it.";
		}
		catch (ApiException apiException) { _error = apiException.Error.Title; }
	}

	private RenderFragment RenderComment(CommentDto comment, bool pinned) => builder =>
	{
		builder.OpenElement(0, "article");
		builder.AddAttribute(1, "class", "comment" + (pinned ? " pinned" : ""));

		builder.OpenElement(2, "header");

		// The author's photograph, when they have one (§7.3).
		//
		// Every sequence number in this fragment was renumbered when this component was inserted:
		// they are hand-kept here rather than generated by the Razor compiler, and the poll branch
		// and the actions row had been sharing numbers with the branches above them. They now run
		// 0..58 in source order, which is what the compiler would have produced — a repeated number
		// lets the diffing renderer keep the wrong node between two comments.
		builder.OpenComponent<RiderAvatar>(3);
		builder.AddComponentParameter(4, nameof(RiderAvatar.UserName), comment.AuthorUserName);
		builder.CloseComponent();

		builder.OpenElement(5, "strong");
		builder.AddContent(6, comment.AuthorUserName);
		builder.CloseElement();
		builder.OpenElement(7, "span");
		builder.AddAttribute(8, "class", "posted");
		builder.AddContent(9, comment.PostedUtc.ToLocalTime().ToString("HH:mm"));
		if (comment.AuthoredEarlier)
		{
			builder.AddContent(10, " — written " + comment.CreatedUtc.ToLocalTime().ToString("HH:mm"));
		}
		if (comment.EditedUtc is not null)
		{
			builder.AddContent(11, " (edited)");
		}
		builder.CloseElement();
		builder.CloseElement();

		if (!string.IsNullOrEmpty(comment.Body))
		{
			builder.OpenElement(12, "p");
			builder.AddAttribute(13, "class", "body");
			builder.AddContent(14, comment.Body);
			builder.CloseElement();
		}

		if (comment.PhotoId is { } photoId)
		{
			builder.OpenComponent<AuthedImage>(15);
			builder.AddComponentParameter(16, nameof(AuthedImage.Url), $"/api/v1/photos/{photoId}");
			builder.AddComponentParameter(17, nameof(AuthedImage.Alt), "photo");
			builder.AddComponentParameter(18, nameof(AuthedImage.Class), "photo");
			builder.CloseComponent();
		}

		// Poll card, when this comment is a poll (§17.5).
		if (comment.Poll is { } pollResults)
		{
			CommentDto pollComment = comment;
			bool canClose = _ride?.IsOrganiser == true || comment.AuthorId == Auth.UserId;

			builder.OpenComponent<PollCard>(19);
			builder.AddComponentParameter(20, nameof(PollCard.Results), pollResults);
			builder.AddComponentParameter(21, nameof(PollCard.CanClose), canClose);
			builder.AddComponentParameter(22, nameof(PollCard.OnCast),
				EventCallback.Factory.Create<IReadOnlyList<Guid>>(this,
					ids => CastVoteAsync(pollComment, ids)));
			builder.AddComponentParameter(23, nameof(PollCard.OnClose),
				EventCallback.Factory.Create(this, () => ClosePollAsync(pollComment)));
			builder.CloseComponent();
		}

		// One row: reactions + Report on the left, Pin + Delete on the right.
		// justify-content: space-between at the row keeps the destructive controls in a
		// predictable place away from reactions people mash.
		builder.OpenElement(24, "div");
		builder.AddAttribute(25, "class", "actions");

		// Left group — reactions, then Report.
		builder.OpenElement(26, "div");
		builder.AddAttribute(27, "class", "actions-left");
		foreach (string key in ReactionKeys)
		{
			int count = comment.Reactions?.Counts.TryGetValue(key, out int c) == true ? c : 0;
			bool mine = comment.Reactions?.Mine == key;
			builder.OpenElement(28, "button");
			builder.AddAttribute(29, "type", "button");
			builder.AddAttribute(30, "class", "reaction" + (mine ? " mine" : ""));
			builder.AddAttribute(31, "title", key);
			CommentDto captured = comment;
			string keyLocal = key;
			builder.AddAttribute(32, "onclick", EventCallback.Factory.Create(this, () => ToggleReactionAsync(captured, keyLocal)));
			builder.OpenElement(33, "span");
			builder.AddAttribute(34, "class", "icon");
			builder.AddContent(35, ReactionIcons[key]);
			builder.CloseElement();
			if (count > 0)
			{
				builder.OpenElement(36, "span");
				builder.AddAttribute(37, "class", "count");
				builder.AddContent(38, count);
				builder.CloseElement();
			}
			builder.CloseElement();
		}
		if (comment.AuthorId != Auth.UserId)
		{
			builder.OpenElement(39, "button");
			builder.AddAttribute(40, "type", "button");
			builder.AddAttribute(41, "class", "icon-button report");
			builder.AddAttribute(42, "title", "Report");
			CommentDto reportCapture = comment;
			builder.AddAttribute(43, "onclick", EventCallback.Factory.Create(this, () => ReportAsync(reportCapture)));
			builder.AddContent(44, "🚩");
			builder.CloseElement();
		}
		builder.CloseElement();

		// Right group — Pin, Delete.
		builder.OpenElement(45, "div");
		builder.AddAttribute(46, "class", "actions-right");
		if (_ride?.IsOrganiser == true)
		{
			builder.OpenElement(47, "button");
			builder.AddAttribute(48, "type", "button");
			builder.AddAttribute(49, "class", "icon-button");
			builder.AddAttribute(50, "title", pinned ? "Unpin" : "Pin");
			CommentDto pinCapture = comment;
			builder.AddAttribute(51, "onclick", EventCallback.Factory.Create(this, () => PinAsync(pinCapture)));
			builder.AddContent(52, "📌");
			builder.CloseElement();
		}
		if (_ride?.IsOrganiser == true || comment.AuthorId == Auth.UserId)
		{
			builder.OpenElement(53, "button");
			builder.AddAttribute(54, "type", "button");
			builder.AddAttribute(55, "class", "icon-button");
			builder.AddAttribute(56, "title", "Delete");
			CommentDto delCapture = comment;
			builder.AddAttribute(57, "onclick", EventCallback.Factory.Create(this, () => DeleteAsync(delCapture)));
			builder.AddContent(58, "🗑️");
			builder.CloseElement();
		}
		builder.CloseElement();

		builder.CloseElement();

		builder.CloseElement();
	};

	public ValueTask DisposeAsync()
	{
		Hub.CommentPosted -= OnCommentPosted;
		Hub.CommentEdited -= OnCommentEdited;
		Hub.CommentRemoved -= OnCommentRemoved;
		Hub.CommentPinChanged -= OnCommentPinChanged;
		Hub.ReactionsUpdated -= OnReactionsUpdated;
		Hub.PollUpdated -= OnPollUpdated;

		// Nothing to tell the notifier on the way out: leaving a thread does not change what it
		// does, because opening one did not either (§17.6).
		return ValueTask.CompletedTask;
	}

	private sealed record ComposePhoto(byte[] Bytes, string ContentType, string FileName);
}

<style>
	.thread .pinned { margin: 0; padding: 0.5rem; background: #eff6ff20; border: 1px solid #FF0; border-radius: 6px; }

	.thread .comment { margin: 0.75rem 0; padding: 0.5rem; background: #334; border: 1px solid #e5e7eb; border-radius: 6px; }
	.thread .comment.pinned { border-color: #bfdbfe; }
	.thread .comment header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem; }
	.thread .comment .posted { font-size: 0.85rem; opacity: 0.7; }
	.thread .comment .body { margin: 0.25rem 0; white-space: pre-wrap; word-wrap: break-word; }
	.thread .comment .photo { max-width: 100%; margin-top: 0.5rem; border-radius: 4px; }
	.thread .reaction {
		display: inline-flex; align-items: center; gap: 0.25rem;
		padding: 0.15rem 0.5rem; font-size: 0.8rem; background: #fff2; border: 1px solid #e5e7eb;
		border-radius: 12px; cursor: pointer;
	}
	.thread .reaction .icon { font-size: 1rem; line-height: 1; }
	.thread .reaction .count { font-variant-numeric: tabular-nums; opacity: 0.8; }
	.thread .reaction.mine { background: #dbeafe20; border-color: #2563eb; }
	.thread .actions {
		display: flex; justify-content: space-between; align-items: center;
		gap: 0.5rem; margin-top: 0.5rem;
	}
	.thread .actions-left { display: flex; gap: 0.25rem; align-items: center; flex-wrap: wrap; }
	.thread .actions-right { display: flex; gap: 0.25rem; align-items: center; flex-shrink: 0; }
	.thread .actions .icon-button {
		padding: 0.2rem 0.45rem; font-size: 1rem; line-height: 1;
		background: transparent; border: none; border-radius: 4px; cursor: pointer;
	}
	.thread .actions .icon-button:hover { background: #fff2; }
	.thread .more { display: block; margin: 1rem auto; padding: 0.5rem 1rem; }
	.thread .composer { margin-top: 1rem; padding: 0.75rem; background: #fff2; border-radius: 6px; }
	.thread .composer textarea { width: 100%; padding: 0.5rem; font-size: 1rem; }
	.thread .composer-actions { display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem; }
	.thread .composer .poll-toggle {
		display: flex; align-items: center; gap: 0.35rem;
		padding: 0.4rem 0.8rem; background: #eef1f520; border-radius: 4px; cursor: pointer;
	}
	.thread .composer .poll-toggle input { margin: 0; }
	.thread .composer .attach { cursor: pointer; padding: 0.4rem 0.8rem; background: #eef1f520; border-radius: 4px; }
	.thread .composer .attach input { display: none; }
	.thread .composer .attached { font-size: 0.85rem; }
	.thread .composer .clear { margin-left: 0.25rem; background: none; border: none; cursor: pointer; }
	.thread .composer .primary { padding: 0.4rem 1rem; }
	.thread .closed { font-style: italic; opacity: 0.7; margin: 1rem 0; }
</style>
