@page "/group-rides/{RideId:guid}/permissions"
@attribute [Authorize]
@using DLR.Core.Contracts.Rides
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>Ride permissions — Dumb Luck Rides</PageTitle>

<div class="page page-medium">
	<a class="back" href="/group-rides/@RideId">← Back to ride</a>

	<h1>Content permissions</h1>

	<p class="lead">
		Turning a switch off stops <em>new</em> content — nothing is deleted.
		An organiser who wants something gone deletes it explicitly.
	</p>

	@if (_ride is null)
	{
		<p class="empty">Loading…</p>
	}
	else if (!_ride.IsOrganiser)
	{
		<p>Only the organiser can change these.</p>
	}
	else
	{
		<fieldset>
			<label class="switch">
				<input type="checkbox" @bind="_permissions.AllowMemberMarkers" />
				Members may place markers
			</label>
			<p class="note">
				The useful marker is <em>"gravel across the whole corner"</em>, and the
				rider who found it is whoever hit it first. Off leaves reading
				unaffected.
			</p>
		</fieldset>

		<fieldset>
			<label class="switch">
				<input type="checkbox" @bind="_permissions.AllowMemberComments" />
				Members may post comments
			</label>
			<p class="note">
				Off leaves reading, reacting and voting alone — reactions carry no free
				text and switching off polls would break them rather than moderate them.
			</p>
		</fieldset>

		<fieldset>
			<label class="switch">
				<input type="checkbox" @bind="_permissions.AllowMemberPhotos" />
				Members may attach photos
			</label>
			<p class="note">
				Its own switch, not a consequence of comments — photos are the expensive
				half and often the thing an organiser wants to stop while leaving
				conversation alone.
			</p>
		</fieldset>

		<button type="button" class="primary" @onclick="SaveAsync" disabled="@_busy">
			@(_busy ? "Saving…" : "Save")
		</button>
	}

	@if (_error is not null)
	{
		<p class="error">@_error</p>
	}
</div>

@code {
	[Parameter] public Guid RideId { get; set; }

	private RideDetail? _ride;
	// Mutable local copy — the record is immutable but the UI binds to fields, so
	// a plain class is easier than fighting @bind against `with`-expressions.
	private RidePermissionsMutable _permissions = new();
	private string? _error;
	private bool _busy;

	protected override async Task OnParametersSetAsync()
	{
		try
		{
			_ride = await Api.GetRideAsync(RideId);
			_permissions = new RidePermissionsMutable
			{
				AllowMemberMarkers = _ride.Permissions.AllowMemberMarkers,
				AllowMemberComments = _ride.Permissions.AllowMemberComments,
				AllowMemberPhotos = _ride.Permissions.AllowMemberPhotos,
			};
		}
		catch (ApiException apiException) { _error = apiException.Error.Title; }
	}

	private async Task SaveAsync()
	{
		_busy = true;
		_error = null;
		try
		{
			await Api.UpdatePermissionsAsync(RideId, new DLR.Core.Contracts.Rides.RidePermissions(
				_permissions.AllowMemberMarkers,
				_permissions.AllowMemberComments,
				_permissions.AllowMemberPhotos));

			Nav.NavigateTo($"/group-rides/{RideId}");
		}
		catch (ApiException apiException) { _error = apiException.Error.Title; }
		finally { _busy = false; }
	}

	private sealed class RidePermissionsMutable
	{
		public bool AllowMemberMarkers { get; set; } = true;
		public bool AllowMemberComments { get; set; } = true;
		public bool AllowMemberPhotos { get; set; } = true;
	}
}

<style>
	/* Indented under the switch it qualifies. */
	.page .note { margin: 0.5rem 0 0 1.5rem; }
</style>
