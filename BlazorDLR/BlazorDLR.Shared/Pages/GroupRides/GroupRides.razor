@page "/group-rides"
@attribute [Authorize]
@using BlazorDLR.Shared.Services
@using BlazorDLR.Shared.State
@using DLR.Core.Contracts.Rides
@inject IApiClient Api
@inject ConfirmService Confirm

<PageTitle>Group adventures — Dumb Luck Routes</PageTitle>

@*
	The signed-in entry point to group rides (§5.2).

	Two sections split server-side (§5.2), so a member of one ride and the organiser of
	another gets two lists rather than one list plus a filter. Both sections show the join
	code — a rider who has joined needs it to tell somebody else how to follow along, and
	the badge is the only place they can read it back off.
*@

<div class="page page-medium">
	<PageNav Title="Group adventures" BackHref="/" BackLabel="Back to home" />

	<div class="cards">
		<a class="card" href="/group-rides/create">
			<h2>Create an adventure</h2>
			<p>Start an adventure of your own. You will be the organiser.</p>
		</a>
		<a class="card" href="/group-rides/join">
			<h2>Join an adventure</h2>
			<p>Enter a code the organiser gave you.</p>
		</a>
	</div>

	@*
		Above the lists rather than instead of them. A failed *load* has nothing to show under it
		anyway, but a refused delete is a message about one row of a list the reader is still
		looking at — replacing the list with the sentence would take away the thing it is about.
	*@
	@if (_error is not null)
	{
		<p class="error">@_error</p>
	}

	@if (_rides is null)
	{
		@if (_error is null)
		{
			<p class="empty">Loading…</p>
		}
	}
	else
	{
		<section class="ride-section">
			<h2>Organised by you</h2>
			@if (_rides.Organised.Count == 0)
			{
				<p class="empty">You have not created any adventures yet.</p>
			}
			else
			{
				<ul class="ride-list">
					@foreach (RideSummary ride in _rides.Organised)
					{
						<li class="ride">
							<a class="ride-link" href="/group-rides/live/@ride.Id">
								<h2>@ride.Name</h2>
								<span class="meta">
									@ride.StartUtc.ToLocalTime().ToString("ddd d MMM yyyy, h:mm tt")
									· @ride.MemberCount member@(ride.MemberCount == 1 ? "" : "s")
									· @ride.State
								</span>
							</a>
							@if (!string.IsNullOrEmpty(ride.JoinCode))
							{
								<span class="join-code" title="Join code — share with people you invite">
									@ride.JoinCode
								</span>
							}
							@*
								Organised only. Deleting is the organiser's verb; a member who wants
								out has Leave, on the ride's own screen, and it takes their position
								with them rather than everybody else's day.
							*@
							<button type="button" class="danger" disabled="@(_deleting == ride.Id)"
									title="Delete this adventure" aria-label="@($"Delete {ride.Name}")"
									@onclick="() => DeleteAsync(ride)">
								<i class="fa fa-fw fa-trash" aria-hidden="true"></i>
							</button>
						</li>
					}
				</ul>
			}
		</section>

		<section class="ride-section">
			<h2>Joined</h2>
			@if (_rides.Joined.Count == 0)
			{
				<p class="empty">You have not joined any adventures yet.</p>
			}
			else
			{
				<ul class="ride-list">
					@foreach (RideSummary ride in _rides.Joined)
					{
						<li class="ride">
							<a class="ride-link" href="/group-rides/live/@ride.Id">
								<h2>@ride.Name</h2>
								<span class="meta">
									@ride.StartUtc.ToLocalTime().ToString("ddd d MMM yyyy, h:mm tt")
									· @ride.MemberCount member@(ride.MemberCount == 1 ? "" : "s")
									· @ride.State
								</span>
							</a>
							@if (!string.IsNullOrEmpty(ride.JoinCode))
							{
								<span class="join-code" title="Join code — share with people you invite">
									@ride.JoinCode
								</span>
							}
						</li>
					}
				</ul>
			}
		</section>
	}
</div>

@code {
	private MyRides? _rides;
	private string? _error;

	// Which row's trash was pressed, rather than one page-wide flag: the list is several rides
	// and greying all of them out because one is going says the wrong thing about the others.
	private Guid? _deleting;

	protected override async Task OnInitializedAsync() => await LoadAsync();

	private async Task LoadAsync()
	{
		try
		{
			_rides = await Api.ListMyRidesAsync();
		}
		catch (Exception exception)
		{
			_error = exception.Message;
		}
	}

	/// <summary>
	/// Deletes an adventure the caller organises (§5.2), through the app's own dialog rather than
	/// <c>window.confirm</c> — it is irreversible, and the trash sits one thumb-width from the row
	/// that opens the ride.
	/// <para>
	/// The list is refetched rather than the row spliced out locally: the server is the one that
	/// knows what is left, and a refusal has to leave the row exactly where it was.
	/// </para>
	/// </summary>
	private async Task DeleteAsync(RideSummary ride)
	{
		if (_deleting is not null)
		{
			return;
		}

		bool confirmed = await Confirm.AskAsync(
			$"Delete {ride.Name}?",
			"The adventure, its planned routes, its markers and everything anybody posted to it "
			+ "are deleted from the server, for every member and not only for you. This cannot be "
			+ "undone. Ending the adventure instead stops the location sharing and keeps the day.",
			confirmText: "Delete",
			danger: true);

		if (!confirmed)
		{
			return;
		}

		_deleting = ride.Id;
		_error = null;

		try
		{
			await Api.DeleteRideAsync(ride.Id);
			await LoadAsync();
		}
		catch (Exception exception)
		{
			// The one that lands here in practice is the refusal on a ride in progress, and the
			// server says so in words worth showing.
			_error = $"Could not delete {ride.Name}: {exception.Message}";
		}
		finally
		{
			_deleting = null;
		}
	}
}

<style>
	.ride-section { margin-top: 1.5rem; }
	.ride-section h2 { font-size: 1.1rem; margin-bottom: 0.5rem; }
	.ride-list { list-style: none; padding: 0; margin: 0; }
	.ride {
		display: flex; justify-content: space-between; align-items: center; gap: 1rem;
		padding: 0.75rem; margin-bottom: 0.5rem; background: #fff2; border-radius: 6px;
	}
	.ride-link { flex: 1; text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 0.25rem; }
	.ride-link:hover strong { text-decoration: underline; }
	.ride .meta { font-size: 0.85rem; opacity: 0.75; }
	/* An icon button, so it states its own size rather than inheriting the page's text-button
	   padding. Square and thumb-sized, because it sits beside the link that opens the ride. */
	.ride .danger {
		flex: 0 0 auto;
		min-width: 44px;
		min-height: 44px;
		padding: 0 0.6rem;
		font-size: 1rem;
	}

	.ride .join-code {
		font-family: ui-monospace, monospace;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		padding: 0.25rem 0.5rem; background: #dbeafe; color: #1e40af; border-radius: 4px;
	}
</style>
