@page "/group-rides/join"
@attribute [Authorize]
@using BlazorDLR.Shared.Diagnostics
@using DLR.Core.Contracts.Rides
@inject IApiClient Api
@inject IServiceProvider Services
@inject NavigationManager Nav

<PageTitle>Join an adventure - Dumb Luck Routes</PageTitle>

<div class="page page-form form-page">
	<PageNav Title="Join an adventure" BackHref="/group-rides" BackLabel="Back to group adventures" />

	<p class="lead">
		Enter the code the organiser gave you. Codes are six characters (§5.2).
	</p>

	<form @onsubmit="JoinAsync" @onsubmit:preventDefault="true">
		<label>
			Join code
			<input @bind="_code" placeholder="AB3K9Z" autocomplete="off" required autofocus />
		</label>

		<label>
			Message (optional - for approval rides)
			<textarea @bind="_message" rows="3" maxlength="200"
					  placeholder="Anything you want the organiser to see."></textarea>
		</label>

		<button type="submit" class="primary" disabled="@_busy">
			@(_busy ? "Joining…" : "Join")
		</button>
	</form>

	@if (_error is not null)
	{
		<div class="error" role="alert">
			<strong>@_error.Title</strong>
			@if (_error.Messages.Count > 0)
			{
				<ul>
					@foreach (string message in _error.Messages)
					{
						<li>@message</li>
					}
				</ul>
			}
		</div>
	}
</div>

@code {
	private string _code = string.Empty;
	private string _message = string.Empty;
	private ApiError? _error;
	private bool _busy;

	/// <summary>
	/// Turns sharing on for an adventure this rider has just joined - on a device that can
	/// actually broadcast, and nowhere else.
	/// <para>
	/// <strong>Joining is the decision.</strong> Somebody who has typed an organiser's code into
	/// their phone has said they are going on the adventure, and the thing the adventure is for is
	/// the group being able to see each other. Leaving the flag off made the common case a rider
	/// who believed they were on the map, was not, and found out when somebody rang to ask where
	/// they had got to. The switch is still theirs - the ride's info page turns it off in one tap,
	/// and the map says so in red for as long as it is off.
	/// </para>
	/// <para>
	/// <strong>Only where there is a receiver.</strong> A browser has no GPS (§18.6), so setting
	/// the flag there would light a consent record on the server that no fix will ever follow -
	/// the same reason the info page's sharing panel is absent on the web.
	/// </para>
	/// <para>
	/// <strong>Nothing is collected by this call.</strong> It sets a server flag; the receiver
	/// starts later, from the ride screen, and Play's prominent disclosure and the platform's own
	/// permission dialog both sit in front of that (<see cref="LocationBroadcastState"/>). This
	/// changes what the default answer is, not whether the rider is asked before their phone
	/// starts reading a position.
	/// </para>
	/// <para>
	/// Failure is swallowed on purpose: a default that could not be applied must not be a reason a
	/// rider cannot get into the adventure they have just joined. They arrive not sharing, the map
	/// says so in red, and the info page's switch is one tap away.
	/// </para>
	/// </summary>
	/// <param name="rideId">The adventure just joined.</param>
	private async Task ShareByDefaultAsync(Guid rideId)
	{
		if (Services.GetService<LocationBroadcastState>() is not { IsSupported: true })
			return;

		try
		{
			await Api.SetSharingAsync(rideId, new SetSharingRequest(true));
		}
		catch (Exception exception)
		{
			DiagnosticLog.WriteError($"turning sharing on for newly joined adventure {rideId}", exception);
		}
	}

	private async Task JoinAsync()
	{
		if (_busy) return;
		_busy = true;
		_error = null;

		try
		{
			JoinResult result = await Api.JoinRideByCodeAsync(new JoinByCodeRequest(
				Code: _code.Trim(),
				Message: string.IsNullOrWhiteSpace(_message) ? null : _message.Trim()));

			if (result.Joined)
			{
				await ShareByDefaultAsync(result.RideId);

				// Straight into the ride. On a host with no receiver its own screen decides
				// whether to ask for sharing consent (§5.6) - that check lives with the ride,
				// not with the join, because the same prompt runs on the approval path.
				Nav.NavigateTo($"/group-rides/live/{result.RideId}");
			}
			else
			{
				// Approval ride: request pending. §5.2 says the organiser decides; the
				// decision arrives via email today (SRV-20) and via push in a later phase.
				Nav.NavigateTo("/group-rides");
			}
		}
		catch (ApiException apiException)
		{
			_error = apiException.Error;
		}
		catch (Exception exception)
		{
			_error = new ApiError(default, "Could not join.", new[] { exception.Message });
		}
		finally
		{
			_busy = false;
		}
	}
}

<style>
	/* A join code is typed, read back and compared - monospace and spaced out. */
	.page input {
		text-transform: uppercase; letter-spacing: 0.15em; font-family: ui-monospace, monospace;
	}
</style>
