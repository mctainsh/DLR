@page "/group-rides/{RideId:guid}/info"
@attribute [Authorize]
@using BlazorDLR.Shared.Components
@using DLR.Core.Contracts.Rides
@using DLR.Core.Contracts.Tracks
@inject IApiClient Api
@inject IRideHubClient Hub
@inject AuthState Auth
@inject ConfirmService Confirm
@inject CurrentRideState CurrentRide
@inject LocationBroadcastState Broadcast
@inject NavigationManager Nav
@inject RideSnapshotCache Cache
@inject RouteStyleState RouteStyles
@implements IAsyncDisposable

@*
	Everything about a group ride that is not the map (§5.1, §5.4, §5.6, §5.8) — who is
	on it, how far apart they are, the join code, this rider's sharing switch, and the
	organiser's lifecycle controls.

	These used to be a sidebar beside the live map. The map is now the whole screen, so
	they moved here and the map's hamburger points at them under "Info". The data behind
	both screens is the same RideSession: one snapshot, the same hub deltas on top (§5.3),
	so a state change made here is on the map before the rider gets back to it.

	Deliberately NOT here: the marker list, the "add marker" composer and the ride thread.
	Those are things you do while riding, and they stay one tap from the map.
*@

<PageTitle>@Title — Dumb Luck Routes</PageTitle>

<div class="page page-medium ride-info">
	@* Outside the load branches: the way back to the map has to be there while the ride
	   is loading and if it fails. The state badge waits, because there is no state to
	   report until the ride answers. *@
	<PageNav Title="@Title" BackHref="@($"/group-rides/{RideId}")" BackLabel="Back to the map">
		<Actions>
			@if (_session.Ride is { } loaded)
			{
				<span class="state @loaded.State.ToString().ToLowerInvariant()">@loaded.State</span>
			}
		</Actions>
	</PageNav>

	@if (_session.Ride is null && _session.Error is null)
	{
		<p class="empty">Loading…</p>
	}
	else if (_session.Ride is not { } ride)
	{
		<p class="error">@_session.Error</p>
	}
	else
	{
		<p class="lead">
			@(ride.Description ?? "")
		</p>

		@if (_session.Error is { } problem)
		{
			<p class="error">@problem</p>
		}

		@if (ride.IsOrganiser && ride.JoinCode is not null)
		{
			<div class="join-code">
				<strong>Join code:</strong> <span class="code">@ride.JoinCode</span>
				<em>Only you see this. Share it with the people you want on the ride.</em>
			</div>
		}

		@if (_session.WindDownEndsUtc is { } endsUtc)
		{
			<div class="wind-down" role="alert">
				<strong>Sharing wind-down active.</strong>
				Members who kept sharing on can carry on until they stop — or until
				<strong>@endsUtc.ToLocalTime().ToString("HH:mm")</strong>, when the server
				stops it for everyone still on.
			</div>
		}

		<div class="panels">
			<MemberList Members="ride.Members" />

			@*
				The ride's planned routes (§5.4). A set rather than one line, because a day out is
				commonly the short option and the long option, or the way out and the way home.
				Each row's swatch is the colour that route is drawn in on the map, so the list and
				the map name the same thing the same way.
			*@
			<div class="routes">
				<h3>Routes</h3>

				@if (_session.Routes.Count == 0)
				{
					<p class="hint">No route on this ride yet.</p>
				}
				else
				{
					<ul class="route-list">
						@for (int index = 0; index < _session.Routes.Count; index++)
						{
							RideRoute route = _session.Routes[index];

							<li>
								@*
									The swatch is the control, not a picture of one. It already had to
									be the colour the line is drawn in for the list to be readable
									against the map; making it the picker means the colour is changed
									where it is shown, and the row keeps its shape.
								*@
								<input type="color" class="swatch"
									   value="@RouteStyles.ColourFor(route.TrackId, RoutePalette.At(index))"
									   @onchange="args => OnRouteColourChangedAsync(route.TrackId, args)"
									   aria-label="@($"Colour for {route.Name ?? "unnamed route"}")" />

								<span class="what">
									<strong>@(route.Name ?? "Unnamed route")</strong>
									<em>
										@FormatKm(route.DistanceM)
										@if (index == 0 && _session.Routes.Count > 1)
										{
											@* §5.4 projects riders against one line, and it is this one. *@
											<span class="primary" title="Gaps and off-route warnings use this route">· gaps use this</span>
										}
									</em>
								</span>

								@*
									Only once there is something to undo. A permanently-present
									"auto" beside every route would read as a second colour
									control on a row that already has one.
								*@
								@if (RouteStyles.HasRouteColour(route.TrackId))
								{
									<button type="button" class="auto-colour"
											@onclick="() => ClearRouteColourAsync(route.TrackId)"
											aria-label="@($"Use the automatic colour for {route.Name ?? "unnamed route"}")"
											title="Back to the automatic colour">
										Auto
									</button>
								}

								@if (_session.CanManageRoutes)
								{
									<button type="button" class="remove"
											@onclick="() => RemoveRouteAsync(route)"
											disabled="@_session.Busy"
											aria-label="@($"Remove {route.Name ?? "unnamed route"} from this ride")">
										Remove
									</button>
								}
							</li>
						}
					</ul>
				}

				@if (_session.CanManageRoutes)
				{
					@if (!_addingRoute)
					{
						<button type="button" class="primary" @onclick="OpenRoutePickerAsync" disabled="@_session.Busy">
							Add a route…
						</button>
					}
					else
					{
						<div class="route-picker">
							@* The error is tested first: a failed fetch leaves _tracks null so that
							   re-opening the picker tries again, which means "still null" and
							   "could not be fetched" would otherwise look the same. *@
							@if (_tracksError is { } trouble)
							{
								<p class="error">@trouble</p>
							}
							else if (_tracks is null)
							{
								<p class="hint">Loading your tracks…</p>
							}
							else if (Attachable.Count == 0)
							{
								@*
									Only the caller's own tracks can be attached (§15.4) — a route
									somebody sent you is added by importing the GPX they sent, which
									is the copy feature and needs no endpoint of its own.
								*@
								<p class="hint">
									Nothing left to add. Routes come from your own tracks —
									<a href="/import">import a GPX</a> or record a ride first.
								</p>
							}
							else
							{
								<ul class="track-list">
									@foreach (TrackSummary track in Attachable)
									{
										<li>
											<button type="button" @onclick="() => AddRouteAsync(track)"
													disabled="@_session.Busy">
												<strong>@(track.Name ?? "Unnamed track")</strong>
												<em>@FormatKm(track.DistanceM)</em>
											</button>
										</li>
									}
								</ul>
							}

							<button type="button" class="cancel" @onclick="CloseRoutePicker">Cancel</button>
						</div>
					}
				}
			</div>

			@*
				How this device draws those routes (§18.6). It sits directly under the route
				list because that list is the thing it changes the look of — the swatches above
				follow these controls, so the effect of a choice is visible without leaving the
				panel.

				Every member gets these, organiser or not, and they are not part of the ride:
				legibility depends on the phone, the mount and the sunlight in front of one
				rider, and two riders on the same ride can hold different answers without
				either being wrong.
			*@
			<div class="route-style">
				<h3>Route display</h3>
				<p class="hint">
					Stored on this device only. It is never sent to the server, and nobody
					else on the ride sees your choices.
				</p>

				<label class="switch one-colour">
					<input type="checkbox" checked="@(Style.FillColour is not null)"
						   @onchange="OnFillOverrideToggledAsync" />
					Draw every route in the same colour
				</label>

				@if (Style.FillColour is { } fill)
				{
					<label class="field">
						<span>Line colour</span>
						<input type="color" value="@fill" @onchange="OnFillColourChangedAsync"
							   aria-label="Line colour" />
						<em>@fill</em>
					</label>
				}
				else
				{
					@* §5.4 assigns a colour per route by position, which is what makes a
					   three-route ride readable. Say so, rather than leaving the control
					   above looking like it does nothing. *@
					<p class="note">
						Each route keeps its own colour, so the list above and the map name the
						same route the same way.
					</p>
				}

				@* The two colour controls overlap, and which wins is not guessable. Said once,
				   here, next to the switch it qualifies. *@
				<p class="note">
					To colour one route on its own, tap its swatch in the list above — that
					beats whichever of these applies.
				</p>

				<label class="field">
					<span>Outline colour</span>
					<input type="color" value="@Style.OutlineColour" @onchange="OnOutlineColourChangedAsync"
						   aria-label="Line outline colour" />
					<em>@Style.OutlineColour</em>
				</label>

				<label class="field">
					<span>Line width</span>
					<input type="range" min="@RouteStyle.MinLineWidthPx" max="@RouteStyle.MaxLineWidthPx" step="1"
						   value="@Style.LineWidthPx.ToString("0")" @onchange="OnLineWidthChangedAsync"
						   aria-label="Line width in pixels" />
					<em>@Style.LineWidthPx.ToString("0") px</em>
				</label>

				<label class="switch arrows">
					<input type="checkbox" checked="@Style.ShowDirectionArrows" @onchange="OnArrowsToggledAsync" />
					Show direction arrows along the route
				</label>

				@if (Style.ShowDirectionArrows)
				{
					<label class="field">
						<span>Arrow colour</span>
						<input type="color" value="@Style.ArrowColour" @onchange="OnArrowColourChangedAsync"
							   aria-label="Direction arrow colour" />
						<em>@Style.ArrowColour</em>
					</label>
				}

				<button type="button" class="cancel" @onclick="ResetStyleAsync" disabled="@(!RouteStyles.IsCustomised)">
					Reset to defaults
				</button>
			</div>

			@if (ride.State == RideStateDto.Live)
			{
				<GapList Route="_session.RoutePolyline" Positions="_session.Positions" />
			}

			@if (ride.State == RideStateDto.Live || ride.State == RideStateDto.Open)
			{
				<div class="sharing">
					<h3>My sharing</h3>
					<label class="switch">
						<input type="checkbox" checked="@_session.Sharing" @onchange="ToggleSharingAsync"
							   disabled="@_session.Busy" />
						Broadcast my location to this ride
					</label>
					<p class="hint">
						You can turn this off at any moment. Turning it off deletes the
						stored fix — merely stopping the broadcast would leave a last-known
						point on the map.
					</p>

					@*
						What the switch actually produced (§4.3). The flag and the receiver are two
						different things and either can be the one that is not working: permission
						refused, no fix yet, or the rider standing inside their own private area.
						Saying "sharing is on" and stopping there is how somebody ends up believing
						they are on a map they are not on.
					*@
					@if (_session.SharingPending)
					{
						@*
							Consent is recorded, and the ride has not started — so the server would
							drop every fix (§5.1) and the receiver is deliberately not running.
							Stated in place of the receiver's own status, which would otherwise read
							"Not sharing your location" and flatly contradict the switch above it.
						*@
						<p class="gps-state" role="status">
							<i class="fa fa-fw fa-location-crosshairs" aria-hidden="true"></i>
							Your position starts going to the group when the organiser starts the
							ride. Your phone's GPS stays off until then.
						</p>
					}
					else
					{
						<p class="gps-state @(Broadcast.NeedsAttention ? "warn" : null)" role="status">
							<i class="fa fa-fw fa-location-crosshairs" aria-hidden="true"></i>
							@Broadcast.Describe()
						</p>
					}

					@if (Broadcast.Status == LocationBroadcastStatus.Broadcasting)
					{
						<p class="hint">
							Your phone keeps sending while the app is in the background or the screen
							is off. It stops when you turn this off, leave the ride, or the ride ends.
						</p>
					}
				</div>
			}

			@*
				Leaving the ride (§5.2). Here rather than in the map's hamburger: that menu is what
				a rider reaches for while riding, and every item on it is reversible. This one ends
				the membership, and getting back on needs the join code or a new request.

				Not offered to the organiser, and not because it is dangerous — the server refuses
				it outright (409, "a ride nobody organises has nobody to decide who is in it"), so a
				button here would be a control that cannot work. Their way out is End ride, below.
			*@
			@if (!ride.IsOrganiser)
			{
				<div class="membership">
					<h3>This ride</h3>
					@* app.css's `.danger`: destructive, but not the point of the page — the same
					   treatment revoking a device gets, rather than the filled red of a delete
					   that happens on the tap. This one opens a confirm. *@
					<button type="button" class="danger leave" @onclick="LeaveRideAsync" disabled="@_session.Busy">
						Leave ride…
					</button>
					<p class="hint">
						Your sharing stops, the position the ride holds for you is deleted, and the
						ride drops off your rail. You would need the join code — or a new request —
						to get back on.
					</p>
				</div>
			}

			@if (ride.IsOrganiser)
			{
				<div class="organiser">
					<h3>Organiser</h3>
					<a href="/group-rides/@RideId/requests">Join requests</a>
					<a href="/group-rides/@RideId/permissions">Content permissions</a>

					@if (ride.State == RideStateDto.Open)
					{
						<button type="button" class="primary" @onclick="_session.StartAsync" disabled="@_session.Busy">
							Start ride
						</button>
					}
					@if (ride.State == RideStateDto.Live)
					{
						<button type="button" class="primary" @onclick="() => _showEndDialog = true"
								disabled="@_session.Busy">
							End ride…
						</button>
					}
				</div>
			}
		</div>

		@if (_showEndDialog)
		{
			<div class="end-dialog" role="dialog">
				<div class="end-card">
					<h2>End @ride.Name?</h2>
					<p>Choose what happens to everyone's sharing.</p>
					<button type="button" class="primary" @onclick="() => EndRideAsync(RideEndingDto.Immediate)"
							disabled="@_session.Busy">
						Stop sharing for everyone now
					</button>
					<button type="button" class="primary" @onclick="() => EndRideAsync(RideEndingDto.WindDown)"
							disabled="@_session.Busy">
						Let riders stop themselves (2-hour wind-down)
					</button>
					<button type="button" class="cancel" @onclick="() => _showEndDialog = false">
						Cancel
					</button>
					<p class="note">
						The wind-down is capped, cannot be extended, and force-stops on the
						server. A rider who forgets is not tracked forever.
					</p>
				</div>
			</div>
		}
	}
</div>

@code {
	[Parameter] public Guid RideId { get; set; }

	private RideSession _session = default!;
	private bool _showEndDialog;

	/// <summary>Whether the "add a route" picker is open.</summary>
	private bool _addingRoute;

	/// <summary>
	/// The caller's own tracks, fetched when the picker is first opened rather than on load.
	/// Most visits to this page never attach anything, and the list is only useful to the two
	/// people who may.
	/// </summary>
	private IReadOnlyList<TrackSummary>? _tracks;

	private string? _tracksError;

	private string Title => _session?.Ride?.Name ?? "Ride";

	/// <summary>
	/// The tracks that could still be added: the caller's own, minus the ones already on the ride.
	/// Filtered here rather than server-side because the server's list endpoint is the ordinary
	/// track list and has no business knowing about this screen.
	/// </summary>
	private IReadOnlyList<TrackSummary> Attachable
	{
		get
		{
			if (_tracks is null)
			{
				return [];
			}

			HashSet<Guid> attached = [.. _session.Routes.Select(route => route.TrackId)];

			return [.. _tracks.Where(track => !attached.Contains(track.Id))];
		}
	}

	/// <summary>How this device draws routes. Read through, never copied — a stale copy would
	/// leave the swatches disagreeing with the map the controls just changed.</summary>
	private RouteStyle Style => RouteStyles.Style;

	protected override void OnInitialized()
	{
		_session = new RideSession(Api, Hub, Auth, Broadcast, Cache);
		_session.Changed += OnSessionChanged;

		// Same handler as the session's: both mean "something this page renders has moved".
		RouteStyles.Changed += OnSessionChanged;
		Broadcast.Changed += OnSessionChanged;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			// Not in OnInitialized — the web binding reads localStorage over JS interop, which
			// is unreachable on the prerender pass. Idempotent, so this costs nothing on a
			// device where a map has already loaded it.
			await RouteStyles.LoadAsync();
		}
	}

	protected override async Task OnParametersSetAsync()
	{
		if (_session.RideId == RideId)
		{
			return;
		}

		_showEndDialog = false;
		CloseRoutePicker();

		// Cleared rather than kept: a different ride is a different set of already-attached
		// tracks, and a stale list would offer one that is on this ride already.
		_tracks = null;
		_tracksError = null;

		await _session.LoadAsync(RideId);
	}

	// -- Routes (§5.4) ------------------------------------------------------------------------

	private async Task OpenRoutePickerAsync()
	{
		_addingRoute = true;

		if (_tracks is not null)
		{
			return;
		}

		// Cleared before the retry, so a second attempt that succeeds does not leave the previous
		// failure showing above the list it contradicts.
		_tracksError = null;

		try
		{
			_tracks = await Api.ListTracksAsync();
		}
		catch (ApiException apiException)
		{
			// Stated where the picker is, not over the whole page: the rest of the ride is fine,
			// and the next tap of "Add a route…" tries again.
			_tracksError = apiException.Error.Title;
		}
		catch (Exception exception)
		{
			_tracksError = exception.Message;
		}
	}

	private void CloseRoutePicker() => _addingRoute = false;

	private async Task AddRouteAsync(TrackSummary track)
	{
		await _session.AddRouteAsync(track.Id);

		// Left open on failure so the stated error sits next to the list it came from.
		if (_session.Error is null)
		{
			CloseRoutePicker();
		}
	}

	private Task RemoveRouteAsync(RideRoute route) => _session.RemoveRouteAsync(route.TrackId);

	// -- Route display (§18.6) ----------------------------------------------------------------
	//
	// Each control writes straight through: there is no Save button, because there is nothing
	// to fail and nothing to validate — the map behind this page is already drawing the new
	// value by the time the slider stops moving, which is the only confirmation worth having.

	/// <summary>
	/// Switches between "each route its own colour" and one colour for all of them.
	/// <para>
	/// Turning it on seeds the override with the palette's first entry — the colour a
	/// single-route ride is already drawn in — so the control does something visible without
	/// jumping to a colour the rider never chose.
	/// </para>
	/// </summary>
	private Task OnFillOverrideToggledAsync(ChangeEventArgs args)
	{
		bool wantsOneColour = args.Value is bool value && value;
		return RouteStyles.SetAsync(Style with { FillColour = wantsOneColour ? RoutePalette.At(0) : null });
	}

	private Task OnFillColourChangedAsync(ChangeEventArgs args) =>
		RouteStyles.SetAsync(Style with
		{
			// Falls back to the current value rather than the shipped default: a browser whose
			// colour input degraded to a text box can hand back anything, and losing the
			// colour you had is a worse answer than ignoring the keystroke.
			FillColour = RouteStyle.NormaliseColour(args.Value?.ToString(), Style.FillColour ?? RoutePalette.At(0)),
		});

	private Task OnOutlineColourChangedAsync(ChangeEventArgs args) =>
		RouteStyles.SetAsync(Style with
		{
			OutlineColour = RouteStyle.NormaliseColour(args.Value?.ToString(), Style.OutlineColour),
		});

	private Task OnArrowColourChangedAsync(ChangeEventArgs args) =>
		RouteStyles.SetAsync(Style with
		{
			ArrowColour = RouteStyle.NormaliseColour(args.Value?.ToString(), Style.ArrowColour),
		});

	private Task OnArrowsToggledAsync(ChangeEventArgs args) =>
		RouteStyles.SetAsync(Style with { ShowDirectionArrows = args.Value is bool value && value });

	private Task OnLineWidthChangedAsync(ChangeEventArgs args)
	{
		// A range input posts a string. Invariant because that is what the browser sends
		// regardless of locale, and InvariantGlobalization is on solution-wide anyway.
		if (!double.TryParse(
				args.Value?.ToString(),
				System.Globalization.NumberStyles.Float,
				System.Globalization.CultureInfo.InvariantCulture,
				out double width))
		{
			return Task.CompletedTask;
		}

		// Out-of-range values are clamped by RouteStyle rather than rejected here.
		return RouteStyles.SetAsync(Style with { LineWidthPx = width });
	}

	/// <summary>
	/// Pins a colour to one route (§5.4). Keyed on the track rather than on the row, so the
	/// colour follows that GPX onto the next ride it is attached to instead of following
	/// whatever ends up second in some other list.
	/// </summary>
	private Task OnRouteColourChangedAsync(Guid trackId, ChangeEventArgs args)
	{
		string? picked = args.Value?.ToString();
		return picked is null ? Task.CompletedTask : RouteStyles.SetRouteColourAsync(trackId, picked);
	}

	private Task ClearRouteColourAsync(Guid trackId) => RouteStyles.ClearRouteColourAsync(trackId);

	private Task ResetStyleAsync() => RouteStyles.ResetAsync();

	private static string FormatKm(double metres) => $"{metres / 1000:0.0} km";

	private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

	private Task ToggleSharingAsync(ChangeEventArgs args) =>
		_session.SetSharingAsync(args.Value is bool wants && wants);

	private Task EndRideAsync(RideEndingDto ending)
	{
		_showEndDialog = false;
		return _session.EndAsync(ending);
	}

	/// <summary>
	/// Leaves the ride (§5.2), then takes the rider to the list — the page they are on is about a
	/// ride they are no longer on, and the server would answer 404 to the next thing it asked for.
	/// <para>
	/// Confirmed first, through the app's one dialog rather than <c>window.confirm</c>: it is not
	/// undoable from this screen, and "Leave" is one tap from "Info" on a phone in a mount.
	/// </para>
	/// <para>
	/// A refused leave navigates nowhere. The session states what the server said, over the ride
	/// that is still perfectly readable underneath it.
	/// </para>
	/// </summary>
	private async Task LeaveRideAsync()
	{
		if (_session.Ride is not { } ride)
		{
			return;
		}

		bool confirmed = await Confirm.AskAsync(
			$"Leave {ride.Name}?",
			"Your sharing stops and the position this ride holds for you is deleted. "
			+ "Getting back on needs the join code or a new request.",
			confirmText: "Leave",
			danger: true);

		if (!confirmed || !await _session.LeaveRideAsync())
		{
			return;
		}

		// Before the navigation, so the rail is already right when the list renders: a globe still
		// pointing at the ride they just left would be the app disagreeing with itself.
		await CurrentRide.ForgetAsync(RideId);

		Nav.NavigateTo("/group-rides");
	}

	public async ValueTask DisposeAsync()
	{
		_session.Changed -= OnSessionChanged;
		RouteStyles.Changed -= OnSessionChanged;

		// Unsubscribed, never stopped: the receiver belongs to the device and outlives this page
		// for as long as a ride is being shared with (§4.3).
		Broadcast.Changed -= OnSessionChanged;

		await _session.DisposeAsync();
	}
}

<style>
	.ride-info .lead {
		margin: 0.5rem 0;
