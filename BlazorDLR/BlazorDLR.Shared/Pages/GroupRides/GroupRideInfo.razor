@page "/group-rides/{RideId:guid}/info"
@attribute [Authorize]
@using BlazorDLR.Shared.Components
@using DLR.Core.Contracts.Rides
@using DLR.Core.Contracts.Tracks
@inject IApiClient Api
@inject IRideHubClient Hub
@inject AuthState Auth
@inject NavigationManager Nav
@implements IAsyncDisposable

@*
	Everything about a group ride that is not the map (§5.1, §5.4, §5.6, §5.8) — who is
	on it, how far apart they are, the join code, this rider's sharing switch, and the
	organiser's lifecycle controls.

	These used to be a sidebar beside the live map. The map is now the whole screen, so
	they moved here and the map's hamburger points at them under "Info". The data behind
	both screens is the same RideSession: one snapshot, the same hub deltas on top (§5.3),
	so a state change made here is on the map before the rider gets back to it.

	Deliberately NOT here: the marker list, the "add marker" composer and the ride thread.
	Those are things you do while riding, and they stay one tap from the map.
*@

<PageTitle>@Title — Dumb Luck Routes</PageTitle>

<div class="page page-medium ride-info">
	<a class="back" href="/group-rides/@RideId">← Back to the map</a>

	@if (_session.Ride is null && _session.Error is null)
	{
		<p class="empty">Loading…</p>
	}
	else if (_session.Ride is not { } ride)
	{
		<p class="error">@_session.Error</p>
	}
	else
	{
		<div class="header">
			<h1>@ride.Name</h1>
			<span class="state @ride.State.ToString().ToLowerInvariant()">@ride.State</span>
		</div>

		<p class="lead">
			@(ride.Description ?? "")
		</p>

		@if (_session.Error is { } problem)
		{
			<p class="error">@problem</p>
		}

		@if (ride.IsOrganiser && ride.JoinCode is not null)
		{
			<div class="join-code">
				<strong>Join code:</strong> <span class="code">@ride.JoinCode</span>
				<em>Only you see this. Share it with the people you want on the ride.</em>
			</div>
		}

		@if (_session.WindDownEndsUtc is { } endsUtc)
		{
			<div class="wind-down" role="alert">
				<strong>Sharing wind-down active.</strong>
				Members who kept sharing on can carry on until they stop — or until
				<strong>@endsUtc.ToLocalTime().ToString("HH:mm")</strong>, when the server
				stops it for everyone still on.
			</div>
		}

		<div class="panels">
			<MemberList Members="ride.Members" />

			@*
				The ride's planned routes (§5.4). A set rather than one line, because a day out is
				commonly the short option and the long option, or the way out and the way home.
				Each row's swatch is the colour that route is drawn in on the map, so the list and
				the map name the same thing the same way.
			*@
			<div class="routes">
				<h3>Routes</h3>

				@if (_session.Routes.Count == 0)
				{
					<p class="hint">No route on this ride yet.</p>
				}
				else
				{
					<ul class="route-list">
						@for (int index = 0; index < _session.Routes.Count; index++)
						{
							RideRoute route = _session.Routes[index];

							<li>
								<span class="swatch" style="background: @RoutePalette.At(index)" aria-hidden="true"></span>
								<span class="what">
									<strong>@(route.Name ?? "Unnamed route")</strong>
									<em>
										@FormatKm(route.DistanceM)
										@if (index == 0 && _session.Routes.Count > 1)
										{
											@* §5.4 projects riders against one line, and it is this one. *@
											<span class="primary" title="Gaps and off-route warnings use this route">· gaps use this</span>
										}
									</em>
								</span>

								@if (_session.CanManageRoutes)
								{
									<button type="button" class="remove"
											@onclick="() => RemoveRouteAsync(route)"
											disabled="@_session.Busy"
											aria-label="@($"Remove {route.Name ?? "unnamed route"} from this ride")">
										Remove
									</button>
								}
							</li>
						}
					</ul>
				}

				@if (_session.CanManageRoutes)
				{
					@if (!_addingRoute)
					{
						<button type="button" class="primary" @onclick="OpenRoutePickerAsync" disabled="@_session.Busy">
							Add a route…
						</button>
					}
					else
					{
						<div class="route-picker">
							@* The error is tested first: a failed fetch leaves _tracks null so that
							   re-opening the picker tries again, which means "still null" and
							   "could not be fetched" would otherwise look the same. *@
							@if (_tracksError is { } trouble)
							{
								<p class="error">@trouble</p>
							}
							else if (_tracks is null)
							{
								<p class="hint">Loading your tracks…</p>
							}
							else if (Attachable.Count == 0)
							{
								@*
									Only the caller's own tracks can be attached (§15.4) — a route
									somebody sent you is added by importing the GPX they sent, which
									is the copy feature and needs no endpoint of its own.
								*@
								<p class="hint">
									Nothing left to add. Routes come from your own tracks —
									<a href="/import">import a GPX</a> or record a ride first.
								</p>
							}
							else
							{
								<ul class="track-list">
									@foreach (TrackSummary track in Attachable)
									{
										<li>
											<button type="button" @onclick="() => AddRouteAsync(track)"
													disabled="@_session.Busy">
												<strong>@(track.Name ?? "Unnamed track")</strong>
												<em>@FormatKm(track.DistanceM)</em>
											</button>
										</li>
									}
								</ul>
							}

							<button type="button" class="cancel" @onclick="CloseRoutePicker">Cancel</button>
						</div>
					}
				}
			</div>

			@if (ride.State == RideStateDto.Live)
			{
				<GapList Route="_session.RoutePolyline" Positions="_session.Positions" />
			}

			@if (ride.State == RideStateDto.Live || ride.State == RideStateDto.Open)
			{
				<div class="sharing">
					<h3>My sharing</h3>
					<label class="switch">
						<input type="checkbox" checked="@_session.Sharing" @onchange="ToggleSharingAsync"
							   disabled="@_session.Busy" />
						Broadcast my location to this ride
					</label>
					<p class="hint">
						You can turn this off at any moment. Turning it off deletes the
						stored fix — merely stopping the broadcast would leave a last-known
						point on the map.
					</p>
				</div>
			}

			@if (ride.IsOrganiser)
			{
				<div class="organiser">
					<h3>Organiser</h3>
					<a href="/group-rides/@RideId/requests">Join requests</a>
					<a href="/group-rides/@RideId/permissions">Content permissions</a>

					@if (ride.State == RideStateDto.Open)
					{
						<button type="button" class="primary" @onclick="_session.StartAsync" disabled="@_session.Busy">
							Start ride
						</button>
					}
					@if (ride.State == RideStateDto.Live)
					{
						<button type="button" class="primary" @onclick="() => _showEndDialog = true"
								disabled="@_session.Busy">
							End ride…
						</button>
					}
				</div>
			}
		</div>

		@if (_showEndDialog)
		{
			<div class="end-dialog" role="dialog">
				<div class="end-card">
					<h2>End @ride.Name?</h2>
					<p>Choose what happens to everyone's sharing.</p>
					<button type="button" class="primary" @onclick="() => EndRideAsync(RideEndingDto.Immediate)"
							disabled="@_session.Busy">
						Stop sharing for everyone now
					</button>
					<button type="button" class="primary" @onclick="() => EndRideAsync(RideEndingDto.WindDown)"
							disabled="@_session.Busy">
						Let riders stop themselves (2-hour wind-down)
					</button>
					<button type="button" class="cancel" @onclick="() => _showEndDialog = false">
						Cancel
					</button>
					<p class="note">
						The wind-down is capped, cannot be extended, and force-stops on the
						server. A rider who forgets is not tracked forever.
					</p>
				</div>
			</div>
		}
	}
</div>

@code {
	[Parameter] public Guid RideId { get; set; }

	private RideSession _session = default!;
	private bool _showEndDialog;

	/// <summary>Whether the "add a route" picker is open.</summary>
	private bool _addingRoute;

	/// <summary>
	/// The caller's own tracks, fetched when the picker is first opened rather than on load.
	/// Most visits to this page never attach anything, and the list is only useful to the two
	/// people who may.
	/// </summary>
	private IReadOnlyList<TrackSummary>? _tracks;

	private string? _tracksError;

	private string Title => _session?.Ride?.Name ?? "Ride";

	/// <summary>
	/// The tracks that could still be added: the caller's own, minus the ones already on the ride.
	/// Filtered here rather than server-side because the server's list endpoint is the ordinary
	/// track list and has no business knowing about this screen.
	/// </summary>
	private IReadOnlyList<TrackSummary> Attachable
	{
		get
		{
			if (_tracks is null)
			{
				return [];
			}

			HashSet<Guid> attached = [.. _session.Routes.Select(route => route.TrackId)];

			return [.. _tracks.Where(track => !attached.Contains(track.Id))];
		}
	}

	protected override void OnInitialized()
	{
		_session = new RideSession(Api, Hub, Auth);
		_session.Changed += OnSessionChanged;
	}

	protected override async Task OnParametersSetAsync()
	{
		if (_session.RideId == RideId)
		{
			return;
		}

		_showEndDialog = false;
		CloseRoutePicker();

		// Cleared rather than kept: a different ride is a different set of already-attached
		// tracks, and a stale list would offer one that is on this ride already.
		_tracks = null;
		_tracksError = null;

		await _session.LoadAsync(RideId);
	}

	// -- Routes (§5.4) ------------------------------------------------------------------------

	private async Task OpenRoutePickerAsync()
	{
		_addingRoute = true;

		if (_tracks is not null)
		{
			return;
		}

		// Cleared before the retry, so a second attempt that succeeds does not leave the previous
		// failure showing above the list it contradicts.
		_tracksError = null;

		try
		{
			_tracks = await Api.ListTracksAsync();
		}
		catch (ApiException apiException)
		{
			// Stated where the picker is, not over the whole page: the rest of the ride is fine,
			// and the next tap of "Add a route…" tries again.
			_tracksError = apiException.Error.Title;
		}
		catch (Exception exception)
		{
			_tracksError = exception.Message;
		}
	}

	private void CloseRoutePicker() => _addingRoute = false;

	private async Task AddRouteAsync(TrackSummary track)
	{
		await _session.AddRouteAsync(track.Id);

		// Left open on failure so the stated error sits next to the list it came from.
		if (_session.Error is null)
		{
			CloseRoutePicker();
		}
	}

	private Task RemoveRouteAsync(RideRoute route) => _session.RemoveRouteAsync(route.TrackId);

	private static string FormatKm(double metres) => $"{metres / 1000:0.0} km";

	private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

	private Task ToggleSharingAsync(ChangeEventArgs args) =>
		_session.SetSharingAsync(args.Value is bool wants && wants);

	private Task EndRideAsync(RideEndingDto ending)
	{
		_showEndDialog = false;
		return _session.EndAsync(ending);
	}

	public async ValueTask DisposeAsync()
	{
		_session.Changed -= OnSessionChanged;
		await _session.DisposeAsync();
	}
}

<style>
	.ride-info .lead {
		margin: 0.5rem 0;
	}

	.ride-info .state {
		font-size: 0.85rem;
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		background: #eef1f520;
	}

		.ride-info .state.open {
			background: #dbeafe;
			color: #1e40af;
		}

		.ride-info .state.live {
			background: #d1fae5;
			color: #14532d;
		}

		.ride-info .state.completed, .ride-info .state.archived {
			background: #fef3c730;
			color: #92400e;
		}

	.ride-info .join-code {
		margin: 0.75rem 0;
		padding: 0.5rem 0.75rem;
		background: #eff6ff20;
		border: 1px solid #bfdbfe;
		border-radius: 4px;
		font-size: 0.9rem;
	}

		.ride-info .join-code .code {
			font-family: ui-monospace, monospace;
			font-weight: bold;
			letter-spacing: 0.15em;
		}

		.ride-info .join-code em {
			display: block;
			opacity: 0.7;
			margin-top: 0.25rem;
			font-size: 0.85rem;
		}

	.ride-info .wind-down {
		margin: 0.75rem 0;
		padding: 0.75rem 1rem;
		background: #fef3c730;
		border: 1px solid #fde68a;
		border-radius: 4px;
	}

	/* One column of panels. The sidebar this replaced was 20 rem wide because a map sat
	   beside it; with the whole column to itself the same panels simply stack. */
	.ride-info .panels {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 1rem;
	}

		.ride-info .panels h3 {
			margin: 0 0 0.5rem;
			font-size: 1rem;
		}

	.ride-info .sharing, .ride-info .organiser, .ride-info .routes {
		padding: 0.75rem;
		background: #fff2;
		border-radius: 6px;
	}

	.ride-info .route-list, .ride-info .track-list {
		list-style: none;
		margin: 0 0 0.5rem;
		padding: 0;
	}

	.ride-info .route-list li {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.35rem 0;
	}

		.ride-info .route-list li + li {
			border-top: 1px solid #ffffff1f;
		}

	/* The colour this route is drawn in on the map, so the list and the map agree. */
	.ride-info .route-list .swatch {
		flex: 0 0 auto;
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 3px;
		border: 1px solid #0006;
	}

	.ride-info .route-list .what {
		flex: 1;
		min-width: 0;
	}

		/* A track name is whatever a GPX file called it, which can be very long. */
		.ride-info .route-list .what strong {
			display: block;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.ride-info .route-list .what em {
			font-size: 0.85rem;
			opacity: 0.75;
		}

		.ride-info .route-list .what .primary {
			margin-left: 0.35rem;
		}

	.ride-info .route-list .remove {
		flex: 0 0 auto;
		padding: 0.25rem 0.6rem;
		background: transparent;
		border: 1px solid var(--dlr-border, #ffffff33);
		border-radius: 4px;
		color: inherit;
		font: inherit;
		cursor: pointer;
	}

		.ride-info .route-list .remove:disabled {
			opacity: 0.6;
			cursor: default;
		}

	.ride-info .routes > button {
		padding: 0.4rem 0.8rem;
	}

	.ride-info .track-list li + li {
		border-top: 1px solid #ffffff1f;
	}

	/* The whole row picks the track, so it is a button that has to read as a list row. */
	.ride-info .track-list button {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		width: 100%;
		padding: 0.45rem 0;
		background: transparent;
		border: 0;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

		.ride-info .track-list button strong {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.ride-info .track-list button em {
			flex: 0 0 auto;
			font-size: 0.85rem;
			opacity: 0.75;
		}

	.ride-info .route-picker .cancel {
		padding: 0.35rem 0.7rem;
		background: transparent;
		border: 0;
		color: inherit;
		font: inherit;
		cursor: pointer;
	}

	.ride-info .organiser a {
		display: block;
		margin: 0.25rem 0;
	}

	.ride-info .organiser button {
		margin-top: 0.5rem;
		padding: 0.4rem 0.8rem;
	}

	.ride-info .end-dialog {
		position: fixed;
		inset: 0;
		background: rgba(0,0,0,0.5);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 1000;
	}

	.ride-info .end-card {
		background: white;
		padding: 1.5rem;
		border-radius: 8px;
		max-width: 32rem;
		width: calc(100vw - 2rem);
	}

		.ride-info .end-card button {
			display: block;
			width: 100%;
			margin-top: 0.5rem;
			padding: 0.6rem 1rem;
		}

			.ride-info .end-card button.cancel {
				background: transparent;
			}

		.ride-info .end-card .note {
			margin-top: 0.75rem;
		}
</style>
