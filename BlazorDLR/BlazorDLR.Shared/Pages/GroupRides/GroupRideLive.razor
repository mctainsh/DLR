@page "/group-rides/{RideId:guid}"
@attribute [Authorize]
@using BlazorDLR.Shared.Components
@using BlazorDLR.Shared.Markers
@using DLR.Core.Contracts.Markers
@using DLR.Core.Contracts.Rides
@using DLR.Core.Contracts.Tracks
@using DLR.Core.Tracks
@inject IApiClient Api
@inject IRideHubClient Hub
@inject AuthState Auth
@inject ConfirmService Confirm
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>@Title — Dumb Luck Routes</PageTitle>

<div class="page page-wide live">
	@if (_ride is null && _error is null)
	{
		<p class="empty">Loading…</p>
	}
	else if (_error is not null)
	{
		<p class="error">@_error</p>
	}
	else if (_ride is not null)
	{
		<div class="header">
			<h1>@_ride.Name</h1>
			<span class="state @_ride.State.ToString().ToLowerInvariant()">@_ride.State</span>
		</div>

		<p class="lead">
			@(_ride.Description ?? "")
		</p>

		@if (_ride.IsOrganiser && _ride.JoinCode is not null)
		{
			<div class="join-code">
				<strong>Join code:</strong> <span class="code">@_ride.JoinCode</span>
				<em>Only you see this. Share it with the people you want on the ride.</em>
			</div>
		}

		@if (_windDownEndsUtc is { } endsUtc)
		{
			<div class="wind-down" role="alert">
				<strong>Sharing wind-down active.</strong>
				Members who kept sharing on can carry on until they stop — or until
				<strong>@endsUtc.ToLocalTime().ToString("HH:mm")</strong>, when the server
				stops it for everyone still on.
			</div>
		}

		<div class="grid">
			<div class="map-panel">
				<RideMap @ref="_map" Camera="_camera" Markers="_markerLayer" ShowUserLocation="false"
						 OnViewportReported="OnMapViewportReported"
						 OnMapClicked="OnMapTappedAsync" ShowPickingCursor="false" />
			</div>

			<aside class="side">
				<MemberList Members="_ride.Members" />

				@if (_ride.State == RideStateDto.Live)
				{
					<GapList Route="_routePolyline" Positions="_positions" />
				}

				@if (_ride.State == RideStateDto.Live || _ride.State == RideStateDto.Open)
				{
					<div class="sharing">
						<h3>My sharing</h3>
						<label class="switch">
							<input type="checkbox" checked="@_sharing" @onchange="ToggleSharingAsync" disabled="@_busy" />
							Broadcast my location to this ride
						</label>
						<p class="hint">
							You can turn this off at any moment. Turning it off deletes the
							stored fix — merely stopping the broadcast would leave a last-known
							point on the map.
						</p>
					</div>
				}

				<div class="thread-link">
					<a href="/group-rides/@RideId/thread">Ride thread</a>
					@if (_ride.Permissions.AllowMemberMarkers || _ride.IsOrganiser)
					{
						<a href="/group-rides/@RideId/markers/new" @onclick="GoToComposer" @onclick:preventDefault="true">Add marker</a>
					}
					@if (_ride.State == RideStateDto.Live)
					{
						<span class="quiet">— quiet while the ride is live</span>
					}
				</div>

				@*
					The map's pins carry an icon and a title and nothing else — the Skia overlay
					is `pointer-events: none` so gestures reach the base map (RideMap), which
					means a pin cannot be tapped for its detail. This list is where a marker's
					note, its photo and its delete live (§16.4, §16.5).
				*@
				<div class="markers">
					<h3>Markers</h3>

					@if (_markers.Count == 0)
					{
						<p class="hint">Nothing marked on this ride yet.</p>
					}
					else
					{
						<ul class="marker-list">
							@foreach (MarkerDto marker in OrderedMarkers)
							{
								bool open = _openMarkerId == marker.Id;

								<li class="@(open ? "open" : null)">
									<button type="button" class="marker-head"
											aria-expanded="@(open ? "true" : "false")"
											@onclick="() => ToggleMarkerAsync(marker)">
										<span class="glyph" aria-hidden="true">@MarkerIconGlyphs.Emoji(marker.Icon)</span>
										<span class="what">
											<strong>@marker.Title</strong>
											<em>@marker.CreatedByUserName</em>
										</span>
										<span class="badges">
											@if (!string.IsNullOrWhiteSpace(marker.Note))
											{
												<span title="Has a note">📝</span>
											}
											@if (marker.PhotoId is not null)
											{
												<span title="Has a photo">📷</span>
											}
										</span>
									</button>

									@if (open)
									{
										<MarkerDetails Marker="marker" CanDelete="CanDelete(marker)"
													   Deleting="_deletingMarkerId == marker.Id"
													   OnDelete="DeleteMarkerAsync" />
									}
								</li>
							}
						</ul>
					}
				</div>

				@if (_ride.IsOrganiser)
				{
					<div class="organiser">
						<h3>Organiser</h3>
						<a href="/group-rides/@RideId/requests">Join requests</a>
						<a href="/group-rides/@RideId/permissions">Content permissions</a>

						@if (_ride.State == RideStateDto.Open)
						{
							<button type="button" class="primary" @onclick="StartRideAsync" disabled="@_busy">Start ride</button>
						}
						@if (_ride.State == RideStateDto.Live)
						{
							<button type="button" class="primary" @onclick="() => _showEndDialog = true" disabled="@_busy">
								End ride…
							</button>
						}
					</div>
				}

				@if (_showConsent)
				{
					<ConsentPrompt RideName="@_ride.Name"
								   OnShare="OnConsentShareAsync"
								   OnDismiss="OnConsentDismissAsync" />
				}

				@if (NearbyMarkers is { Count: > 0 } nearby)
				{
					<div class="nearby-dialog" role="dialog" aria-modal="true" aria-label="Markers near that point"
						 @onclick="CloseNearby">
						<div class="nearby-card" @onclick:stopPropagation="true">
							<header>
								<h2>
									@(nearby.Count == 1 ? "1 marker here" : $"{nearby.Count} markers here")
								</h2>
								<button type="button" class="close" @onclick="CloseNearby" aria-label="Close">×</button>
							</header>

							@foreach (MarkerDto marker in nearby)
							{
								<section class="nearby-marker">
									<h3>
										<span class="glyph" aria-hidden="true">@MarkerIconGlyphs.Emoji(marker.Icon)</span>
										@marker.Title
									</h3>
									<p class="by">@marker.CreatedByUserName</p>

									<MarkerDetails Marker="marker" CanDelete="CanDelete(marker)"
												   Deleting="_deletingMarkerId == marker.Id"
												   OnDelete="DeleteMarkerAsync" />
								</section>
							}
						</div>
					</div>
				}

				@if (_showEndDialog)
				{
					<div class="end-dialog" role="dialog">
						<div class="end-card">
							<h2>End @_ride.Name?</h2>
							<p>Choose what happens to everyone's sharing.</p>
							<button type="button" class="primary" @onclick="() => EndRideAsync(RideEndingDto.Immediate)"
									disabled="@_busy">
								Stop sharing for everyone now
							</button>
							<button type="button" class="primary" @onclick="() => EndRideAsync(RideEndingDto.WindDown)"
									disabled="@_busy">
								Let riders stop themselves (2-hour wind-down)
							</button>
							<button type="button" class="cancel" @onclick="() => _showEndDialog = false">
								Cancel
							</button>
							<p class="note">
								The wind-down is capped, cannot be extended, and force-stops on the
								server. A rider who forgets is not tracked forever.
							</p>
						</div>
					</div>
				}
			</aside>
		</div>
	}
</div>

@code {
	[Parameter] public Guid RideId { get; set; }

	private RideDetail? _ride;
	private string? _error;
	private MapCamera _camera = new(-33.868, 151.209, 11);
	private MapViewport? _mapViewport;
	private readonly Dictionary<Guid, MapMarker> _markerLayer = new();
	private readonly Dictionary<Guid, MarkerDto> _markers = new();
	private readonly Dictionary<Guid, RiderPositionDto> _positions = new();

	// The planned route's raw points, when the ride has one. §5.4's gap list needs a
	// route to project against; today the hub tells us via RouteUpdated when the route
	// changes but the initial RideDetail does not carry the route id, so the initial
	// load path shows an empty GapList until the route arrives on the hub — see
	// SharedFrontend.md Phase 3 for the deferred server change that would let the
	// initial fetch populate this immediately.
	private IReadOnlyList<TrackPoint>? _routePolyline;
	private DateTimeOffset? _windDownEndsUtc;
	private bool _sharing;
	private bool _showConsent;
	private bool _showEndDialog;
	private bool _busy;

	/// <summary>Which marker's detail is expanded, or null when the list is all collapsed.</summary>
	private Guid? _openMarkerId;

	/// <summary>
	/// The markers a tap on the map landed on, nearest first — identified by id rather than
	/// held as DTOs so the popup follows <see cref="_markers"/>. An edit arriving on the hub
	/// updates what is on screen, and a marker deleted underneath simply drops out; keeping
	/// copies would leave the popup showing a marker nobody else can see any more.
	/// </summary>
	private IReadOnlyList<Guid> _nearbyMarkerIds = Array.Empty<Guid>();

	private RideMap? _map;

	/// <summary>
	/// The marker whose delete is in flight. Deliberately not <see cref="_busy"/>: that one
	/// disables the sharing switch and the organiser's lifecycle buttons, and none of those
	/// have anything to do with removing a pin.
	/// </summary>
	private Guid? _deletingMarkerId;

	private string Title => _ride?.Name ?? "Ride";

	/// <summary>
	/// Oldest first, which is the order the list endpoint returns (§16.5). Sorting on read
	/// rather than keeping a parallel list means a marker arriving on the hub lands in the
	/// same place it would have on a reload, and an edit never shuffles the rows underneath
	/// the person reading them.
	/// </summary>
	private IEnumerable<MarkerDto> OrderedMarkers =>
		_markers.Values.OrderBy(marker => marker.CreatedUtc);

	/// <summary>
	/// The markers the last tap landed on, resolved against the live set. Null when nothing
	/// was tapped, so the popup is simply absent rather than an empty card.
	/// </summary>
	private IReadOnlyList<MarkerDto>? NearbyMarkers
	{
		get
		{
			if (_nearbyMarkerIds.Count == 0)
			{
				return null;
			}

			List<MarkerDto> found = new(_nearbyMarkerIds.Count);
			foreach (Guid id in _nearbyMarkerIds)
			{
				if (_markers.TryGetValue(id, out MarkerDto? marker))
				{
					found.Add(marker);
				}
			}

			return found.Count == 0 ? null : found;
		}
	}

	/// <summary>Zoom a marker is brought to when it is chosen. Street level, not suburb level.</summary>
	private const double FocusZoom = 16;

	/// <summary>
	/// A tap on the base map lists every marker near that point (§16.4). The arithmetic is
	/// <see cref="MarkerHitTest"/>'s; this decides what to do with the answer.
	/// </summary>
	private async Task OnMapTappedAsync(MapClick click)
	{
		// A tap arriving before the map has reported a frame has nothing to hit-test against.
		if (_mapViewport is not { } viewport)
		{
			return;
		}

		_nearbyMarkerIds = [.. MarkerHitTest.Near(viewport, _markers.Values, click).Select(marker => marker.Id)];

		await InvokeAsync(StateHasChanged);
	}

	private void CloseNearby() => _nearbyMarkerIds = Array.Empty<Guid>();

	/// <summary>
	/// Expands a row and brings the map to it. Collapsing leaves the camera alone — somebody
	/// closing a panel is done reading, not asking to be taken somewhere.
	/// </summary>
	private async Task ToggleMarkerAsync(MarkerDto marker)
	{
		if (_openMarkerId == marker.Id)
		{
			_openMarkerId = null;
			return;
		}

		_openMarkerId = marker.Id;
		await FocusAsync(marker);
	}

	/// <summary>
	/// Centres the map on a marker and zooms in, without zooming <em>out</em> on somebody who
	/// is already closer than <see cref="FocusZoom"/> — pulling the view back would throw away
	/// detail they had chosen.
	/// <para>
	/// Driven through the component rather than by assigning <c>_camera</c>: a parameter only
	/// moves the map when its value differs from the last one applied, so choosing the same
	/// marker twice — the obvious thing to do after panning away — would do nothing at all
	/// the second time.
	/// </para>
	/// </summary>
	private async Task FocusAsync(MarkerDto marker)
	{
		if (_map is null)
		{
			return;
		}

		double zoom = Math.Max(_mapViewport?.ZoomLevel ?? FocusZoom, FocusZoom);

		_camera = new MapCamera(
			PositionScale.ToDegrees(marker.Lat),
			PositionScale.ToDegrees(marker.Lon),
			zoom);

		try
		{
			await _map.SetCameraAsync(_camera);
		}
		catch
		{
			// A base map that failed to attach shows its own stated error (§4.5). Refusing to
			// move a camera that does not exist is not worth a second error over the top.
		}
	}

	/// <summary>
	/// Who may remove a marker: the rider who placed it, or the ride's organiser (§16.5).
	/// Mirrors <c>MarkerController.CanWriteAsync</c> so the button is simply absent rather
	/// than there and 403-ing — the server stays the one that decides either way.
	/// </summary>
	private bool CanDelete(MarkerDto marker) =>
		marker.CreatedByUserId == Auth.UserId || _ride?.IsOrganiser == true;

	private async Task DeleteMarkerAsync(MarkerDto marker)
	{
		bool ok = await Confirm.AskAsync(
			"Delete marker?",
			$"“{marker.Title}” disappears from everyone's map. This cannot be undone.",
			confirmText: "Delete",
			danger: true);

		if (!ok) return;

		_deletingMarkerId = marker.Id;
		try
		{
			await Api.DeleteMarkerAsync(marker.Id);

			// The server broadcasts MarkerRemoved to the ride group and OnMarkerRemoved would
			// do exactly this — but only for a client whose hub connection came up. §5.3's rule
			// is that the snapshot is authoritative and the hub is the delta on top, so the
			// caller drops its own copy too. Both paths are one dictionary remove and are happy
			// to run one after the other.
			_markers.Remove(marker.Id);
			if (_openMarkerId == marker.Id)
			{
				_openMarkerId = null;
			}
			RebuildMapLayer();
		}
		catch (ApiException apiException) { _error = apiException.Error.Title; }
		finally { _deletingMarkerId = null; }
	}

	/// <summary>
	/// Opens the marker composer on the view the rider is actually looking at, so the picker
	/// starts on the same ground rather than on a default somewhere else entirely (§16.1).
	/// <para>
	/// Built at click time, not baked into the <c>href</c>. Keeping an href current would
	/// mean re-rendering this page on every pan — and a render here re-runs
	/// <see cref="GapList"/>'s projection for every rider against the whole route polyline,
	/// which is the most expensive thing on the screen. Nobody needs a fresh URL until the
	/// moment they click.
	/// </para>
	/// </summary>
	private void GoToComposer()
	{
		string composer = $"/group-rides/{RideId}/markers/new";

		if (_mapViewport is not { CanvasWidthPx: > 0 } vp)
		{
			// No viewport yet: the composer's own ride-centred fallback takes over.
			Nav.NavigateTo(composer);
			return;
		}

		// GetUriWithQueryParameters handles invariant formatting and escaping, and survives a
		// route rename better than string concatenation.
		Nav.NavigateTo(Nav.GetUriWithQueryParameters(composer, new Dictionary<string, object?>
		{
			["lat"] = Math.Round(vp.CentreLatitude, 5),
			["lon"] = Math.Round(vp.CentreLongitude, 5),
			["zoom"] = Math.Round(vp.ZoomLevel, 2),
		}));
	}

	// Pure field assignment: nothing on screen depends on it until GoToComposer reads it.
	private void OnMapViewportReported(MapViewport viewport) => _mapViewport = viewport;

	protected override async Task OnParametersSetAsync()
	{
		_ride = null;
		_error = null;
		_markerLayer.Clear();
		_markers.Clear();
		_positions.Clear();
		_openMarkerId = null;
		_nearbyMarkerIds = Array.Empty<Guid>();
		_windDownEndsUtc = null;

		WireHub();

		try
		{
			_ride = await Api.GetRideAsync(RideId);
			_sharing = _ride.Members.FirstOrDefault(m => m.UserId == Auth.UserId)?.Sharing ?? false;

			// Positions snapshot: on load we ask for what everyone's fix is now (§5.3).
			IReadOnlyList<RiderPositionDto> snapshot = await Api.GetPositionsSnapshotAsync(RideId);
			foreach (RiderPositionDto position in snapshot)
			{
				_positions[position.UserId] = position;
			}

			// Markers snapshot.
			foreach (MarkerDto marker in await Api.ListRideMarkersAsync(RideId))
			{
				_markers[marker.Id] = marker;
			}

			RebuildMapLayer();

			// Consent prompt: shown once per joined ride that we do not yet share with.
			// §5.6's rule is dismissing = "not now", which is a no-op — closing the modal
			// simply removes it.
			if (!_sharing && _ride.State == RideStateDto.Open)
			{
				_showConsent = true;
			}

			try
			{
				await Hub.ConnectAsync();
				await Hub.JoinRideAsync(RideId);
			}
			catch
			{
				// The realtime updates are a nice-to-have on top of the snapshot; if the hub
				// is unreachable the page still shows what the API returned. §5.3 sets the
				// shape: the snapshot is authoritative, the hub is the delta on top.
			}
		}
		catch (ApiException apiException)
		{
			_error = apiException.Error.Title;
		}
		catch (Exception exception)
		{
			_error = exception.Message;
		}
	}

	private void WireHub()
	{
		Hub.PositionsUpdated += OnPositions;
		Hub.MemberJoined += OnMemberJoined;
		Hub.MemberLeft += OnMemberLeft;
		Hub.MemberSharingChanged += OnMemberSharing;
		Hub.MarkerAdded += OnMarkerAdded;
		Hub.MarkerUpdated += OnMarkerAdded; // same treatment — upsert
		Hub.MarkerRemoved += OnMarkerRemoved;
		Hub.RouteUpdated += OnRouteUpdated;
		Hub.RideStateChanged += OnRideStateChanged;
		Hub.SharingWindDownStarted += OnWindDownStarted;
		Hub.PermissionsChanged += OnPermissionsChanged;
	}

	private void OnPositions(PositionBatch batch)
	{
		if (batch.RideId != RideId) return;
		foreach (PositionFix fix in batch.Positions)
		{
			_positions[fix.UserId] = new RiderPositionDto(
				fix.UserId,
				_positions.TryGetValue(fix.UserId, out var existing) ? existing.UserName : string.Empty,
				fix.Lat, fix.Lon, fix.SpeedMps, fix.HeadingDeg, fix.RecordedUtc);
		}
		RebuildMapLayer();
		_ = InvokeAsync(StateHasChanged);
	}

	private void OnMemberJoined(Guid rideId, RideMemberSummary member)
	{
		if (rideId != RideId || _ride is null) return;
		_ride = _ride with { Members = _ride.Members.Concat(new[] { member }).ToList() };
		_ = InvokeAsync(StateHasChanged);
	}

	private void OnMemberLeft(Guid rideId, Guid userId)
	{
		if (rideId != RideId || _ride is null) return;
		_ride = _ride with { Members = _ride.Members.Where(m => m.UserId != userId).ToList() };
		_positions.Remove(userId);
		RebuildMapLayer();
		_ = InvokeAsync(StateHasChanged);
	}

	private void OnMemberSharing(Guid rideId, Guid userId, bool sharing)
	{
		if (rideId != RideId || _ride is null) return;
		_ride = _ride with
		{
			Members = _ride.Members.Select(m =>
				m.UserId == userId ? m with { Sharing = sharing } : m).ToList()
		};
		if (!sharing)
		{
			_positions.Remove(userId);
			RebuildMapLayer();
		}
		_ = InvokeAsync(StateHasChanged);
	}

	private void OnMarkerAdded(Guid rideId, MarkerDto marker)
	{
		if (rideId != RideId) return;
		_markers[marker.Id] = marker;
		RebuildMapLayer();
		_ = InvokeAsync(StateHasChanged);
	}

	private void OnMarkerRemoved(Guid rideId, Guid markerId)
	{
		if (rideId != RideId) return;
		_markers.Remove(markerId);
		// Somebody else's delete can land while its detail is open on this screen. Collapsing
		// it is the honest response — the alternative is an expanded panel describing a marker
		// that no longer exists.
		if (_openMarkerId == markerId)
		{
			_openMarkerId = null;
		}
		RebuildMapLayer();
		_ = InvokeAsync(StateHasChanged);
	}

	private void OnRideStateChanged(Guid rideId, RideStateDto state)
	{
		if (rideId != RideId || _ride is null) return;
		_ride = _ride with { State = state };
		_ = InvokeAsync(StateHasChanged);
	}

	private async void OnRouteUpdated(Guid rideId, Guid trackId)
	{
		if (rideId != RideId) return;

		try
		{
			// The polyline the server hands us here is simplified for display, and that
			// is fine for the gap list — GapCalculator's error against a simplified line
			// is bounded by the simplifier's tolerance (§15.5), which is well below the
			// off-route threshold. Trading a full-resolution fetch for a lighter request
			// is a good deal when the alternative is nothing at all.
			TrackDetail detail = await Api.GetTrackAsync(trackId);
			_routePolyline = detail.Polyline;
			await InvokeAsync(StateHasChanged);
		}
		catch
		{
			// A route the client cannot fetch is treated the same as no route: gap list
			// stays empty rather than showing wrong numbers. A retry happens automatically
			// on the next RouteUpdated event.
			_routePolyline = null;
		}
	}

	private void OnWindDownStarted(Guid rideId, DateTimeOffset endsUtc)
	{
		if (rideId != RideId) return;
		_windDownEndsUtc = endsUtc;
		_ = InvokeAsync(StateHasChanged);
	}

	private void OnPermissionsChanged(Guid rideId, RidePermissions permissions)
	{
		if (rideId != RideId || _ride is null) return;
		_ride = _ride with { Permissions = permissions };
		_ = InvokeAsync(StateHasChanged);
	}

	/// <summary>
	/// Positions + markers merge into one Skia layer. Both draw as pins today; a Phase 3
	/// pass gives markers their icon-key visuals (§16.3) — the shape is the same either way.
	/// </summary>
	private void RebuildMapLayer()
	{
		_markerLayer.Clear();
		foreach (RiderPositionDto position in _positions.Values)
		{
			_markerLayer[position.UserId] = new MapMarker(
				Id: position.UserId,
				Latitude: PositionScale.ToDegrees(position.Lat),
				Longitude: PositionScale.ToDegrees(position.Lon),
				IconKey: string.Empty,
				Title: string.IsNullOrEmpty(position.UserName) ? "?" : position.UserName,
				DirectionDeg: position.HeadingDeg,
				Kind: MarkerKind.Rider);
		}
		foreach (MarkerDto marker in _markers.Values)
		{
			_markerLayer[marker.Id] = new MapMarker(
				Id: marker.Id,
				Latitude: PositionScale.ToDegrees(marker.Lat),
				Longitude: PositionScale.ToDegrees(marker.Lon),
				IconKey: marker.Icon,
				Title: marker.Title,
				DirectionDeg: marker.DirectionDeg);
		}
	}

	private async Task OnConsentShareAsync()
	{
		_showConsent = false;
		_busy = true;
		try
		{
			await Api.SetSharingAsync(RideId, new SetSharingRequest(true));
			_sharing = true;
		}
		catch (ApiException apiException) { _error = apiException.Error.Title; }
		finally { _busy = false; }
	}

	private Task OnConsentDismissAsync()
	{
		_showConsent = false;
		return Task.CompletedTask;
	}

	private async Task ToggleSharingAsync(ChangeEventArgs args)
	{
		bool wants = args.Value is bool b && b;
		_busy = true;
		try
		{
			await Api.SetSharingAsync(RideId, new SetSharingRequest(wants));
			_sharing = wants;
		}
		catch (ApiException apiException) { _error = apiException.Error.Title; }
		finally { _busy = false; }
	}

	private async Task StartRideAsync()
	{
		_busy = true;
		try
		{
			await Api.StartRideAsync(RideId);
		}
		catch (ApiException apiException) { _error = apiException.Error.Title; }
		finally { _busy = false; }
	}

	private async Task EndRideAsync(RideEndingDto ending)
	{
		_busy = true;
		_showEndDialog = false;
		try
		{
			await Api.EndRideAsync(RideId, new EndRideRequest(ending));
		}
		catch (ApiException apiException) { _error = apiException.Error.Title; }
		finally { _busy = false; }
	}

	public async ValueTask DisposeAsync()
	{
		Hub.PositionsUpdated -= OnPositions;
		Hub.MemberJoined -= OnMemberJoined;
		Hub.MemberLeft -= OnMemberLeft;
		Hub.MemberSharingChanged -= OnMemberSharing;
		Hub.MarkerAdded -= OnMarkerAdded;
		Hub.MarkerUpdated -= OnMarkerAdded;
		Hub.MarkerRemoved -= OnMarkerRemoved;
		Hub.RouteUpdated -= OnRouteUpdated;
		Hub.RideStateChanged -= OnRideStateChanged;
		Hub.SharingWindDownStarted -= OnWindDownStarted;
		Hub.PermissionsChanged -= OnPermissionsChanged;

		try { await Hub.LeaveRideAsync(RideId); }
		catch { /* connection may already be down */ }
	}
}

