@page "/group-rides/{RideId:guid}"
@attribute [Authorize]
@using BlazorDLR.Shared.Components
@using BlazorDLR.Shared.Markers
@using DLR.Core.Contracts.Markers
@using DLR.Core.Contracts.Rides
@inject IApiClient Api
@inject IRideHubClient Hub
@inject AuthState Auth
@inject ConfirmService Confirm
@inject NavigationManager Nav
@inject PrivateAreaState PrivateAreas
@inject IDeviceSettings Settings
@inject TimeProvider Clock
@implements IAsyncDisposable

@*
	The live ride (§5.3). The map IS the page: it fills everything the nav rail is not
	using, and every other affordance is reached from the hamburger in the top-right.

	Why a hamburger here and nowhere else. NavMenu.razor states the app-wide rule — the
	rail never collapses behind a toggle, because hiding *navigation* is hiding the app.
	This menu hides no destination: the rail is still on screen next to it. It holds this
	one screen's *actions*, which is what a screen with no room for a toolbar does.

	Everything that reads rather than acts — who is on the ride, the gaps, the join code,
	the sharing switch, the organiser's controls — lives on GroupRideInfo, one tap away
	under "Info". A rider looking at a live map wants the map.
*@

<PageTitle>@Title — Dumb Luck Routes</PageTitle>

<div class="page-full live">
	@if (_session.Ride is null && _session.Error is null)
	{
		<p class="empty">Loading…</p>
	}
	else if (_session.Ride is not { } ride)
	{
		<p class="error">@_session.Error</p>
	}
	else
	{
		<div class="map-fill">
			<RideMap @ref="_map" Camera="_camera" Markers="_markerLayer" Routes="_routeLayer"
					 Circles="_privateAreaLayer" ShowUserLocation="false"
					 OnViewportReported="OnMapViewportReportedAsync"
					 OnMapClicked="OnMapTappedAsync" ShowPickingCursor="false" />
		</div>

		@* An error raised by something the menu did — the map underneath is still usable, so
		   this is a dismissible strip rather than a page that replaced itself with a message. *@
		@if (_session.Error is { } problem)
		{
			<div class="map-error error" role="alert">
				<span>@problem</span>
				<button type="button" class="close" @onclick="_session.ClearError" aria-label="Dismiss">×</button>
			</div>
		}

		@* Catches the tap that dismisses the menu. It covers the map and nothing else — over
		   the nav rail too and a tap meant for Home would only close a menu. *@
		@if (_menuOpen)
		{
			<div class="menu-backdrop" @onclick="CloseMenu"></div>
		}

		<div class="chrome">
			@* The dot on the button says "this map is not sitting still because you left it there".
			   Without it, a rider who has forgotten the mode is on reads the map undoing their pan
			   as a fault rather than as the thing they asked for. *@
			<button type="button" class="hamburger @(_menuOpen ? "open" : null) @(_followMe ? "following" : null)"
					@onclick="ToggleMenu"
					aria-haspopup="menu"
					aria-expanded="@(_menuOpen ? "true" : "false")"
					aria-label="@(_followMe ? "Ride actions — the map is following you" : "Ride actions")">
				<i class="fa fa-bars" aria-hidden="true"></i>
			</button>

			@if (_menuOpen)
			{
				<div class="menu" role="menu">
					<button type="button" role="menuitem" @onclick="GoToInfo">
						<i class="fa fa-fw fa-circle-info" aria-hidden="true"></i> Info
					</button>

					@if (ride.Permissions.AllowMemberMarkers || ride.IsOrganiser)
					{
						<button type="button" role="menuitem" @onclick="GoToComposer">
							<i class="fa fa-fw fa-circle-plus" aria-hidden="true"></i> Add marker
						</button>
					}

					<button type="button" role="menuitem" @onclick="GoToThread">
						<i class="fa fa-fw fa-comments" aria-hidden="true"></i> Ride thread
						@if (ride.State == RideStateDto.Live)
						{
							<span class="quiet">quiet while live</span>
						}
					</button>

					<hr />

					@*
						Below the rule: what the map itself is doing, as opposed to where the
						menu can take you. A checkbox rather than a plain item, because it is a
						mode that stays on after the menu closes — role="menuitemcheckbox" is
						what tells a screen reader that, and aria-checked is what carries it.
					*@
					<button type="button" role="menuitemcheckbox" class="@(_followMe ? "checked" : null)"
							aria-checked="@(_followMe ? "true" : "false")"
							@onclick="ToggleFollowMeAsync">
						<i class="fa fa-fw fa-location-crosshairs" aria-hidden="true"></i> Follow me
						@if (_followMe)
						{
							<span class="quiet">@(MyPosition is null ? "waiting for a fix" : "on")</span>
						}
					</button>

					<button type="button" role="menuitem" @onclick="ShowMarkers">
						<i class="fa fa-fw fa-map-pin" aria-hidden="true"></i> Markers
						<span class="count">@_session.Markers.Count</span>
					</button>
				</div>
			}
		</div>

		@*
			The map's pins carry an icon and a title and nothing else — the Skia overlay is
			`pointer-events: none` so gestures reach the base map (RideMap), which means a pin
			cannot be tapped for its detail. This list is where a marker's note, its photo and
			its delete live (§16.4, §16.5). It used to be a permanent sidebar; on a full-screen
			map it is what the menu's "Markers" opens.
		*@
		@if (_showMarkers)
		{
			<div class="overlay markers-dialog" role="dialog" aria-modal="true" aria-label="Markers"
				 @onclick="CloseMarkers">
				<div class="overlay-card markers" @onclick:stopPropagation="true">
					<header>
						<h2>Markers</h2>
						<button type="button" class="close" @onclick="CloseMarkers" aria-label="Close">×</button>
					</header>

					@if (_session.Markers.Count == 0)
					{
						<p class="hint">Nothing marked on this ride yet.</p>
					}
					else
					{
						<ul class="marker-list">
							@foreach (MarkerDto marker in _session.OrderedMarkers)
							{
								bool open = _openMarkerId == marker.Id;

								<li class="@(open ? "open" : null)">
									<button type="button" class="marker-head"
											aria-expanded="@(open ? "true" : "false")"
											@onclick="() => ToggleMarkerAsync(marker)">
										<span class="glyph" aria-hidden="true">@MarkerIconGlyphs.Emoji(marker.Icon)</span>
										<span class="what">
											<strong>@marker.Title</strong>
											<em>@marker.CreatedByUserName</em>
										</span>
										<span class="badges">
											@if (!string.IsNullOrWhiteSpace(marker.Note))
											{
												<span title="Has a note">📝</span>
											}
											@if (marker.PhotoId is not null)
											{
												<span title="Has a photo">📷</span>
											}
										</span>
									</button>

									@if (open)
									{
										<MarkerDetails Marker="marker" CanDelete="_session.CanDelete(marker)"
													   Deleting="_deletingMarkerId == marker.Id"
													   OnDelete="DeleteMarkerAsync" />
									}
								</li>
							}
						</ul>
					}
				</div>
			</div>
		}

		@if (_showConsent)
		{
			<ConsentPrompt RideName="@ride.Name"
						   OnShare="OnConsentShareAsync"
						   OnDismiss="OnConsentDismissAsync" />
		}

		@if (NearbyMarkers is { Count: > 0 } nearby)
		{
			<div class="overlay nearby-dialog" role="dialog" aria-modal="true" aria-label="Markers near that point"
				 @onclick="CloseNearby">
				<div class="overlay-card" @onclick:stopPropagation="true">
					<header>
						<h2>
							@(nearby.Count == 1 ? "1 marker here" : $"{nearby.Count} markers here")
						</h2>
						<button type="button" class="close" @onclick="CloseNearby" aria-label="Close">×</button>
					</header>

					@foreach (MarkerDto marker in nearby)
					{
						<section class="nearby-marker">
							<h3>
								<span class="glyph" aria-hidden="true">@MarkerIconGlyphs.Emoji(marker.Icon)</span>
								@marker.Title
							</h3>
							<p class="by">@marker.CreatedByUserName</p>

							<MarkerDetails Marker="marker" CanDelete="_session.CanDelete(marker)"
										   Deleting="_deletingMarkerId == marker.Id"
										   OnDelete="DeleteMarkerAsync" />
						</section>
					}
				</div>
			</div>
		}
	}
</div>

@code {
	[Parameter] public Guid RideId { get; set; }

	/// <summary>
	/// Where a ride opens when this device has nothing stored for it. Sydney, at city scale —
	/// the same view this page has always opened on, kept as a constant now that
	/// <see cref="RestoreViewAsync"/> and a change of ride both need something to go back to.
	/// </summary>
	private static readonly MapCamera DefaultCamera = new(-33.868, 151.209, 11);

	/// <summary>
	/// How often a pan may reach the device store. The map reports a viewport on every frame of
	/// a drag, and <c>localStorage</c> behind JS interop is not a per-frame surface — so the view
	/// is held in memory and written at this cadence, plus once on the way out
	/// (<see cref="DisposeAsync"/>), which is the write that actually matters.
	/// </summary>
	private static readonly TimeSpan SaveInterval = TimeSpan.FromSeconds(5);

	private RideSession _session = default!;
	private MapCamera _camera = DefaultCamera;
	private MapViewport? _mapViewport;
	private readonly Dictionary<Guid, MapMarker> _markerLayer = new();

	/// <summary>
	/// Whether the map keeps this rider centred as their fixes arrive (§5.3).
	/// <para>
	/// Stays on until it is switched off here — a pan does not cancel it. Guessing "the rider
	/// touched the map, so they meant to stop following" needs telling a rider's drag apart from
	/// the map's own move, which the viewport event does not say; getting that wrong silently
	/// drops the mode, and a mode that turns itself off is worse than one that has to be turned
	/// off. The dot on the hamburger is what keeps it from being a surprise.
	/// </para>
	/// </summary>
	private bool _followMe;

	/// <summary>
	/// Where the camera was last sent to follow this rider. Compared against the newest fix so a
	/// stationary rider costs nothing: positions arrive about once a second whether or not anybody
	/// has moved, and each one would otherwise be a JS interop call to re-centre on the same point.
	/// </summary>
	private (double Latitude, double Longitude)? _followedTo;

	/// <summary>The view last written to the device store, so an unchanged one is not written twice.</summary>
	private LiveMapView? _savedView;

	/// <summary>The view waiting to be written, if the throttle has not let one through yet.</summary>
	private LiveMapView? _pendingView;

	private DateTimeOffset _lastSavedUtc;

	/// <summary>
	/// The ride's planned routes as the overlay draws them (§5.4), in the session's order so a
	/// route's colour matches the one the info page's list gives it.
	/// </summary>
	private IReadOnlyList<RouteOverlay> _routeLayer = [];

	/// <summary>
	/// This rider's own private area (§10.1), drawn so they can see where the map stops carrying
	/// them. Null when none is set, which is every device by default.
	/// <para>
	/// <strong>Nobody else sees this.</strong> It is drawn from the device's own store and is not
	/// part of the ride's data — the server has never been told it exists, so there is nothing for
	/// another member's client to draw even if it wanted to.
	/// </para>
	/// </summary>
	private IReadOnlyList<MapCircle>? _privateAreaLayer;

	private bool _menuOpen;
	private bool _showMarkers;
	private bool _showConsent;

	/// <summary>Which marker's detail is expanded, or null when the list is all collapsed.</summary>
	private Guid? _openMarkerId;

	/// <summary>
	/// The markers a tap on the map landed on, nearest first — identified by id rather than
	/// held as DTOs so the popup follows the session's marker set. An edit arriving on the hub
	/// updates what is on screen, and a marker deleted underneath simply drops out; keeping
	/// copies would leave the popup showing a marker nobody else can see any more.
	/// </summary>
	private IReadOnlyList<Guid> _nearbyMarkerIds = Array.Empty<Guid>();

	private RideMap? _map;

	/// <summary>
	/// The marker whose delete is in flight. Deliberately not the session's <c>Busy</c>: that
	/// one disables the sharing switch and the organiser's lifecycle buttons over on the info
	/// page, and none of those have anything to do with removing a pin.
	/// </summary>
	private Guid? _deletingMarkerId;

	private string Title => _session?.Ride?.Name ?? "Ride";

	/// <summary>
	/// The markers the last tap landed on, resolved against the live set. Null when nothing
	/// was tapped, so the popup is simply absent rather than an empty card.
	/// </summary>
	private IReadOnlyList<MarkerDto>? NearbyMarkers
	{
		get
		{
			if (_nearbyMarkerIds.Count == 0)
			{
				return null;
			}

			List<MarkerDto> found = new(_nearbyMarkerIds.Count);
			foreach (Guid id in _nearbyMarkerIds)
			{
				if (_session.Markers.TryGetValue(id, out MarkerDto? marker))
				{
					found.Add(marker);
				}
			}

			return found.Count == 0 ? null : found;
		}
	}

	/// <summary>
	/// This rider's own latest fix, or null when the ride has none for them.
	/// <para>
	/// The ride's own view of where they are — the same fix everyone else's map is drawing them
	/// at — rather than a second read of the device's GPS. Following the pin the rider can see is
	/// the behaviour the mode promises, and it works on every host: <see cref="ILocationProvider"/>
	/// does not exist in a browser (§18.6), and a map that followed a private read would put the
	/// rider somewhere their own suppressed position (§10.1) says nobody should be looking.
	/// </para>
	/// <para>
	/// Null while not sharing, and until the first fix lands. That is what the menu item's
	/// "waiting for a fix" says, rather than the mode looking broken.
	/// </para>
	/// </summary>
	private RiderPositionDto? MyPosition =>
		Auth.UserId is { } me && _session.Positions.TryGetValue(me, out RiderPositionDto? mine) ? mine : null;

	/// <summary>Zoom a marker is brought to when it is chosen. Street level, not suburb level.</summary>
	private const double FocusZoom = 16;

	protected override void OnInitialized()
	{
		_session = new RideSession(Api, Hub, Auth);
		_session.Changed += OnSessionChanged;

		// The area can be placed, moved or removed on the settings screen while this page is
		// still mounted — PrivateAreaState is scoped, so it is the same instance — and the map
		// should agree with the setting without a reload.
		PrivateAreas.Changed += OnPrivateAreaChanged;
		RebuildPrivateAreaLayer();
	}

	/// <summary>
	/// Reads what this device stored after first render: the private area, and the view this map
	/// was last left on. On the web the store is behind JS interop, which does not exist during
	/// the prerender pass. The area read is idempotent, so it costs nothing on a device the
	/// settings screen has already read.
	/// </summary>
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
		{
			return;
		}

		await PrivateAreas.LoadAsync();
		await RestoreViewAsync();
	}

	private void OnPrivateAreaChanged()
	{
		RebuildPrivateAreaLayer();
		_ = InvokeAsync(StateHasChanged);
	}

	/// <summary>
	/// Projects the device's area into the overlay's circle list. A fresh list is what tells the
	/// canvas to repaint, so this runs on change rather than per render — the live map already
	/// repaints about once a second on positions alone.
	/// </summary>
	private void RebuildPrivateAreaLayer() =>
		_privateAreaLayer = PrivateAreas.Area is { } area
			? [new MapCircle(area.Latitude, area.Longitude, area.RadiusM)]
			: null;

	protected override async Task OnParametersSetAsync()
	{
		if (_session.RideId == RideId)
		{
			// Same ride, re-supplied parameters. Reloading here would drop every marker and
			// every position for the length of a round trip, for nothing.
			return;
		}

		// A different ride in the same component instance — the router reuses this page when only
		// the route parameter changes. The ride being left keeps the ground it was left on (it is
		// still _session.RideId at this point, which is what RememberViewAsync stamps), and the
		// camera goes back to the default: the stored view names one ride, and applying it to
		// another would open a Melbourne ride over Sydney.
		if (_session.RideId != Guid.Empty)
		{
			await RememberViewAsync(now: true);
			_camera = DefaultCamera;
			_mapViewport = null;
			_followedTo = null;
		}

		_openMarkerId = null;
		_nearbyMarkerIds = Array.Empty<Guid>();
		_menuOpen = false;
		_showMarkers = false;

		await _session.LoadAsync(RideId);

		// Consent prompt: shown once per joined ride that we do not yet share with. §5.6's
		// rule is dismissing = "not now", which is a no-op — closing the modal simply removes it.
		if (!_session.Sharing && _session.Ride?.State == RideStateDto.Open)
		{
			_showConsent = true;
		}
	}

	private void OnSessionChanged()
	{
		RebuildMapLayer();
		_ = InvokeAsync(async () =>
		{
			StateHasChanged();

			// Every position batch is a chance that this rider moved, and this is the only place
			// that learns about one. Cheap when they did not — see _followedTo.
			await FollowMeAsync();
		});
	}

	// -- The menu -----------------------------------------------------------------------------

	private void ToggleMenu() => _menuOpen = !_menuOpen;

	private void CloseMenu() => _menuOpen = false;

	private void GoToInfo()
	{
		_menuOpen = false;
		Nav.NavigateTo($"/group-rides/{RideId}/info");
	}

	private void GoToThread()
	{
		_menuOpen = false;
		Nav.NavigateTo($"/group-rides/{RideId}/thread");
	}

	private void ShowMarkers()
	{
		_menuOpen = false;
		_showMarkers = true;
	}

	/// <summary>
	/// Turns "keep me centred" on or off, and acts on it at once — a rider who has just panned
	/// away and switched it on is asking to be brought back now, not at the next fix.
	/// <para>
	/// Persisted with the view, so it survives the trip to the info page and the next launch.
	/// Written immediately rather than at the throttle's convenience: it is a deliberate choice,
	/// not a by-product of a drag.
	/// </para>
	/// </summary>
	private async Task ToggleFollowMeAsync()
	{
		_menuOpen = false;
		_followMe = !_followMe;

		// Forgetting where we last followed to is what makes switching it back on recentre even
		// when the rider has not moved since.
		_followedTo = null;

		await FollowMeAsync();
		await RememberViewAsync(now: true);
	}

	private void CloseMarkers()
	{
		_showMarkers = false;
		_openMarkerId = null;
	}

	/// <summary>
	/// Opens the marker composer on the view the rider is actually looking at, so the picker
	/// starts on the same ground rather than on a default somewhere else entirely (§16.1).
	/// <para>
	/// Built at click time, not baked into an <c>href</c>: keeping one current would mean
	/// re-rendering this page on every pan.
	/// </para>
	/// </summary>
	private void GoToComposer()
	{
		_menuOpen = false;

		string composer = $"/group-rides/{RideId}/markers/new";

		if (_mapViewport is not { CanvasWidthPx: > 0 } vp)
		{
			// No viewport yet: the composer's own ride-centred fallback takes over.
			Nav.NavigateTo(composer);
			return;
		}

		// GetUriWithQueryParameters handles invariant formatting and escaping, and survives a
		// route rename better than string concatenation.
		Nav.NavigateTo(Nav.GetUriWithQueryParameters(composer, new Dictionary<string, object?>
		{
			["lat"] = Math.Round(vp.CentreLatitude, 5),
			["lon"] = Math.Round(vp.CentreLongitude, 5),
			["zoom"] = Math.Round(vp.ZoomLevel, 2),
		}));
	}

	// -- The map ------------------------------------------------------------------------------

	/// <summary>
	/// Nothing on screen depends on the viewport until <see cref="GoToComposer"/> reads it — so no
	/// render here. What it does do is remember where the rider is looking, throttled, so the map
	/// re-opens on this ground rather than on the app's default.
	/// <para>
	/// Also the moment the base map first reports a frame, which is when a map opened with
	/// following already on can finally act on it.
	/// </para>
	/// </summary>
	private async Task OnMapViewportReportedAsync(MapViewport viewport)
	{
		_mapViewport = viewport;

		if (_followMe && _followedTo is null)
		{
			await FollowMeAsync();
		}

		await RememberViewAsync();
	}

	/// <summary>
	/// Brings the camera back to this rider, if the mode is on and the ride knows where they are.
	/// <para>
	/// Their zoom is kept — following is a promise about the centre of the screen, and taking a
	/// rider's zoom away from them once a second would make the map unusable. Heading likewise
	/// stays north-up: rotating the map under somebody reading it is a different feature.
	/// </para>
	/// </summary>
	private async Task FollowMeAsync()
	{
		if (!_followMe || MyPosition is not { } mine)
		{
			return;
		}

		double latitude = PositionScale.ToDegrees(mine.Lat);
		double longitude = PositionScale.ToDegrees(mine.Lon);

		if (_followedTo == (latitude, longitude))
		{
			// A rider stopped at a light still publishes; re-sending the same camera would be an
			// interop call a second for a map that is already where it should be.
			return;
		}

		_followedTo = (latitude, longitude);

		// Through the component only — _camera is deliberately left where it was. It is the
		// camera the map *opens* on, and a following map re-aims about once a second: writing
		// each of those into the parameter would have every render re-issue the move the
		// component had already made, a second interop call a tick for nothing.
		await ApplyCameraAsync(new MapCamera(
			latitude,
			longitude,
			_mapViewport?.ZoomLevel ?? _camera.ZoomLevel));
	}

	/// <summary>
	/// Reads back the view this map was last left on and opens there.
	/// <para>
	/// The camera only applies to the ride it was stored for; <see cref="LiveMapView.FollowMe"/>
	/// carries across rides, because it describes how this rider likes to be ridden with rather
	/// than one ride's ground.
	/// </para>
	/// <para>
	/// Both halves of the handover are covered: assigning <see cref="_camera"/> is what a base map
	/// that has not attached yet picks up at init, and <see cref="ApplyCameraAsync"/> is what moves
	/// one that already has. Which of the two wins the race is a matter of whether the ride's
	/// snapshot or the device store answered first, and neither order should cost the rider their
	/// view.
	/// </para>
	/// </summary>
	private async Task RestoreViewAsync()
	{
		LiveMapView? stored = LiveMapView.Decode(await Settings.GetAsync(LiveMapView.StorageKey));

		if (stored is null)
		{
			return;
		}

		_savedView = stored;
		_followMe = stored.FollowMe;

		if (stored.IsFor(RideId))
		{
			_camera = stored.ToCamera();
			await ApplyCameraAsync(_camera);
		}

		await InvokeAsync(StateHasChanged);

		// After the camera, so a rider who left it following ends up on themselves rather than on
		// the ground they were looking at a ride ago.
		await FollowMeAsync();
	}

	/// <summary>
	/// Holds the current view for the next time this map opens, and lets it through to the device
	/// store at most every <see cref="SaveInterval"/> — or immediately when the caller says so.
	/// </summary>
	/// <param name="now">
	/// True for a deliberate act (the follow toggle, leaving the page, leaving the ride), false for
	/// the pan-by-pan stream that would otherwise write on every frame of a drag.
	/// </param>
	private Task RememberViewAsync(bool now = false)
	{
		// _session.RideId rather than the RideId parameter: on a change of ride the parameter is
		// already the new one while the viewport on screen still belongs to the old.
		if (_session.RideId == Guid.Empty)
		{
			return Task.CompletedTask;
		}

		LiveMapView? view = (_mapViewport is { CanvasWidthPx: > 0 } vp
			? new LiveMapView(_session.RideId, vp.CentreLatitude, vp.CentreLongitude, vp.ZoomLevel, _followMe)
			: new LiveMapView(_session.RideId, _camera.Latitude, _camera.Longitude, _camera.ZoomLevel, _followMe))
			.Normalised();

		if (view is null || view == _savedView)
		{
			return Task.CompletedTask;
		}

		_pendingView = view;

		DateTimeOffset stamp = Clock.GetUtcNow();
		if (!now && stamp - _lastSavedUtc < SaveInterval)
		{
			// Held, not dropped: DisposeAsync writes whatever is pending on the way out, so the
			// throttle costs a rider at most the last few seconds of panning if the app is killed
			// with the map open.
			return Task.CompletedTask;
		}

		_lastSavedUtc = stamp;
		return SaveViewAsync();
	}

	private async Task SaveViewAsync()
	{
		if (_pendingView is not { } view)
		{
			return;
		}

		_pendingView = null;
		_savedView = view;

		// IDeviceSettings never throws — a browser with site data blocked answers the same as a
		// first run, and a view that cannot be persisted is not worth failing a live map over.
		await Settings.SetAsync(LiveMapView.StorageKey, view.Encode());
	}

	/// <summary>
	/// Moves the base map, tolerating one that never attached.
	/// <para>
	/// Driven through the component rather than by assigning <see cref="_camera"/> alone: a
	/// parameter only moves the map when its value differs from the last one applied, so asking
	/// for the same camera twice — following a rider back to a point they had panned away from,
	/// or choosing the same marker again — would do nothing at all the second time.
	/// </para>
	/// </summary>
	private async Task ApplyCameraAsync(MapCamera camera)
	{
		if (_map is null)
		{
			return;
		}

		try
		{
			await _map.SetCameraAsync(camera);
		}
		catch
		{
			// A base map that failed to attach shows its own stated error (§4.5). Refusing to
			// move a camera that does not exist is not worth a second error over the top.
		}
	}

	/// <summary>
	/// A tap on the base map lists every marker near that point (§16.4). The arithmetic is
	/// <see cref="MarkerHitTest"/>'s; this decides what to do with the answer.
	/// </summary>
	private async Task OnMapTappedAsync(MapClick click)
	{
		// A tap arriving before the map has reported a frame has nothing to hit-test against.
		if (_mapViewport is not { } viewport)
		{
			return;
		}

		_nearbyMarkerIds = [.. MarkerHitTest.Near(viewport, _session.Markers.Values, click).Select(marker => marker.Id)];

		await InvokeAsync(StateHasChanged);
	}

	private void CloseNearby() => _nearbyMarkerIds = Array.Empty<Guid>();

	/// <summary>
	/// Expands a row and brings the map to it. Collapsing leaves the camera alone — somebody
	/// closing a panel is done reading, not asking to be taken somewhere.
	/// </summary>
	private async Task ToggleMarkerAsync(MarkerDto marker)
	{
		if (_openMarkerId == marker.Id)
		{
			_openMarkerId = null;
			return;
		}

		_openMarkerId = marker.Id;
		await FocusAsync(marker);
	}

	/// <summary>
	/// Centres the map on a marker and zooms in, without zooming <em>out</em> on somebody who
	/// is already closer than <see cref="FocusZoom"/> — pulling the view back would throw away
	/// detail they had chosen.
	/// <para>
	/// Turns following off. Being carried to a marker and then dragged back to yourself a second
	/// later is not a reading of "show me that pin" anybody holds; the rider asked to look at
	/// something, and the mode has to yield to that.
	/// </para>
	/// </summary>
	private async Task FocusAsync(MarkerDto marker)
	{
		if (_map is null)
		{
			return;
		}

		_followMe = false;
		_followedTo = null;

		double zoom = Math.Max(_mapViewport?.ZoomLevel ?? FocusZoom, FocusZoom);

		_camera = new MapCamera(
			PositionScale.ToDegrees(marker.Lat),
			PositionScale.ToDegrees(marker.Lon),
			zoom);

		await ApplyCameraAsync(_camera);
	}

	/// <summary>
	/// Positions + markers merge into one Skia layer: riders draw as a named pill in their own
	/// colour, authored markers as their icon on a plate (§16.3).
	/// </summary>
	private void RebuildMapLayer()
	{
		// The lines arrive already encoded (§15.5), so this is a projection of the session's list
		// rather than any geometry work — the overlay decodes each line once and keeps it.
		// The track id rides along so the overlay can honour a colour the rider has pinned to
		// this particular route on the info page (§18.6). Without it the line would fall back
		// to its position in the list, which is the palette's answer, not theirs.
		_routeLayer = [.. _session.Routes.Select((route, index) =>
			new RouteOverlay(route.EncodedPolyline, RoutePalette.At(index), route.TrackId))];

		_markerLayer.Clear();
		foreach (RiderPositionDto position in _session.Positions.Values)
		{
			// The colour and the name both come off the member row, not the fix. A position
			// batch carries neither (§5.3) — the username because it is immutable and would be
			// bytes repeated every tick, the colour for the same reason — so the fix says where
			// somebody is and the member list says who and how they are drawn.
			RideMemberSummary? member = _session.Member(position.UserId);

			_markerLayer[position.UserId] = new MapMarker(
				Id: position.UserId,
				Latitude: PositionScale.ToDegrees(position.Lat),
				Longitude: PositionScale.ToDegrees(position.Lon),
				IconKey: string.Empty,
				Title: string.IsNullOrEmpty(position.UserName) ? member?.UserName ?? "?" : position.UserName,
				DirectionDeg: position.HeadingDeg,
				Kind: MarkerKind.Rider,
				SpeedMps: position.SpeedMps,
				Colour: member?.MarkerColour);
		}
		foreach (MarkerDto marker in _session.Markers.Values)
		{
			_markerLayer[marker.Id] = new MapMarker(
				Id: marker.Id,
				Latitude: PositionScale.ToDegrees(marker.Lat),
				Longitude: PositionScale.ToDegrees(marker.Lon),
				IconKey: marker.Icon,
				Title: marker.Title,
				DirectionDeg: marker.DirectionDeg);
		}
	}

	// -- Markers ------------------------------------------------------------------------------

	private async Task DeleteMarkerAsync(MarkerDto marker)
	{
		bool ok = await Confirm.AskAsync(
			"Delete marker?",
			$"“{marker.Title}” disappears from everyone's map. This cannot be undone.",
			confirmText: "Delete",
			danger: true);

		if (!ok) return;

		_deletingMarkerId = marker.Id;
		try
		{
			await _session.DeleteMarkerAsync(marker.Id);

			// Somebody's own delete can land while its detail is open. Collapsing it is the
			// honest response — the alternative is an expanded panel describing a marker that
			// no longer exists.
			if (_openMarkerId == marker.Id)
			{
				_openMarkerId = null;
			}
		}
		finally { _deletingMarkerId = null; }
	}

	// -- Consent ------------------------------------------------------------------------------

	private async Task OnConsentShareAsync()
	{
		_showConsent = false;
		await _session.SetSharingAsync(true);
	}

	private Task OnConsentDismissAsync()
	{
		_showConsent = false;
		return Task.CompletedTask;
	}

	public async ValueTask DisposeAsync()
	{
		_session.Changed -= OnSessionChanged;
		PrivateAreas.Changed -= OnPrivateAreaChanged;

		// The write that matters: leaving for the info page, the composer or the thread is the
		// common way off this map, and coming straight back is the common way onto it.
		await RememberViewAsync(now: true);

		await _session.DisposeAsync();
	}
}

<style>
	/* The map is the page — it fills the shell that .page-full pinned to the content area. */
	.live .map-fill {
		position: absolute;
		inset: 0;
	}

	.live .map-fill .dlr-map-container {
		height: 100%;
		min-height: 0;
	}

	/*
		The hamburger and its menu. `position: absolute` inside .page-full rather than fixed,
		so the whole assembly lands inside the content area on both rail placements without
		restating the rail's geometry a second time.
	*/
	.live .chrome {
		position: absolute;
		top: max(0.75rem, env(safe-area-inset-top));
		right: max(0.75rem, env(safe-area-inset-right));
		z-index: 20;
	}

	.live .hamburger {
		display: flex;
		align-items: center;
		justify-content: center;
		/* Anchors the "following" dot below. */
		position: relative;
		/* 48 px is the tap target the rail uses; a menu opened with gloves on is the point. */
		width: 48px;
		height: 48px;
		padding: 0;
		background: var(--dlr-accent);
		color: var(--dlr-accent-fg);
		border: 2px solid var(--dlr-accent-fg);
		border-radius: 8px;
		font-size: 20px;
		cursor: pointer;
		box-shadow: 0 2px 8px rgba(0,0,0,0.35);
	}

	/*
		Following is a mode that outlives the menu it was set from, so the closed menu has to
		say so. A dot on the corner of the button rather than a second control beside it: the
		map is the page and the chrome over it is rationed.
	*/
	.live .hamburger.following::after {
		content: "";
		position: absolute;
		top: 4px;
		right: 4px;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--dlr-accent-fg);
		border: 2px solid var(--dlr-accent);
	}

	/* Sits under the hamburger and over the map: a tap that dismisses must not also pan.
	   Absolute inside .page-full, so it stops at the nav rail rather than swallowing it. */
	.live .menu-backdrop {
		position: absolute;
		inset: 0;
		z-index: 19;
	}

	.live .menu {
		position: absolute;
		top: calc(48px + 0.5rem);
		right: 0;
		min-width: 15rem;
		padding: 0.35rem 0;
		background: var(--dlr-surface);
		border: 1px solid var(--dlr-border);
		border-radius: 8px;
		box-shadow: 0 8px 24px rgba(0,0,0,0.45);
	}

	.live .menu button {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		width: 100%;
		padding: 0.6rem 1rem;
		background: transparent;
		border: 0;
		color: var(--dlr-fg);
		font: inherit;
		text-align: left;
		white-space: nowrap;
		cursor: pointer;
	}

	.live .menu button:hover {
		background: var(--dlr-accent-soft);
	}

	/* A mode that is on reads as on with the menu open too, not only from the dot outside it. */
	.live .menu button.checked {
		background: var(--dlr-accent-soft);
	}

	.live .menu button.checked i {
		color: var(--dlr-accent);
	}

	.live .menu button i {
		color: var(--dlr-fg-muted);
	}

	.live .menu .count, .live .menu .quiet {
		margin-left: auto;
		font-size: 0.8rem;
		color: var(--dlr-fg-muted);
	}

	.live .menu hr {
		margin: 0.35rem 0;
		border: 0;
		border-top: 1px solid var(--dlr-border);
	}

	/* A stated failure from a menu action, over a map that still works. */
	.live .map-error {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		top: max(0.75rem, env(safe-area-inset-top));
		z-index: 15;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		max-width: min(28rem, calc(100% - 5rem));
	}

	.live .map-error .close {
		background: transparent;
		border: 0;
		color: inherit;
		font-size: 1.25rem;
		line-height: 1;
		cursor: pointer;
	}

	/*
		One modal treatment for both popups — the tapped-pin list and the markers panel. On a
		phone the map fills the screen, so anything anchored to a point sits under the finger.
	*/
	.live .overlay {
		position: fixed;
		inset: 0;
		background: rgba(0,0,0,0.5);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 1000;
		padding: 1rem;
	}

	.live .overlay-card {
		background: var(--dlr-surface, #1f2937);
		color: var(--dlr-text, #f9fafb);
		border-radius: 8px;
		padding: 1rem 1.25rem 1.25rem;
		max-width: 28rem;
		width: 100%;
		/* Several markers under one tap is normal at low zoom; the card scrolls rather than
		   growing past the viewport. */
		max-height: min(80vh, 40rem);
		overflow-y: auto;
	}

	.live .overlay-card header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.live .overlay-card h2 {
		margin: 0 0 0.5rem;
		font-size: 1.1rem;
	}

	.live .overlay-card .close {
		background: transparent;
		border: 0;
		color: inherit;
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
		padding: 0 0.25rem;
	}

	.live .marker-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.live .marker-list li + li {
		border-top: 1px solid #ffffff1f;
	}

	/* The whole row is the disclosure control, so it is a button — but it has to read as a
	   list row, which means unpicking the button chrome rather than styling around it. */
	.live .marker-head {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		padding: 0.4rem 0;
		background: transparent;
		border: 0;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

		.live .marker-head .glyph {
			font-size: 1.25rem;
			line-height: 1;
		}

		.live .marker-head .what {
			flex: 1;
			min-width: 0;
		}

			/* A title is capped at 40 characters but the card is narrower than that, and a
			   wrapped one would push the badges out of line. */
			.live .marker-head .what strong,
			.live .marker-head .what em {
				display: block;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.live .marker-head .what em {
				font-size: 0.8rem;
				opacity: 0.7;
			}

		.live .marker-head .badges {
			font-size: 0.8rem;
			opacity: 0.8;
		}

	.live .marker-body {
		padding: 0 0 0.6rem 1.75rem;
	}

		.live .marker-body .kind {
			margin: 0 0 0.35rem;
			font-size: 0.8rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			opacity: 0.7;
		}

		/* A note is free text somebody typed at the side of a road — it keeps its own line
		   breaks, and a long unbroken string must not widen the card. */
		.live .marker-body .note {
			margin: 0 0 0.5rem;
			white-space: pre-wrap;
			overflow-wrap: anywhere;
		}

		.live .marker-body .marker-photo {
			display: block;
			max-width: 100%;
			border-radius: 4px;
			margin-bottom: 0.5rem;
		}

		.live .marker-body .danger {
			padding: 0.35rem 0.7rem;
			background: #b91c1c;
			color: white;
			border: 0;
			border-radius: 4px;
			cursor: pointer;
			font: inherit;
		}

			.live .marker-body .danger:disabled {
				opacity: 0.6;
				cursor: default;
			}

	.live .nearby-marker + .nearby-marker {
		border-top: 1px solid #ffffff1f;
		margin-top: 0.75rem;
		padding-top: 0.75rem;
	}

		.live .nearby-marker h3 {
			margin: 0;
			font-size: 1rem;
		}

			.live .nearby-marker h3 .glyph {
				font-size: 1.25rem;
			}

		.live .nearby-marker .by {
			margin: 0;
			font-size: 0.8rem;
			opacity: 0.7;
		}

		/* Inside the popup the detail is the content, not an indented disclosure. */
		.live .nearby-marker .marker-body {
			padding-left: 0;
		}
</style>
