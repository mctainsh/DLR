	/// <para>
	/// <strong>Nobody else sees this.</strong> The server holds the circle for the account that
	/// set it and answers with it to nobody else: it is not part of the ride's data, no endpoint
	/// exposes another rider's area, and <c>SharedProfile</c> has no field for one - so there is
	/// nothing for another member's client to draw even if it wanted to.
	/// </para>
	/// </summary>
	private IReadOnlyList<MapCircle>? _privateAreaLayer;

	private bool _menuOpen;
	private bool _showMarkers;
	private bool _showConsent;

	/// <summary>
	/// Whether the panel naming the riders immediately ahead and behind is on screen (§5.4).
	/// <para>
	/// <strong>On unless the rider has turned it off</strong>, which is the opposite default from the
