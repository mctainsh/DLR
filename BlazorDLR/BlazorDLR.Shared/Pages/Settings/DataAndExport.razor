@page "/settings/data"
@attribute [Authorize]
@using DLR.Core.Contracts.Account
@inject IApiClient Api
@inject IFileSaver FileSaver
@inject NavigationManager Nav
@inject AuthState Auth

<PageTitle>Data &amp; export - Dumb Luck Routes</PageTitle>

@*
	§6.3 and §10.2's store-compliance requirement: account deletion must be reachable from
	inside the app, and data export is what "hand me my data" means in privacy terms.

	Two flows on one page:
	  1. Export - GET /api/v1/me/export returns a ZIP (§6.3, §16.6). The client triggers
		 a browser download; on the phone the BlazorWebView downloads to the platform's
		 default share sheet handler.
	  2. Delete - DELETE /api/v1/me takes the current password in the body (§6.3). Nothing
		 is recoverable, and the callout says so plainly.
*@

<div class="page page-medium form-page">
	<PageNav Title="Data &amp; export" BackHref="/settings" BackLabel="Back to settings" />

	<section>
		<h2>Export your data</h2>
		<p>
			A ZIP containing every adventure, every marker, every photo, every comment, plus the
			profile fields and switches. Large libraries may take a few seconds
			to build.
		</p>
		<button type="button" class="primary" @onclick="ExportAsync" disabled="@_busy">
			@(_busy ? "Preparing…" : "Download my data")
		</button>
		@if (_exportStatus is not null)
		{
			<p class="status">@_exportStatus</p>
		}
	</section>

	<hr />

	<section class="danger-zone">
		<h2>Delete this account</h2>

		<div class="callout">
			<p>
				<strong>Deletion is permanent.</strong> Every track, marker, photo, comment,
				reaction and vote goes with it. Any group adventure you organise is cancelled and
				its members' access ends immediately. Any device you signed in on this account
				with is signed out on its next refresh.
			</p>
			<p>
				Nightly backups hold a copy for their retention period. Support cannot
				restore an account after the backups roll out.
			</p>
		</div>

		@if (!_showDelete)
		{
			<button type="button" class="danger" @onclick="() => _showDelete = true" disabled="@_busy">
				Delete my account…
			</button>
		}
		else
		{
			<div class="confirm">
				<label>
					Enter your current password
					<input @bind="_password" type="password" autocomplete="current-password" />
				</label>
				<label class="switch ack">
					<input type="checkbox" @bind="_ack" />
					I understand this cannot be undone.
				</label>
				<div class="actions">
					<button type="button" class="primary" @onclick="CancelDelete">Cancel</button>
					<button type="button" class="danger"
							@onclick="DeleteAsync"
							disabled="@(_busy || !_ack || string.IsNullOrEmpty(_password))">
						@(_busy ? "Deleting…" : "Delete my account permanently")
					</button>
				</div>
			</div>
		}

		@if (_deleteError is not null)
		{
			<div class="error" role="alert">
				<strong>@_deleteError.Title</strong>
				@if (_deleteError.Messages.Count > 0)
				{
					<ul>@foreach (string message in _deleteError.Messages) { <li>@message</li> }</ul>
				}
			</div>
		}
	</section>
</div>

@code {
	private bool _busy;
	private string? _exportStatus;

	private bool _showDelete;
	private string _password = string.Empty;
	private bool _ack;
	private ApiError? _deleteError;

	private async Task ExportAsync()
	{
		if (_busy) return;
		_busy = true;
		_exportStatus = "Preparing…";

		try
		{
			using HttpResponseMessage response = await Api.ExportAccountAsync();
			if (!response.IsSuccessStatusCode)
			{
				ApiError error = await ProblemDetailsReader.ReadAsync(response);
				_exportStatus = $"Export failed: {error.Title}";
				return;
			}

			// Stream to bytes, then hand the file to the host. The response carries a
			// Content-Disposition attachment, but the browser is not the one that made the
			// request - the app is - so somebody has to save it. That is not the same job on
			// every host (an anchor click does nothing inside a WebView), which is what
			// IFileSaver is for.
			byte[] bytes = await response.Content.ReadAsByteArrayAsync();
			string fileName = $"dlr-export-{Auth.UserName ?? "me"}.zip";

			FileSaveResult saved = await FileSaver.SaveAsync(fileName, "application/zip", bytes);

			_exportStatus = saved.Status switch
			{
				FileSaveStatus.Saved => saved.Detail ?? "Download started.",
				FileSaveStatus.Cancelled => null,
				_ => $"Export failed: {saved.Detail ?? "this device has nowhere to put the file."}",
			};
		}
		catch (Exception exception)
		{
			_exportStatus = $"Export failed: {exception.Message}";
		}
		finally
		{
			_busy = false;
		}
	}

	private void CancelDelete()
	{
		_showDelete = false;
		_password = string.Empty;
		_ack = false;
		_deleteError = null;
	}

	private async Task DeleteAsync()
	{
		if (_busy || !_ack || string.IsNullOrEmpty(_password)) return;
		_busy = true;
		_deleteError = null;

		try
		{
			await Api.DeleteAccountAsync(new DeleteAccountRequest(_password));

			// Sign out locally and land on Welcome. The refresh token (mobile) or cookie (web)
			// is now dead server-side, so subsequent requests would 401 anyway - clearing the
			// client state now avoids a flash of the empty signed-in shell.
			await Auth.SignOutAsync();
			Nav.NavigateTo("/welcome", forceLoad: true);
		}
		catch (ApiException apiException)
		{
			_deleteError = apiException.Error;
		}
		catch (Exception exception)
		{
			_deleteError = new ApiError(default, "Could not delete the account.", new[] { exception.Message });
		}
		finally
		{
			_busy = false;
		}
	}
}

<style>
	.page .danger-zone { padding: 1rem; background: #fef2f2; border: 1px solid #fecaca; border-radius: 6px; }
	.page .danger-zone h2 { color: #991b1b; margin: 0 0 0.5rem; }
	.page .callout p { margin: 0.5rem 0; color: black; }

	/*
		Deleting the account is the one irreversible thing in the app, so this button
		is solid red rather than the shared soft-danger tint used for reversible things
		like revoking a device.
	*/
	.page .danger { background: #dc2626; color: white; border: none; }
	.page .confirm { margin-top: 1rem; padding: 1rem; background: white; border-radius: 6px; }
</style>
