@page "/settings"
@attribute [Authorize]
@inject IServiceProvider Services
@inject AdminAccess Admin

<PageTitle>Settings — Dumb Luck Routes</PageTitle>

<div class="page page-medium">
	<PageNav Title="Settings" BackHref="/" BackLabel="Back to home" />

	<div class="cards">
		<a class="card" href="/settings/profile">
			<h2><i class="fa fa-fw fa-id-card" aria-hidden="true"></i> Profile</h2>
			<p>Display name, phone number, email — and who sees what.</p>
		</a>
		@*
			Only on a host with a GPS to configure (§18.6). Every control behind this card —
			the accuracy profile, the recording interval, the private area — describes what a
			receiver does with its fixes, and a browser has no receiver and no fixes. Offered
			there, it was a page of settings that could not change anything about the machine
			reading them.
		*@
		@if (HasReceiver)
		{
			<a class="card" href="/settings/location">
				<h2><i class="fa fa-fw fa-location-dot" aria-hidden="true"></i> Location</h2>
				<p>GPS accuracy, recording your adventures, and the private area around home.</p>
			</a>
		}
		<a class="card" href="/settings/maps">
			<h2><i class="fa fa-fw fa-map" aria-hidden="true"></i> Maps</h2>
			<p>Which tiles go under your maps — OpenStreetMap, or a tile server of your own.</p>
		</a>
		<a class="card" href="/settings/devices">
			<h2><i class="fa fa-fw fa-mobile-screen" aria-hidden="true"></i> Signed-in devices</h2>
			<p>Every device this account is signed in on — revoke the ones you no longer have.</p>
		</a>
		<a class="card" href="/settings/blocks">
			<h2><i class="fa fa-fw fa-user-slash" aria-hidden="true"></i> Blocked travellers</h2>
			<p>Anyone whose posts, reactions and markers you have chosen to hide.</p>
		</a>

		<a class="card" href="/settings/account">
			<h2><i class="fa fa-fw fa-key" aria-hidden="true"></i> Account</h2>
			<p>Recovery email, and changing your password.</p>
		</a>

		<a class="card" href="/settings/data">
			<h2><i class="fa fa-fw fa-file-export" aria-hidden="true"></i> Data &amp; export</h2>
			<p>Download every adventure, marker and photo. Delete your account.</p>
		</a>

		@*
			The introduction, which every device is shown once on its first run (§18.6). Offered
			here for ever after because the one time it is shown is the one time a rider knows
			least about what they are being told — and a rider who skipped it on day one has
			nowhere else to find it.
		*@
		<a class="card" href="/intro">
			<h2><i class="fa fa-fw fa-circle-info" aria-hidden="true"></i> How this works</h2>
			<p>The quick introduction to the app, again — what an adventure is, and what it shares.</p>
		</a>

		@*
			A diagnostic, and offered on every host rather than hidden behind a build flag: the
			one machine whose log is hardest to read is a phone, which is also the one this app
			mostly runs on.
		*@
		<a class="card" href="/settings/log">
			<h2><i class="fa fa-fw fa-file-lines" aria-hidden="true"></i> Log</h2>
			<p>What the app has been doing on this device. For working out why something did not happen.</p>
		</a>

		@*
			The administration screens (§14.6), and the only link to them anywhere in the app.

			Offered on a roster the server keeps, not on anything this account can set — see
			AdminAccess. It renders once the answer is back rather than reserving a space for it,
			because for nearly every account the answer is "no" and a card that appeared a moment
			after the page did would be the only thing on this screen that moved.
		*@
		@if (_isAdmin)
		{
			<a class="card" href="/admin">
				<h2><i class="fa fa-fw fa-screwdriver-wrench" aria-hidden="true"></i> Administration</h2>
				<p>Travellers, server statistics and the server's log. Only for this server's administrators.</p>
			</a>
		}

		<div>Version : @typeof(BlazorDLR.Shared.Components.SourceOfferFooter).Assembly.GetName().Version</div>
	</div>
</div>

@code {
	/// <summary>
	/// Whether this host has a GPS receiver at all. The MAUI app registers
	/// <see cref="LocationBroadcastState"/>; neither browser host does (§18.6), so the absence of
	/// the service <em>is</em> the answer rather than something to ask a seam about.
	/// </summary>
	private bool HasReceiver => Services.GetService<LocationBroadcastState>() is not null;

	/// <summary>
	/// Whether to offer the administration card. False until the server has answered, so the
	/// overwhelmingly common case — an account that is not an administrator — never sees it flicker.
	/// </summary>
	private bool _isAdmin;

	protected override async Task OnInitializedAsync() => _isAdmin = await Admin.IsAdminAsync();
}
