@page "/settings"
@attribute [Authorize]

<PageTitle>Settings — Dumb Luck Rides</PageTitle>

<div class="settings">
    <h1>Settings</h1>

    <div class="cards">
        <a class="card" href="/settings/profile">
            <h2>Profile</h2>
            <p>Display name, phone number, email — and who sees what (§7.3).</p>
        </a>
        <a class="card" href="/settings/devices">
            <h2>Signed-in devices</h2>
            <p>Every device this account is signed in on — revoke the ones you no longer have.</p>
        </a>
        <a class="card" href="/settings/blocks">
            <h2>Blocked riders</h2>
            <p>Anyone whose posts, reactions and markers you have chosen to hide.</p>
        </a>

        <a class="card" href="/settings/account">
            <h2>Account</h2>
            <p>Change password.</p>
        </a>

        <a class="card" href="/settings/data">
            <h2>Data &amp; export</h2>
            <p>Download every ride, marker and photo. Delete your account.</p>
        </a>
    </div>
</div>

<style>
    .settings { max-width: 40rem; margin: 1rem auto; padding: 0 1rem; }
    .settings .cards { display: grid; gap: 0.75rem; margin-top: 1rem; }
    .settings .card {
        display: block; padding: 1rem; text-decoration: none; color: inherit;
        background: #f7f8fa; border: 1px solid #e5e7eb; border-radius: 6px;
    }
    .settings .card:hover { border-color: #2563eb; }
    .settings .card h2 { margin: 0 0 0.25rem 0; font-size: 1.05rem; color: #2563eb; }
    .settings .card p { margin: 0; opacity: 0.8; }
</style>
