@page "/settings"
@attribute [Authorize]
@inject IServiceProvider Services

<PageTitle>Settings — Dumb Luck Routes</PageTitle>

<div class="page page-medium">
	<PageNav Title="Settings" BackHref="/" BackLabel="Back to home" />

	<div class="cards">
		<a class="card" href="/settings/profile">
			<h2>Profile</h2>
			<p>Display name, phone number, email — and who sees what.</p>
		</a>
		@*
			Only on a host with a GPS to configure (§18.6). Every control behind this card —
			the accuracy profile, the recording interval, the private area — describes what a
			receiver does with its fixes, and a browser has no receiver and no fixes. Offered
			there, it was a page of settings that could not change anything about the machine
			reading them.
		*@
		@if (HasReceiver)
		{
			<a class="card" href="/settings/location">
				<h2>Location</h2>
				<p>GPS accuracy, recording your rides, and the private area around home.</p>
			</a>
		}
		<a class="card" href="/settings/maps">
			<h2>Maps</h2>
			<p>Which tiles go under your maps — OpenStreetMap, or a tile server of your own.</p>
		</a>
		<a class="card" href="/settings/devices">
			<h2>Signed-in devices</h2>
			<p>Every device this account is signed in on — revoke the ones you no longer have.</p>
		</a>
		<a class="card" href="/settings/blocks">
			<h2>Blocked riders</h2>
			<p>Anyone whose posts, reactions and markers you have chosen to hide.</p>
		</a>

		<a class="card" href="/settings/account">
			<h2>Account</h2>
			<p>Recovery email, and changing your password.</p>
		</a>

		<a class="card" href="/settings/data">
			<h2>Data &amp; export</h2>
			<p>Download every ride, marker and photo. Delete your account.</p>
		</a>

		<div>Version : @typeof(BlazorDLR.Shared.Components.SourceOfferFooter).Assembly.GetName().Version</div>
	</div>
</div>

@code {
	/// <summary>
	/// Whether this host has a GPS receiver at all. The MAUI app registers
	/// <see cref="LocationBroadcastState"/>; neither browser host does (§18.6), so the absence of
	/// the service <em>is</em> the answer rather than something to ask a seam about.
	/// </summary>
	private bool HasReceiver => Services.GetService<LocationBroadcastState>() is not null;
}
