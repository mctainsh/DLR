@page "/settings"
@attribute [Authorize]

<PageTitle>Settings — Dumb Luck Routes</PageTitle>

<div class="page page-medium">
	<h1>Settings</h1>

	<div class="cards">
		<a class="card" href="/settings/profile">
			<h2>Profile</h2>
			<p>Display name, phone number, email — and who sees what.</p>
		</a>
		<a class="card" href="/settings/devices">
			<h2>Signed-in devices</h2>
			<p>Every device this account is signed in on — revoke the ones you no longer have.</p>
		</a>
		<a class="card" href="/settings/blocks">
			<h2>Blocked riders</h2>
			<p>Anyone whose posts, reactions and markers you have chosen to hide.</p>
		</a>

		<a class="card" href="/settings/account">
			<h2>Account</h2>
			<p>Change password.</p>
		</a>

		<a class="card" href="/settings/data">
			<h2>Data &amp; export</h2>
			<p>Download every ride, marker and photo. Delete your account.</p>
		</a>
	</div>
</div>
