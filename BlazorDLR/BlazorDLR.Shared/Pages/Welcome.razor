@page "/welcome"
@using BlazorDLR.Shared.Components
@using BlazorDLR.Shared.Services
@using BlazorDLR.Shared.State
@using DLR.Core.Contracts.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject IApiClient Api
@inject AuthState Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IEnumerable<IExternalSignInProvider> ExternalProviders
@implements IDisposable

<PageTitle>Welcome — Dumb Luck Routes</PageTitle>

@*
	The one screen an unauthenticated caller lands on (§7.9). Register or sign in.

	Registration is deliberately the first tab. The whole product's argument in v0.5
	onwards is "signup should not be a hurdle": a username + password is the account,
	email is optional, and the confirmation copy has to state the recovery trade-off
	plainly (§7.2). The email-consequences warning below is that copy, rendered every
	time the field is left blank rather than in a dialog nobody reads.
*@

<AuthorizeView>
	<Authorized>
		@*
			Nobody should ever have to read this. An authenticated caller on /welcome is
			sent to the home page by OnAuthenticationStateChanged / OnInitializedAsync
			below; this is the frame or two before that navigation lands, and the fallback
			if it cannot (a host that suppresses navigation during prerender).
		*@
		<div class="page page-form form-page welcome">
			<p>Signed in as <strong>@context.User.Identity!.Name</strong> — taking you to your adventures…</p>
			<button type="button" class="primary" @onclick="GoHome">Continue</button>
		</div>
	</Authorized>
	<NotAuthorized>
		<div class="page page-form form-page welcome">
			<h1>Dumb Luck Routes</h1>
			<p class="tagline">
				Travel together, know where each other is, and stop knowing the moment the adventure ends.
			</p>

			<div class="tabs">
				<button type="button"
						class="tab @(_tab == Tab.Register ? "active" : "")"
						@onclick="() => _tab = Tab.Register">
					Register
				</button>
				<button type="button"
						class="tab @(_tab == Tab.SignIn ? "active" : "")"
						@onclick="() => _tab = Tab.SignIn">
					Sign in
				</button>
			</div>

			@if (_tab == Tab.Register)
			{
				<form @onsubmit="RegisterAsync" @onsubmit:preventDefault="true">
					<label>
						User name (<em>permanent</em>, chosen once)
						<input @bind="_userName" @bind:event="oninput" @onblur="CheckAvailabilityAsync"
							   autocomplete="off" placeholder="DaveSmith" required />
					</label>
					@if (!string.IsNullOrEmpty(_availability))
					{
						<p class="hint @_availabilityKind">@_availability</p>
					}

					@*
						The meter is Register-only. On Sign in the password is one the rider
						already has, and grading it there is advice about a decision they cannot
						revisit from that form.
					*@
					<PasswordField @key="Tab.Register"
								   Id="register-password"
								   Label="Password"
								   @bind-Value="_password"
								   Autocomplete="new-password"
								   ShowStrength="true">
						<span class="rule-hint">
							At least 6 characters, and at least one uppercase letter,
							one lowercase letter and one digit.
						</span>
					</PasswordField>

					<label>
						Email (optional — see below)
						<input @bind="_email" type="email" autocomplete="email" />
					</label>

					@if (string.IsNullOrWhiteSpace(_email))
					{
						<div class="callout">
							<strong>No email means no recovery and no warning.</strong>
							If you forget your password or lose this device, this account and
							everything in it is gone — a password cannot be reset without an email.
							An unused account holding no saved adventures is deleted after 6 months,
							and with no email address we cannot warn you before it happens.
							You can add one later in Settings.
						</div>
					}

					<button type="submit" class="primary" disabled="@_busy">
						@(_busy ? "Registering…" : "Create account")
					</button>
				</form>
			}
			else
			{
				<form @onsubmit="SignInAsync" @onsubmit:preventDefault="true">
					<label>
						User name
						<input @bind="_userName" autocomplete="username" required />
					</label>
					<PasswordField @key="Tab.SignIn"
								   Id="signin-password"
								   Label="Password"
								   @bind-Value="_password"
								   Autocomplete="current-password" />
					<button type="submit" class="primary" disabled="@_busy">
						@(_busy ? "Signing in…" : "Sign in")
					</button>

					@*
						The only entry to recovery there is (§7.7). Sign-in is where somebody
						discovers they have forgotten the password, so it is the one place the
						link is worth anything — and without it the emailed reset flow has no
						way to start.
					*@
					<p class="forgot"><a href="/forgot-password">Forgotten your password?</a></p>
				</form>
			}

			@if (_error is not null)
			{
				<div class="error" role="alert">
					<strong>@_error.Title</strong>
					@if (_error.Messages.Count > 0)
					{
						<ul>
							@foreach (string message in _error.Messages)
							{
								<li>@message</li>
							}
						</ul>
					}
				</div>
			}

			@if (ExternalProviders.Any())
			{
				@* <div class="external">
					<div class="external-divider"><span>or</span></div>
					@foreach (IExternalSignInProvider provider in ExternalProviders)
					{
						<button type="button"
								class="external-button @provider.Provider.ToString().ToLowerInvariant()"
								disabled="@(!provider.IsAvailable || _busy)"
								@onclick="() => SignInWithAsync(provider)">
							Sign in with @provider.Provider
							@if (!provider.IsAvailable)
							{
								<span class="soon">— coming soon (probably not)</span>
							}
						</button>
					}
				</div> *@
			}
		</div>
	</NotAuthorized>
</AuthorizeView>

@* AGPL §13 source offer — every page, public and authed (§14.6.2). *@
<BlazorDLR.Shared.Components.SourceOfferFooter />

@code {
	private enum Tab { Register, SignIn }

	private Tab _tab = Tab.SignIn;

#if DEBUG
	private string _userName = "JRM";
	private string _password = "AAAaaa111";
#else
	private string _userName = string.Empty;
	private string _password = string.Empty;
#endif
	private string _email = string.Empty;
	private ApiError? _error;
	private bool _busy;
	private string? _availability;
	private string _availabilityKind = string.Empty;
	private bool _navigated;

	/// <summary>
	/// If already signed in jump straight to the home page — no button to push.
	/// <para>
	/// The arrival can be later than the first render: the session is restored
	/// asynchronously, so a rider can land here anonymous and become authenticated a
	/// moment later (a refresh in flight while <c>RedirectToWelcome</c> bounced them
	/// here). That broadcast re-renders <c>AuthorizeView</c> but <em>not</em> this
	/// page — the cascade is consumed by the child, not by us — which is why the check
	/// has to hang off <see cref="AuthenticationStateProvider.AuthenticationStateChanged"/>
	/// rather than off a render callback.
	/// </para>
	/// </summary>
	override protected async Task OnInitializedAsync()
	{
		AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

		AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
		GoHomeIfAuthenticated(authState);
	}

	private void OnAuthenticationStateChanged(Task<AuthenticationState> task) =>
		_ = InvokeAsync(async () => GoHomeIfAuthenticated(await task));

	private void GoHomeIfAuthenticated(AuthenticationState authState)
	{
		if (authState.User.Identity?.IsAuthenticated ?? false)
			GoHome();
	}

	public void Dispose() => AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;

	private async Task CheckAvailabilityAsync()
	{
		if (string.IsNullOrWhiteSpace(_userName) || _userName.Length < 3)
		{
			_availability = null;
			return;
		}

		try
		{
			bool available = await Api.IsUserNameAvailableAsync(_userName.Trim());
			_availability = available
				? $"'{_userName.Trim()}' is available."
				: $"'{_userName.Trim()}' is taken.";
			_availabilityKind = available ? "good" : "bad";
		}
		catch
		{
			// A network hiccup on the availability check is not a reason to gate the form —
			// the register endpoint will answer with a clear error if the name is taken.
			_availability = null;
		}
	}

	private async Task RegisterAsync()
	{
		if (_busy) return;
		_busy = true;
		_error = null;

		try
		{
			TokenResponse session = await Api.RegisterAsync(new RegisterRequest(
				UserName: _userName.Trim(),
				Password: _password,
				Email: string.IsNullOrWhiteSpace(_email) ? null : _email.Trim()));

			await Auth.ApplySessionAsync(session);
			GoHome();
		}
		catch (ApiException apiException)
		{
			// ApiException carries the server's ProblemDetails — the title and every
			// per-field error the register endpoint sent (§18.2). Rendered verbatim by
			// the alert above.
			_error = apiException.Error;
		}
		catch (Exception exception)
		{
			_error = new ApiError(default, "Could not create the account.", new[] { exception.Message });
		}
		finally
		{
			_busy = false;
		}
	}

	private async Task SignInAsync()
	{
		if (_busy) return;
		_busy = true;
		_error = null;

		try
		{
			TokenResponse session = await Api.TokenAsync(new TokenRequest(
				GrantType: GrantTypes.Password,
				UserName: _userName.Trim(),
				Password: _password));

			await Auth.ApplySessionAsync(session);
			GoHome();
		}
		catch (ApiException apiException)
		{
			_error = apiException.Error;
		}
		catch (Exception exception)
		{
			_error = new ApiError(default, "Sign-in failed.", new[] { exception.Message });
		}
		finally
		{
			_busy = false;
		}
	}

	// Sign-in, register and the auth-state broadcast can all reach here for the one event —
	// ApplySessionAsync notifies before the calling flow navigates. Navigate once.
	private void GoHome()
	{
		if (_navigated)
			return;
		_navigated = true;
		Nav.NavigateTo("/", forceLoad: false);
	}

	private async Task SignInWithAsync(IExternalSignInProvider provider)
	{
		if (_busy || !provider.IsAvailable) return;
		_busy = true;
		_error = null;
		try
		{
			TokenResponse? session = await provider.StartAsync();
			if (session is not null)
			{
				await Auth.ApplySessionAsync(session);
				GoHome();
			}
			// If StartAsync returned null the user cancelled — no error, no navigation.
		}
		catch (Exception exception)
		{
			_error = new ApiError(default, $"Sign in with {provider.Provider} failed.", new[] { exception.Message });
		}
		finally
		{
			_busy = false;
		}
	}
}

<style>
	/* Signed-out landing sits a little lower than an in-app page. */
	.welcome {
		margin-top: 2rem;
	}

		.welcome .tagline {
			font-size: 1.1rem;
			opacity: 0.85;
			margin-bottom: 1.5rem;
		}

		.welcome .tabs {
			display: flex;
			gap: 0.5rem;
			margin-bottom: 1rem;
			border-bottom: 1px solid #ccc;
		}

		.welcome .tab {
			padding: 0.5rem 1rem;
			background: transparent;
			border: none;
			cursor: pointer;
			border-bottom: 2px solid transparent;
		}

			.welcome .tab.active {
				border-bottom-color: #2563eb;
				font-weight: 600;
			}

		.welcome .forgot {
			margin-top: 0.75rem;
			font-size: 0.9rem;
		}

		.welcome .hint.good {
			color: #196c2e;
		}

		.welcome .hint.bad {
			color: #a91c1c;
		}

		/* The signed-out form states its errors in red text as well as a red box. */
		.welcome .error {
			color: #a91c1c;
		}

		.welcome .external {
			margin-top: 1.5rem;
		}

		.welcome .external-divider {
			display: flex;
			align-items: center;
			margin: 1rem 0;
			color: #94a3b8;
			font-size: 0.85rem;
		}

			.welcome .external-divider::before,
			.welcome .external-divider::after {
				content: "";
				flex: 1;
				border-bottom: 1px solid #e5e7eb;
			}

			.welcome .external-divider span {
				padding: 0 0.75rem;
			}

		.welcome .external-button {
			display: block;
			width: 100%;
			padding: 0.6rem 1rem;
			margin: 0.4rem 0;
			background: white;
			border: 1px solid #cbd5e1;
			border-radius: 4px;
			font-size: 0.95rem;
			cursor: pointer;
		}

			.welcome .external-button:disabled {
				opacity: 0.55;
				cursor: not-allowed;
			}

			.welcome .external-button.apple {
				background: #000;
				color: white;
				border-color: #000;
			}

				.welcome .external-button.apple:disabled {
					background: #1f2937;
				}

			.welcome .external-button.google {
				background: black;
				color: white;
			}

			.welcome .external-button .soon {
				display: inline-block;
				margin-left: 0.5rem;
				font-size: 0.8rem;
				opacity: 0.75;
			}

</style>
