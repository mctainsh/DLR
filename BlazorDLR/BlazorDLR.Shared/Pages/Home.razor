@page "/"
@attribute [Authorize]
@using BlazorDLR.Shared.Services
@inject IFormFactor FormFactor
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject OfflineMapOfferState Offers
@implements IDisposable

<PageTitle>Home - Dumb Luck Routes</PageTitle>

@*
	The signed-in landing (§4.1). Phase 1 is a lightweight stats + call-to-action page -
	real live stats arrive in Phase 2 with the recording pipeline (§4.2, §4.3), which
	needs a real device.
*@

<div class="page">
	<h1><i class="fa fa-fw fa-house" aria-hidden="true"></i> Home</h1>

	@*
		The deferred offer (§4.2), looked for by MainLayout's launch ladder. Here rather than on the
		map because a phone in a dead zone cannot download 300 MB - the screen that discovers the
		problem is the worst place to offer the fix.
	*@
	@if (Offers.Missed is { } missed)
	{
		<OfflineMapOffer Suggestion="missed"
						 Class="home-offline-offer"
						 Headline="Your map went blank last ride"
						 Detail="@($"{missed.Offer.Name} covers where that happened, and needs no signal.")" />
	}

	<div class="grid">
		<a class="card" href="/rides">
			<h2><i class="fa fa-fw fa-route" aria-hidden="true"></i> My routes</h2>
			<p>Recorded and imported tracks.</p>
		</a>
		<a class="card" href="/group-rides">
			<h2><i class="fa fa-fw fa-globe" aria-hidden="true"></i> Group adventures</h2>
			<p>Join a code, create an adventure, run one.</p>
		</a>
		<a class="card" href="/import">
			<h2><i class="fa fa-fw fa-file-import" aria-hidden="true"></i> Import GPX</h2>
			<p>Add a track from a file.</p>
		</a>
		<a class="card" href="/settings">
			<h2><i class="fa fa-fw fa-gear" aria-hidden="true"></i> Settings</h2>
			<p>Profile, devices, account.</p>
		</a>
	</div>

</div>

@code {
	protected override void OnInitialized() => Offers.Changed += OnOffersChanged;

	/// <summary>
	/// The launch ladder found one, or the rider took or dismissed the one on screen. Either way
	/// what this page draws has moved.
	/// </summary>
	private void OnOffersChanged() => _ = InvokeAsync(StateHasChanged);

	public void Dispose() => Offers.Changed -= OnOffersChanged;
}

<style>
	.home-offline-offer { margin-bottom: 1rem; }
</style>
