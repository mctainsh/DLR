@page "/reset-password"
@inject IApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Choose a new password — Dumb Luck Routes</PageTitle>

@*
	Where the emailed reset link lands (§7.7). `{BaseUrl}/reset-password?userId=…&token=…`, as
	AccountEmails writes it — an https:// link with a web page behind it, so recovery works from
	a borrowed browser and not only from the phone that was lost.

	Anonymous, and it has to be: the whole point is that the person reading it cannot sign in.
	The token in the query is the proof, and it is good for one hour.
*@

<div class="page page-form form-page recover">
	<h1>Choose a new password</h1>

	@if (UserId is null || string.IsNullOrWhiteSpace(Token))
	{
		@*
			A link that arrived without its two halves — usually a mail client that wrapped the URL
			over a line break. Nothing to try, so this says what happened and hands back the one
			action that helps.
		*@
		<div class="error" role="alert">
			<strong>That link is not complete.</strong>
			<p>
				Some mail apps break long links across lines. Copy the whole address out of the
				email, or ask for a fresh link.
			</p>
		</div>

		<p><a href="/forgot-password">Send me a new link</a></p>
	}
	else if (_done)
	{
		<div class="callout">
			<strong>Password changed.</strong>
			Every device this account was signed in on has been signed out — including this one.
			That is deliberate: a reset is what somebody does when they think another person has
			their account, and leaving those sessions alive would undo it.
		</div>

		<button type="button" class="primary" @onclick="GoSignIn">Sign in</button>
	}
	else
	{
		<form @onsubmit="ResetAsync" @onsubmit:preventDefault="true">
			<PasswordField Id="reset-password"
						   Label="New password"
						   @bind-Value="_newPassword"
						   Autocomplete="new-password"
						   ShowStrength="true">
				<span class="rule-hint">
					At least 6 characters, and at least one uppercase letter,
					one lowercase letter and one digit.
				</span>
			</PasswordField>

			<button type="submit" class="primary" disabled="@(_busy || string.IsNullOrEmpty(_newPassword))">
				@(_busy ? "Working…" : "Set the new password")
			</button>
		</form>

		@if (_error is not null)
		{
			<div class="error" role="alert">
				<strong>@_error.Title</strong>
				@if (_error.Messages.Count > 0)
				{
					<ul>@foreach (string message in _error.Messages) { <li>@message</li> }</ul>
				}
				@if (_expired)
				{
					<p><a href="/forgot-password">Send me a new link</a></p>
				}
			</div>
		}
	}
</div>

@* AGPL §13 source offer — every page, public and authed (§14.6.2). *@
<BlazorDLR.Shared.Components.SourceOfferFooter />

@code {
	/// <summary>Whose password, from the emailed link.</summary>
	[Parameter]
	[SupplyParameterFromQuery(Name = "userId")]
	public Guid? UserId { get; set; }

	/// <summary>The one-hour token, from the emailed link.</summary>
	[Parameter]
	[SupplyParameterFromQuery(Name = "token")]
	public string? Token { get; set; }

	private string _newPassword = string.Empty;
	private bool _busy;
	private bool _done;
	private ApiError? _error;

	/// <summary>
	/// Whether the failure was the link rather than the password, which decides whether this
	/// screen offers a fresh link or leaves the form up to try again. The server tells the two
	/// apart on purpose — one is "choose a longer one", the other is "ask for a new one" — and
	/// throwing that distinction away here would waste it.
	/// </summary>
	private bool _expired;

	private async Task ResetAsync()
	{
		if (_busy || UserId is not { } userId || string.IsNullOrWhiteSpace(Token)) return;
		_busy = true;
		_error = null;
		_expired = false;
		try
		{
			await Api.ResetPasswordAsync(new ResetPasswordRequest(userId, Token, _newPassword));

			// The server has just revoked every refresh token on the account (§7.7), so whatever
			// this device was holding is dead. Clearing it here is what stops the app carrying a
			// session it cannot refresh into the next screen — and stops a relaunch adopting the
			// remembered account behind it.
			await Auth.SignOutAsync();

			_newPassword = string.Empty;
			_done = true;
		}
		catch (ApiException apiException)
		{
			_error = apiException.Error;
			_expired = IsLinkFailure(apiException.Error);
		}
		catch (Exception exception)
		{
			_error = new ApiError(default, "Could not set that password.", new[] { exception.Message });
		}
		finally
		{
			_busy = false;
		}
	}

	/// <summary>
	/// Whether the server refused the <em>link</em> rather than the password.
	/// <para>
	/// Matched on the title, because that is the only part of the two answers that differs in a
	/// way a client can read: a stale, used or forged token comes back as a plain
	/// <c>ProblemDetails</c> titled "Link not valid" (<c>EmailController</c>'s and
	/// <c>PasswordController</c>'s shared constant), while a rejected password comes back as a
	/// <c>ValidationProblemDetails</c> whose per-rule messages are the whole answer. The reader
	/// flattens both into <see cref="ApiError.Messages"/>, so counting them cannot tell them
	/// apart — a "Link not valid" detail line is one message too.
	/// </para>
	/// </summary>
	private static bool IsLinkFailure(ApiError error) =>
		error.Title.StartsWith(LinkNotValidTitle, StringComparison.OrdinalIgnoreCase);

	/// <summary>Mirrors the title the reset and confirm endpoints refuse a bad token with.</summary>
	private const string LinkNotValidTitle = "Link not valid";

	private void GoSignIn() => Nav.NavigateTo("/welcome", forceLoad: false);
}

<style>
	.recover {
		margin-top: 2rem;
	}

		.recover .error {
			color: #a91c1c;
		}
</style>
