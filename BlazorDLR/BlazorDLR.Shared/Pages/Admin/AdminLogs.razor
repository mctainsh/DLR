@page "/admin/logs"
@attribute [Authorize]
@using System.Globalization
@using DLR.Core.Contracts.Admin
@inject IApiClient Api

@*
	The server's log (§14.6).

	**Not this device's log.** Settings → Log is the one that says what the app did on the phone
	in your hand; this one says what the server did, and the two answer completely different
	questions. Both are named plainly for that reason.

	The day is picked from a list the server supplies rather than typed, and that is a security
	property rather than a convenience: the endpoint takes a *date* and builds the filename
	itself, so there is no way to ask it for a file of your choosing. See ServerLogReader.

	Newest first, because a log is read from the end. The level filter is a floor rather than an
	exact match - "warnings" means warnings, errors and criticals, which is what somebody
	looking for a problem means by it.

	Every filter on this page is the server's, including the database-command tick box. It costs a
	round trip per tick, and it buys the thing this screen is for: the read is capped, and a cap
	spent on statements the reader is not going to be shown is a cap that shows them a few minutes
	of a busy day.
*@

<PageTitle>Server log - Administration - Dumb Luck Routes</PageTitle>

<div class="page page-wide admin-logs">
	<PageNav Title="Server log" BackHref="/admin" BackLabel="Back to administration" />

	<div class="controls">
		<label>
			<span>Day</span>
			<select value="@_day" @onchange="OnDayChangedAsync" aria-label="Which day to read">
				@if (_page is { AvailableDays.Count: 0 })
				{
					<option value="">No files yet</option>
				}
				@foreach (DateOnly day in _page?.AvailableDays ?? [])
				{
					<option value="@day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
						@day.ToString("ddd d MMM yyyy", CultureInfo.InvariantCulture)
					</option>
				}
			</select>
		</label>

		<label>
			<span>From level</span>
			<select value="@_level" @onchange="OnLevelChangedAsync" aria-label="Lowest level to show">
				@foreach ((string value, string label) in Levels)
				{
					<option value="@value">@label</option>
				}
			</select>
		</label>

		@*
			A filter rather than a level, because the level cannot separate these: EF Core logs
			every statement it runs at Information, alongside the lines about riders and rides.
			Off by default - on a server doing anything at all, most of a minute's log is SQL, and
			an administrator opening this screen is looking for the one line that is not.
		*@
		<label class="switch">
			<input type="checkbox" checked="@_showDatabaseCommands" @onchange="OnDatabaseCommandsToggledAsync" />
			<span>Database commands</span>
		</label>

		<button type="button" class="secondary" @onclick="LoadAsync">
			<i class="fa fa-fw fa-rotate" aria-hidden="true"></i> Refresh
		</button>
	</div>

	@if (_error is { } problem)
	{
		<p class="error">@problem</p>
	}
	else if (_page is not { } log)
	{
		<p class="empty">Loading…</p>
	}
	else if (log.Entries.Count == 0)
	{
		@*
			Several very different reasons for an empty list, and an administrator who cannot tell
			them apart will go looking for a fault that is a setting - or, worse, re-check a setting
			that was right all along. So the server says which of them it is: switched off, switched
			on but unable to write, or writing to a directory that is simply still empty.
		*@
		<p class="empty">
			@if (!log.Enabled)
			{
				<text>
					No log files. Writing one is off by default - set <code>FileLog:Enabled</code> to
					true in the server's configuration and restart it.
				</text>
			}
			else if (log.Problem is { Length: > 0 } failure)
			{
				<text>
					File logging is switched on, but the server cannot write it: @failure
				</text>
			}
			else if (log.AvailableDays.Count == 0)
			{
				<text>
					File logging is switched on and nothing has been written yet, to
					<code>@log.Directory</code>. If the server has been running a while, check that
					the account it runs as may write there.
				</text>
			}
			else if (log.DatabaseCommandsHidden > 0)
			{
				@* Not "nothing here": there is something here, and this page is hiding all of it. *@
				<text>
					Nothing at this level on this day but database commands - @log.DatabaseCommandsHidden
					of them. Tick <strong>Database commands</strong> to see them.
				</text>
			}
			else
			{
				<text>Nothing at this level on this day.</text>
			}
		</p>
	}
	else
	{
		<div class="scroller">
			<ol class="entries">
				@foreach (AdminLogEntry entry in log.Entries)
				{
					<li class="@LevelClass(entry.Level)">
						<span class="when">@Stamp(entry)</span>
						<span class="level">@(entry.Level.Length == 0 ? "-" : entry.Level)</span>
						<span class="category" title="@entry.Category">@Short(entry.Category)</span>
						<span class="message">@entry.Message</span>
					</li>
				}
			</ol>
		</div>

		<p class="hint">
			@log.Entries.Count line@(log.Entries.Count == 1 ? null : "s"), newest first.
			@if (log.DatabaseCommandsHidden > 0)
			{
				@*
					Said out loud: the server stepped over these on its way to the lines above, so
					without saying so a day that is mostly SQL would read as a quiet day rather
					than a filtered one.
				*@
				<text>
					@log.DatabaseCommandsHidden database command@(log.DatabaseCommandsHidden == 1 ? null : "s")
					stepped over.
				</text>
			}
			@if (log.Truncated)
			{
				<strong>Older lines exist in this file and were not read.</strong>
			}
		</p>
	}
</div>

@code {
	/// <summary>
	/// The floor options. Values are what the server ranks against; the labels say out loud that
	/// each one includes everything above it, because a naive reading of "Warnings" is that errors
	/// are excluded.
	/// </summary>
	private static readonly (string Value, string Label)[] Levels =
	[
		("", "Everything"),
		("Information", "Information and above"),
		("Warning", "Warnings and above"),
		("Error", "Errors and criticals"),
	];

	/// <summary>The last answer. Everything the list shows is read straight off it.</summary>
	private AdminLogPage? _page;

	/// <summary>Whether EF Core's statement lines are asked for. Off, until somebody wants the SQL.</summary>
	private bool _showDatabaseCommands;

	private string? _error;

	/// <summary>Which day is selected, <c>yyyy-MM-dd</c>, or blank for "whatever is newest".</summary>
	private string _day = string.Empty;

	private string _level = string.Empty;

	protected override Task OnInitializedAsync() => LoadAsync();

	private async Task OnDayChangedAsync(ChangeEventArgs args)
	{
		_day = args.Value?.ToString() ?? string.Empty;

		await LoadAsync();
	}

	private async Task OnLevelChangedAsync(ChangeEventArgs args)
	{
		_level = args.Value?.ToString() ?? string.Empty;

		await LoadAsync();
	}

	/// <summary>
	/// Asks for the day again, with or without the statement lines.
	/// <para>
	/// A round trip, deliberately. The read is capped, and dropping the statements here would mean
	/// the cap had already been spent filling the page with them - on a server doing anything at
	/// all that is most of a file, so unticking the box would leave an administrator looking at
	/// minutes of history where the same cap could have given them the day. The server steps over
	/// them while reading instead, and the wait buys that much more of the log.
	/// </para>
	/// </summary>
	/// <param name="args">The checkbox's new state.</param>
	private Task OnDatabaseCommandsToggledAsync(ChangeEventArgs args)
	{
		_showDatabaseCommands = args.Value is true;

		return LoadAsync();
	}

	private async Task LoadAsync()
	{
		try
		{
			DateOnly? day = DateOnly.TryParseExact(
				_day, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly parsed)
				? parsed
				: null;

			_page = await Api.AdminLogsAsync(day, _level, take: 500, _showDatabaseCommands);
			_error = null;

			// The first load asks for "newest" and the server answers with which day that was, so
			// the picker can show it selected rather than sitting on a blank option.
			if (_day.Length == 0)
			{
				_day = _page.Day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
			}
		}
		catch (ApiException failure)
		{
			_error = failure.Error.Title;
			_page = null;
		}
	}

	/// <summary>The time of day, or a dash for a line that carried no stamp.</summary>
	private static string Stamp(AdminLogEntry entry) =>
		entry.Utc is { } utc
			? utc.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture)
			: "-";

	/// <summary>
	/// The last two segments of a category. Full type names are the widest thing on the row and
	/// the namespace is the same for nearly all of them; the whole name is on the title.
	/// </summary>
	private static string Short(string category)
	{
		if (category.Length == 0)
		{
			return "-";
		}

		string[] parts = category.Split('.');

		return parts.Length <= 2 ? category : string.Join('.', parts[^2..]);
	}

	/// <summary>The modifier the row is coloured by. Blank for a line with no level, which is not
	/// the same as a line at the lowest one.</summary>
	private static string LevelClass(string level) => level.Trim().ToUpperInvariant() switch
	{
		"CRIT" or "CRITICAL" => "critical",
		"ERROR" => "error",
		"WARN" or "WARNING" => "warning",
		"DEBUG" or "TRACE" => "quiet",
		_ => string.Empty,
	};
}

<style>
	.admin-logs .controls {
		display: flex;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0.75rem 0;
	}

		.admin-logs .controls label {
			display: flex;
			flex-direction: column;
			gap: 0.2rem;
			font-size: 0.75rem;
			color: var(--dlr-fg-muted);
		}

		/* 44 px, because this is still the app and the app is used with gloves on - even if this
		   particular screen is mostly read at a desk. */
		.admin-logs .controls select {
			min-height: 44px;
			padding: 0.2rem 0.4rem;
			background: var(--dlr-surface-2);
			color: var(--dlr-fg);
			border: 1px solid var(--dlr-border);
			border-radius: 4px;
			font: inherit;
		}

		/* The .controls label rule above stacks a label over its field, which is right for the two
		   pickers and wrong for a checkbox. Same height as them, so the row still lines up. */
		.admin-logs .controls label.switch {
			flex-direction: row;
			align-items: center;
			min-height: 44px;
		}

	.admin-logs .scroller {
		overflow-x: auto;
		border: 1px solid var(--dlr-border);
		border-radius: 4px;
	}

	.admin-logs .entries {
		list-style: none;
		margin: 0;
		padding: 0;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
	}

		.admin-logs .entries li {
			display: grid;
			grid-template-columns: 5.5rem 3.5rem 12rem 1fr;
			gap: 0.6rem;
			padding: 0.25rem 0.6rem;
			border-left: 3px solid transparent;
		}

		.admin-logs .entries li:nth-child(odd) {
			background: #fff1;
		}

		.admin-logs .when, .admin-logs .level, .admin-logs .category {
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
			color: var(--dlr-fg-quiet);
		}

		/* pre-wrap, because the reader unfolds the newlines the writer folded out of a stack
		   trace - a trace collapsed onto one line is a trace nobody reads. */
		.admin-logs .message {
			white-space: pre-wrap;
			word-break: break-word;
		}

		.admin-logs .entries li.warning { border-left-color: #f59e0b; }
		.admin-logs .entries li.warning .level { color: #f59e0b; }

		.admin-logs .entries li.error { border-left-color: var(--dlr-error); }
		.admin-logs .entries li.error .level { color: var(--dlr-error); }

		/* Critical gets a tinted row as well as an edge. It is the one level where the reader
		   should not have to be scanning the left margin to find it. */
		.admin-logs .entries li.critical {
			border-left-color: var(--dlr-error);
			background: #45181880;
		}

		.admin-logs .entries li.critical .level {
			color: var(--dlr-error);
			font-weight: 700;
		}

		.admin-logs .entries li.quiet .message { color: var(--dlr-fg-muted); }

	.admin-logs .hint {
		margin: 0.6rem 0 0;
		font-size: 0.75rem;
		color: var(--dlr-fg-muted);
	}
</style>
