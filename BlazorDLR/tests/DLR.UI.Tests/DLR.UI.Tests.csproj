<Project Sdk="Microsoft.NET.Sdk">

	<!--
		bUnit against BlazorDLR.Shared: every screen renders once and is tested once,
		with no simulator, no emulator and no browser (§18.7). The tests here are the
		shared UI's answer to "how do we know the components still work" — and, per
		§14.6.3, bUnit is MIT so it passes the licence gate without a decision.
	-->
	<PropertyGroup>
		<RootNamespace>DLR.UI.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="bunit" Version="2.9.0" />
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\BlazorDLR.Shared\BlazorDLR.Shared.csproj" />
		<ProjectReference Include="..\..\DLR.Core\DLR.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="NSubstitute" Version="6.2.0" />
	</ItemGroup>

</Project>
