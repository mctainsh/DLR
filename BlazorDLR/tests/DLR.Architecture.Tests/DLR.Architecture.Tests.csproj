<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Conventions that are only real if a build enforces them (§10.4).
		Assembly-level rules read the compiled output with System.Reflection.Metadata,
		which is in the framework - an architecture guard should not itself introduce a
		dependency that has to be licence-checked.
	-->
	<PropertyGroup>
		<RootNamespace>DLR.Architecture.Tests</RootNamespace>
	</PropertyGroup>

	<!-- Referenced so the assemblies under inspection land in this project's output. -->
	<ItemGroup>
		<ProjectReference Include="..\..\DLR.Core\DLR.Core.csproj" />
		<ProjectReference Include="..\..\BlazorDLR.Web\BlazorDLR.Web.csproj" />
		<ProjectReference Include="..\..\DLR.Server.Migrations\DLR.Server.Migrations.csproj" />
		<!-- The shared UI library - inspected by UiLayeringRules (SharedFrontend.md §7 Phase 0). -->
		<ProjectReference Include="..\..\BlazorDLR.Shared\BlazorDLR.Shared.csproj" />
		<!--
			The UI test project itself is inspected by UiLayeringRules.UiTests_ReferenceNoMobileOnlyAssembly
			(SharedFrontend.md §7 Phase 4). Referenced so its compiled DLL lands beside the arch test
			assembly and CompiledAssembly.Load can read it. The reference is metadata-only in intent -
			the arch tests never call anything from the UI tests at runtime.
		-->
		<ProjectReference Include="..\DLR.UI.Tests\DLR.UI.Tests.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Update="NSubstitute" Version="6.2.0" />
	</ItemGroup>

</Project>
