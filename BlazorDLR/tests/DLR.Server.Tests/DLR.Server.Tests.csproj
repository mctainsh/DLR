<Project Sdk="Microsoft.NET.Sdk">

	<!-- WebApplicationFactory over a Testcontainers PostgreSQL instance (§10.4). -->
	<PropertyGroup>
		<RootNamespace>DLR.Server.Tests</RootNamespace>
	</PropertyGroup>

	<!--
		Test classes run in parallel (§10.4). Each still gets its own throwaway database, so the cap
		is about how hard one PostgreSQL container is asked to work, not correctness: eight servers
		at MaxPoolSize 5 is forty connections against the container's three hundred.

		Eight rather than a core count. Measured on a 32-core machine the suite takes 1m50s at
		eight threads, 1m44s at twelve and 1m49s at twenty-four - the container is the limit well
		before the CPU is, so the extra threads buy noise and spend it on contention that the
		timing-sensitive tests in §7.8 have to survive.
	-->
	<ItemGroup>
		<Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<!-- Drives the §5.3 hub against TestServer, including its WebSocket handshake. -->
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\BlazorDLR.Web\BlazorDLR.Web.csproj" />
		<ProjectReference Include="..\DLR.TestSupport\DLR.TestSupport.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="NSubstitute" Version="6.2.0" />
	</ItemGroup>

</Project>
